{
  "version":"coarse-label-families-v1",
  "note":"Maps source metadata label strings to broad parents, never EdNet numeric tag IDs. Reviewable taxonomy, not learned equivalence.",
  "exclude":["listening","reading","grammar","structure","context_rc","context_lc","portrait","sight","portrait_general","sight_general","wh_questions","voca","vocabulary"],
  "rules":[
    {"id":"p1_action","axis":"topic","name":"Hoạt động và thao tác con người","parts":["p1"],"pattern":"^portrait_(activity|hand|art)$"},
    {"id":"p1_observe_pose","axis":"topic","name":"Tư thế và quan sát","parts":["p1"],"pattern":"^portrait_(body|look)$"},
    {"id":"p1_work_care","axis":"topic","name":"Lao động, chăm sóc và thiết bị","parts":["p1"],"pattern":"^portrait_(garden|work|tool|arrange)$"},
    {"id":"p1_transport","axis":"topic","name":"Phương tiện và di chuyển","parts":["p1"],"pattern":"^(sight_transporta?ion|sight_transportation|portrait_person_transportation)$"},
    {"id":"p1_objects","axis":"topic","name":"Đồ vật, trạng thái và bố trí","parts":["p1"],"pattern":"^sight_(location|place|appearance|road)$"},
    {"id":"p1_workplace","axis":"topic","name":"Học tập và công việc","parts":["p1"],"pattern":"^portrait_company_school$"},
    {"id":"p1_shopping","axis":"topic","name":"Mua sắm","parts":["p1"],"pattern":"^portrait_shopping$"},
    {"id":"p1_landscape","axis":"topic","name":"Phong cảnh","parts":["p1"],"pattern":"^sight_landscape$"},
    {"id":"p2_how","axis":"task","name":"Hỏi How","parts":["p2"],"pattern":"^(wh_questions_how|stem_how)$"},
    {"id":"p2_who","axis":"task","name":"Hỏi Who","parts":["p2"],"pattern":"^(wh_questions_who|stem_who)$"},
    {"id":"p2_where","axis":"task","name":"Hỏi Where","parts":["p2"],"pattern":"^(wh_questions_where|stem_where)$"},
    {"id":"p2_when","axis":"task","name":"Hỏi When","parts":["p2"],"pattern":"^(wh_questions_when|stem_when)$"},
    {"id":"p2_why","axis":"task","name":"Hỏi Why","parts":["p2"],"pattern":"^(wh_questions_why|stem_why)$"},
    {"id":"p2_what","axis":"task","name":"Hỏi What","parts":["p2"],"pattern":"^(wh_questions_what|stem_what)$"},
    {"id":"p2_which","axis":"task","name":"Hỏi Which","parts":["p2"],"pattern":"^(wh_questions_which|stem_which)$"},
    {"id":"p2_yesno","axis":"task","name":"Yes/No và trợ động từ","parts":["p2"],"pattern":"^(yn_question|stem_auxiliary)$"},
    {"id":"p2_statement","axis":"task","name":"Phản hồi câu trần thuật","parts":["p2"],"pattern":"^declarative_sentence$"},
    {"id":"p2_negative","axis":"task","name":"Phản hồi câu hỏi phủ định","parts":["p2"],"pattern":"^question_negative$"},
    {"id":"p2_tag","axis":"task","name":"Phản hồi câu hỏi đuôi","parts":["p2"],"pattern":"^question_tag$"},
    {"id":"p2_choice","axis":"task","name":"Phản hồi câu lựa chọn","parts":["p2"],"pattern":"^alternative_question$"},
    {"id":"comparison","axis":"grammar","name":"So sánh","parts":["p5","p6"],"pattern":"comparative|superlative|comparison|as_as"},
    {"id":"tenses","axis":"grammar","name":"Thì và thời gian","parts":["p5","p6"],"pattern":"^tenses?$|^(?!.*participle)(present|past|future|perfect)(_|$)"},
    {"id":"relative","axis":"grammar","name":"Mệnh đề và từ quan hệ","parts":["p5","p6"],"pattern":"relative"},
    {"id":"infinitive","axis":"grammar","name":"Động từ nguyên mẫu có to","parts":["p5","p6"],"pattern":"to_infinitive"},
    {"id":"gerund","axis":"grammar","name":"Danh động từ","parts":["p5","p6"],"pattern":"gerund"},
    {"id":"participle","axis":"grammar","name":"Phân từ","parts":["p5","p6"],"pattern":"participle"},
    {"id":"connectives","axis":"grammar","name":"Liên từ và phương tiện liên kết","parts":["p5","p6"],"pattern":"conjunction|conjunctive"},
    {"id":"pronouns","axis":"grammar","name":"Đại từ và từ hạn định","parts":["p5","p6"],"pattern":"pronoun|determiner|quantifier"},
    {"id":"voice","axis":"grammar","name":"Chủ động và bị động","parts":["p5","p6"],"pattern":"passive|active_voice|^voice$"},
    {"id":"inversion","axis":"grammar","name":"Đảo ngữ","parts":["p5","p6"],"pattern":"inversion"},
    {"id":"subjunctive","axis":"grammar","name":"Giả định","parts":["p5","p6"],"pattern":"subjunctive"},
    {"id":"preposition","axis":"grammar","name":"Giới từ","parts":["p5","p6"],"pattern":"preposition"},
    {"id":"word_position","axis":"grammar","name":"Vị trí và cấu trúc từ loại","parts":["p5","p6"],"pattern":"^structure_(noun|verb|adjective|adverb)$|^pos$"},
    {"id":"vocab_noun","axis":"grammar","name":"Từ vựng danh từ","parts":["p5","p6"],"pattern":"^voca_(noun|compound_noun)$"},
    {"id":"vocab_verb","axis":"grammar","name":"Từ vựng động từ","parts":["p5","p6"],"pattern":"^voca_verb$"},
    {"id":"vocab_adjective","axis":"grammar","name":"Từ vựng tính từ","parts":["p5","p6"],"pattern":"^voca_adjective$"},
    {"id":"vocab_adverb","axis":"grammar","name":"Từ vựng trạng từ","parts":["p5","p6"],"pattern":"^voca_adverb$"},
    {"id":"detail","axis":"task","name":"Thông tin chi tiết","parts":["p3","p4","p6","p7"],"pattern":"^detail$|^negative_detail$|^true_not_true$"},
    {"id":"inference","axis":"task","name":"Suy luận","parts":["p3","p4","p6","p7"],"pattern":"^imply$|^inference$"},
    {"id":"purpose","axis":"task","name":"Chủ đề và mục đích","parts":["p3","p4","p6","p7"],"pattern":"^intention$|^main_topic$"},
    {"id":"speaker_intent","axis":"task","name":"Ý định người nói","parts":["p3","p4","p7"],"pattern":"^speaker_intent$"},
    {"id":"next_action","axis":"task","name":"Hành động tiếp theo và yêu cầu","parts":["p3","p4","p6","p7"],"pattern":"^next_action$|^request$"},
    {"id":"word_meaning","axis":"task","name":"Nghĩa từ trong ngữ cảnh","parts":["p3","p4","p6","p7"],"pattern":"^word_meaning$"},
    {"id":"sentence_insertion","axis":"task","name":"Chèn câu","parts":["p6","p7"],"pattern":"^sentence_insertion$"},
    {"id":"multi_text","axis":"format","name":"Nhiều văn bản","parts":["p6","p7"],"pattern":"^(dual|triple)_passage$"},
    {"id":"single_text","axis":"format","name":"Một văn bản","parts":["p6","p7"],"pattern":"^single_passage$"},
    {"id":"mail","axis":"format","name":"Thư và email","parts":["p6","p7"],"pattern":"^passage_mail$"},
    {"id":"advertisement","axis":"format","name":"Quảng cáo","parts":["p6","p7"],"pattern":"^(passage_)?advertisement$"},
    {"id":"flight_notice","axis":"topic","name":"Thông báo chuyến bay","parts":["p3","p4"],"pattern":"^notice_(flight|boarding_call)$"},
    {"id":"broadcast","axis":"topic","name":"Bản tin","parts":["p3","p4"],"pattern":"^broadcast_"},
    {"id":"telephone","axis":"topic","name":"Điện thoại và lời nhắn","parts":["p3","p4"],"pattern":"^telephone(_message)?$"}
  ]
}
