                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn đại từ nhân xưng phù hợp.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Sau chỗ trống có động từ are và tiếp theo là một cụm danh từ làm tân ngữ của động từ claims ở mệnh đề chính, nên cần điền ở đây chủ ngữ của mệnh đề danh ngữ.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Vì vậy, đáp án đúng là đại từ sở hữu (B) theirs, có thể làm chủ ngữ và có nghĩa là \\\"(quần áo) của họ\\\", lấy từ their clothes ở mệnh đề đằng trước.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là tính từ sở hữu, (B) là đại từ phản thân, (D) là đại từ tân ngữ, tất cả đều không thể làm chủ ngữ nên các đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
