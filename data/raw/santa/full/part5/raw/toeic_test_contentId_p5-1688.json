                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn từ loại phù hợp với chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Chỗ trống là vị trí bổ ngữ của động từ 'seem', đáp án đúng là tính từ (A), kết hợp với giới từ 'on' đứng sau nhận bổ nghĩa của trạng từ 'quite' có nghĩa là “khá chắc chắn về…”.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) là tính từ so sánh hơn, vì không có đối tượng so sánh trong câu này nên không thể sử dụng so sánh hơn.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) là trạng từ, không thể ở vị trí bổ ngữ của 'seem'.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là danh từ, có thể ở vị trí bổ ngữ, nhưng không thể được bổ nghĩa bởi từ 'quite' và cũng không hợp ngữ cảnh.\"}]]}]]}]}",
