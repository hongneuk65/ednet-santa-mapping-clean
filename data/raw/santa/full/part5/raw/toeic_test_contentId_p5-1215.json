                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Từ chỗ trống đến borrowed là tân ngữ của động từ returned.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Vì vậy, trong chỗ trống phải là một từ có thể bổ nghĩa cho ones ở đằng sau đồng thời đứng đầu mệnh đề danh ngữ làm tân ngữ.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Đáp án đúng là tính từ quan hệ ghép (C) whichever, tạo thành ý nghĩa \\\"\",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"vui lòng nhanh chóng trả lại các mẫu bạn đã mượn\\\".\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) sai vì không thể bổ nghĩa cho ones.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) là đại từ quan hệ ghép có nghĩa là \\\"bất kỳ ai\\\" hoặc \\\"dù là ai\\\", không phù hợp với ngữ cảnh cũng như không thể bổ ngữ cho ones, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là đại từ quan hệ, mà ở đằng trước chỗ trống lại không có tiền ngữ, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
