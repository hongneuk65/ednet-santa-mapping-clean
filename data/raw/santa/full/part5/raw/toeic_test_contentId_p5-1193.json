                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn đại từ nhân xưng phù hợp vào chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Vì câu có cấu trúc là [liên từ trạng ngữ (when) + chủ ngữ (a transaction) + mệnh đề quan hệ (chỗ trống~suspicious) + động từ (is made)] nên có thể thấy chỗ trống sẽ là chủ ngữ của mệnh đề quan hệ bổ nghĩa cho a transaction đứng trước nó.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Vì vậy, đáp án đúng là (C) it, làm chủ ngữ của động từ finds.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"4. Đại từ quan hệ that giữa a transaction và chỗ trống được lược bỏ.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là đại từ phản thân, (B) là đại từ sở hữu, và cả hai đều sai vì không thể làm chủ ngữ.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là đại từ sở hữu kết hợp với tính từ tạo thành ý nghĩa là \\\"của chính nó\\\", cần phải theo sau bởi một danh từ, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
