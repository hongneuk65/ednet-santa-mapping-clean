                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Chỗ trống là chủ ngữ của động từ needs, số của động từ là số ít, nên các đáp án có thể đúng là đại từ số ít (C) và (D).\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Đáp án đúng là everything (C), vì ngữ cảnh phù hợp nhất là “Margo’s Modern Fashion sẽ đóng cửa nên tất cả mọi thứ phải được bán hoặc quyên tặng”.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là đại từ chỉ định số nhiều.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) trường hợp là từ hạn định thì có danh từ theo sau, và trường hợp là đại từ quan hệ ghép thì đứng đầu mệnh đề danh từ.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là đại từ bất định có nghĩa là“một trong hai,” không phù hợp ngữ cảnh.\"}]]}]]}]}",
