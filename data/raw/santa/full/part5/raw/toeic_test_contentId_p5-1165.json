                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn trợ động từ phù hợp với ngữ cảnh.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Trước chỗ trống có tính từ sở hữu Our và cụm động từ đằng sau nên chỗ trống sẽ là một danh từ đóng vai trò chủ ngữ của câu và được giới hạn bởi tính từ sở hữu Our.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Vì vậy, đáp án đúng là danh từ (D).\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là danh động từ kiêm hiện tại phân từ, mà danh động từ thì không phù hợp với ngữ cảnh, còn hiện tại phân từ không thể đặt ở vị trí chủ ngữ, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) là thì quá khứ hoặc quá khứ phân từ của động từ, (C) là tính từ, và cả 2 đáp án đều sai.\",\"weight\":\"#w400\"}]]}]]}]}",
