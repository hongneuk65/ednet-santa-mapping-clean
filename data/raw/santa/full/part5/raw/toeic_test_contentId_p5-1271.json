              "oneOfExplanationType": {
                "oneOfCase": "EXPLANATION",
                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn từ loại phù hợp vào chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Trước chỗ trống có một mệnh đề hoàn chỉnh bao gồm [Chủ ngữ + Động từ + Tân ngữ] nên cần điền ở đây một (cụm) bổ ngữ.\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Ở phía trước chỗ trống là từ most bổ nghĩa cho chỗ trống để tạo thành một biểu thức so sánh nhất, và đằng sau là một cụm giới từ đứng đầu là for. Vì vậy, đáp án đúng là tính từ (B), kết hợp với for tạo thành ý nghĩa \\\"đủ tiêu chuẩn nhất\\\".\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"4. Từ chỗ trống đến job là một cụm phân từ bổ nghĩa cho \"}],[\"text\",{\"value\":\"the candidtates đằng trước.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là hiện tại phân từ có ý chủ động, mang nghĩa là 'làm đủ tiêu chuẩn', không phù hợp với ngữ cảnh nên đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) là động từ, (D) là danh từ, không thể dùng như tính từ nên đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
