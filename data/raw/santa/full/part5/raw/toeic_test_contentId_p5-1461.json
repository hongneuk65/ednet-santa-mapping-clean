              "oneOfExplanationType": {
                "oneOfCase": "EXPLANATION",
                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Từ chỗ trống cho đến từ Club là chủ ngữ của động từ indicates trong câu, và từ a personal cho đến từ Club sau chỗ trống là một mệnh đề hoàn chỉnh khác bao gồm [chủ ngữ + động từ], nên phải điền vào chỗ trống một từ có thể liên kết mệnh đề với mệnh đề.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Mệnh đề danh từ có vai trò chủ ngữ của câu, cần phải điền một từ vào chỗ trống để có thể đổi thành mệnh đề danh từ.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Đáp án (C) có nghĩa tự nhiên nhất theo mạch văn, cho ý nghĩa là “nơi neo đậu của tàu cá nhân [vị trí đậu tàu cá nhân]”, nên (C) là đáp án đúng.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là một mệnh đề danh từ hoặc liên từ mệnh đề trạng ngữ có nghĩa là \\\"khi nào làm~\\\", không phù hợp với ngữ cảnh nên đây là đáp án sai.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) là một liên từ mệnh đề trạng ngữ, không thể đổi thành mệnh đề danh từ nên đây là đáp án sai.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là một liên từ đẳng lập có nghĩa là \\\"vì vậy\\\", không thể đổi thành mệnh đề danh từ nên đây là đáp án sai.\"}]]}]]}]}",
