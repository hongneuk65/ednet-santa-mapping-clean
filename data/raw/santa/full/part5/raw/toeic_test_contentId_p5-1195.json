                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn danh từ phù hợp với ngữ cảnh.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Vì trước chỗ trống có danh từ dance được giới hạn bởi The Metropolitan Theater’s, và đằng sau có động từ will conclude, chỗ trống sẽ là một danh từ cùng với dance đằng trước tạo thành danh từ ghép, làm chủ ngữ cho câu.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Vì vậy, đáp án đúng là danh từ (B).\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là thì quá khứ hoặc quá khứ phân từ của động từ, không thể sử dụng như danh từ, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) là danh động từ hoặc hiện tại phân từ, nhưng nếu là danh động từ thì không thể ghép lại với dance tạo thành \\\"\",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"buổi biểu diễn khiêu vũ\\\", mà hiện tại phân từ lại không thể thay cho danh từ, vì vậy đáp án sai.\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là thì hiện tại của động từ, không thể dùng làm danh từ, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
