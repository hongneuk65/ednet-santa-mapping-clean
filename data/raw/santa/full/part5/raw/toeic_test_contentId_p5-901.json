                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn động từ phù hợp vào chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Câu ở đằng trước chỗ trống có nói rằng 'tác phẩm đang nhận được đánh giá tích cực' nên cần điền ở đây một điều có thể nối với nội dung đằng trước và thể hiện 'điều có thể làm với những nhà phê bình'.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Vì vậy, đáp án đúng là động từ (B), có nghĩa là 'làm im lặng' và sẽ tạo thành ý nghĩa '\",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"chắc chắn sẽ khiến những người chỉ trích phải im lặng'.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) broaden có nghĩa là 'mở rộng', không phải một điều có thể làm với chủ thể người như nhà phê bình.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) approve có nghĩa là 'chấp thuận', không phải một điều có thể làm với người.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) converse là nội động từ có nghĩa là 'chuyện trò', vì vậy nó không thể lấy critics làm tân ngữ và không phù hợp với ý nghĩa của câu.\",\"weight\":\"#w400\"}]]}]]}]}",
