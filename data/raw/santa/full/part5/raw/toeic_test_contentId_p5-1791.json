                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn từ loại phù hợp với chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Nếu xem xét cấu trúc của toàn bộ câu ở dạng [chủ ngữ + động từ + tân ngữ (mệnh đề danh từ được dẫn bởi that) + cụm bổ ngữ (in order to ~)], và cấu trúc của mệnh đề danh từ được dẫn bởi that là mệnh đề hoàn chỉnh, có cả mệnh đề chính và mệnh đề danh từ ở dạng [chủ ngữ (promotions) + động từ (be made)]. Do đó, chỗ trống là vị trí trạng ngữ bổ nghĩa cho be made ở sau.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Vậy đáp án đúng là trạng từ (B).\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) tính từ\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) động từ (nguyên mẫu)\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) danh từ\"}]]}]]}]}",
