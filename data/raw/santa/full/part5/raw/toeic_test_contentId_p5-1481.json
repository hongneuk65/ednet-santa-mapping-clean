                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Chỗ trống là vị trí của giới từ, vì có cụm danh từ the holidays sau chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Đáp án (B) duringlà đáp án đúng, đây là giới từ có nghĩa là“(trong suốt) ngày nghỉ ~” phù hợp với the holidays thể hiện thời gian sau chỗ trống.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là giới từ hay liên từ, giới từ có nghĩa là “như” và “giống như” không phù hợp với ngữ cảnh, còn liên từ không thể nằm ở vị trí giới từ, nên đây là đáp án sai.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) là một giới từ hoặc trạng từ, giới từ có nghĩa là “~ ra ngoài” không phù hợp với ngữ cảnh, còn trạng từ không thể nằm ở vị trí giới từ, nên đây là đáp án sai.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là một trạng từ hoặc liên từ, không thể nằm ở vị trí giới từ, nên đây là đáp án sai.\"}]]}]]}]}",
