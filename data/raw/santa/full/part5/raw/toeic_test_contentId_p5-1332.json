              "oneOfExplanationType": {
                "oneOfCase": "EXPLANATION",
                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Vì trước và sau chỗ trống đều có mệnh đề nên chỗ trống sẽ chứa một liên từ nối các mệnh đề với nhau.\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Vì mệnh đề đằng sau tương ứng với kết quả của mệnh đề trước nên đáp án đúng là liên từ kết hợp (A) so, được sử dụng sau dấu phẩy và có nghĩa là \\\"vì vậy\\\".\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) giới từ + đại từ quan hệ và có thể nối các vế câu, nhưng nó không thể được dùng sau dấu phẩy nên đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) là liên từ của mệnh đề trạng ngữ có nghĩa là \\\"như thể~\\\", không phù hợp với ngữ cảnh nên đáp án sai. \",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là trạng từ quan hệ kiêm từ để hỏi. Nếu là từ để hỏi thì nó không thể được dùng như liên từ, và nếu là trạng từ quan hệ thì ở đây không có tiền ngữ đứng trước, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
