                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn từ loại phù hợp với ngữ cảnh.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Ở cấu trúc 'chỗ trống + động từ (is) + chủ ngữ (\",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"a list of mobile numbers)’, chủ ngữ và động từ được đảo lại với nhau, còn ‘a list of~’ là tân ngữ cần được đính kèm. \"}],[\"text\",{\"value\":\"Đáp án đúng là quá khứ phân từ (B) vì nó phải là quá khứ phân từ có nghĩa bị động và bổ nghĩa cho động từ 'be'.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) attachment có thể bổ nghĩa như một danh từ, nhưng vì nó là danh từ đếm được và có nghĩa là 'vật được đính kèm' nên phải đi cùng với mạo từ.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) attaching có thể là danh động từ hoặc hiện tại phân từ, nhưng nó không thể diễn đạt ý nghĩa bị động để bổ nghĩa cho a list of mobile numbers, vì vậy đáp án này sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) attach là dạng động từ, vì vậy không thể đứng cạnh động từ khác như is.\",\"weight\":\"#w400\"}]]}]]}]}",
