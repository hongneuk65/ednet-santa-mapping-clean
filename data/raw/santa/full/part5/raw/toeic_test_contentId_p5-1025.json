              "oneOfExplanationType": {
                "oneOfCase": "EXPLANATION",
                "branchingExplanations": null,
                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn phó từ phù hợp với ngữ cảnh.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Cần điền vào chỗ trống một trạng từ bổ nghĩa cho động từ send ở phía sau và kết hợp với động từ send ở 'thì hiện tại'.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Vì vậy, câu (B), có nghĩa là 'thường xuyên', là đáp án đúng vì được sử dụng cùng thì hiện tại và biểu hiện 'sự lặp lại'.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) once có nghĩa là ‘một lần, tại một thời điểm (trong quá khứ)’, vì vậy nó không thể bổ nghĩa cho động từ ở thì hiện tại biểu thị sự lặp đi lặp lại hoặc không thay đổi.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) recently có nghĩa là ‘gần đây’, thường được sử dụng với động từ thì quá khứ vì nó biểu thị một điều đã xảy ra trong quá khứ.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) hugely là trạng từ chỉ mức độ hoặc kích thước, vì vậy nó không thể bổ nghĩa cho động từ thì hiện tại để biểu thị sự lặp lại.\",\"weight\":\"#w400\"}]]}]]}]}",
