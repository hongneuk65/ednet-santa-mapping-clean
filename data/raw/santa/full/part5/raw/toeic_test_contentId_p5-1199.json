              "oneOfExplanationType": {
                "oneOfCase": "EXPLANATION",
                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn từ loại phù hợp vào chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Vì trước chỗ trống có mạo từ a và tính từ leading, còn đằng sau là một cụm giới từ đứng đầu là giới từ of nên cần điền vào chỗ trống một danh từ được bổ ngữ bởi cụm giới từ và leading trước chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Vì vậy, trong số các đáp án (B) và (C), đáp án đúng là (B) có nghĩa là \\\"nhà cung cấp.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là danh động từ hoặc hiện tại phân từ. Nếu là danh động từ thì nó có thể được đặt vào vị trí của danh từ, nhưng đằng sau phải không có tân ngữ, còn nếu là hiện tại phân từ thì nó không thể dùng như danh từ, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) là động từ hoặc danh từ. Nếu là động từ thì không thể dùng như danh từ, còn nếu là danh từ thì nghĩa của nó là \\\"đồ cung cấp\\\", không phù hợp với ngữ cảnh, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là thì quá khứ hoặc quá khứ phân từ của động từ, không thể dùng như danh từ, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
