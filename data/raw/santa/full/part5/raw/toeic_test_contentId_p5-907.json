              "oneOfExplanationType": {
                "oneOfCase": "EXPLANATION",
                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn động từ phù hợp vào chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Phần sau chỗ trống có cấu trúc 'tiền quyên góp + from + người', và trong ngữ cảnh thì cách nói \\\"\",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"tuyển dụng các tình nguyện viên để 'kêu gọi' quyên góp tài chính\\\" là tự nhiên nhất.\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3.Vì vậy, đáp án đúng là (C), có thể kết hợp với cấu trúc này và tạo ý nghĩa 'kêu gọi, cầu xin từ~'.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) expect có nghĩa là 'mong đợi, đoán trước~', và có thể sử dụng với cấu trúc 'vật from người', nhưng nó không phù hợp với một việc mà tình nguyện viên sẽ làm.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) return được sử dụng với tân ngữ và có nghĩa là 'trao lại, hoàn trả~', vì vậy không phù hợp với nghĩa của câu.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) propose có nghĩa là 'đề nghị~', và được sử dụng với cấu trúc 'A for B'.\",\"weight\":\"#w400\"}]]}]]}]}",
