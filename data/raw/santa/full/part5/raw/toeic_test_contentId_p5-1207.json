                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn trạng từ phù hợp với văn cảnh.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Trước chỗ trống là một mệnh đề hoàn chỉnh bao gồm [chủ ngữ + động từ + tân ngữ] và đằng sau là một mệnh đề khác bắt đầu bằng before, chỗ trống là vị trí của một trạng từ.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Vì vậy, đáp án đúng là trạng từ (A) perfectly bổ nghĩa cho động từ memorized.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) là thì quá khứ kiêm quá khứ phân từ của động từ , (C) là tính từ, (D) là danh động từ kiêm hiện tại phân từ, đều không thể đặt vào vị trí của trạng từ, vì vậy các đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
