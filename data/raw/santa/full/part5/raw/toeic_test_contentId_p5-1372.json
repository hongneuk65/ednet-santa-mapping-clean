                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Vì trước và sau chỗ trống đều có mệnh đề gồm [Chủ ngữ + Động từ] nên chỗ trống sẽ chứa một từ nối các mệnh đề với nhau.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Về mặt nghĩa thì cách nói \\\"có thể tham gia bất cứ cái nào họ muốn\\\" là tự nhiên nhất, vì vậy đáp án đúng là trạng từ quan hệ ghép (D) whichever, đứng đầu một mệnh đề trạng ngữ mang ý nhượng bộ.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là trạng từ, không thể nối các mệnh đề với nhau nên đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) và (C) là đại từ quan hệ, mà đằng trước không có từ nào có thể làm tiền ngữ, hơn nữa những từ này cũng không phù hợp với ngữ cảnh, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
