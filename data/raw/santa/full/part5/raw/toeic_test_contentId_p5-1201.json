                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn tính từ phù hợp với văn cảnh.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Vì chỗ trống đứng giữa all và danh từ \",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"properties nên chỗ trống sẽ là vị trí của một tính từ bổ nghĩa cho properties.\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Giữa (B) và (C), đáp án đúng là (C) residential, kết hợp với properties taọ thành ý nghĩa \\\"căn hộ dân cư\\\".\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là danh từ, không thể đặt vào vị trí của tính từ, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) là danh động từ kiêm hiện tại phân từ, mà nếu là danh động từ thì không thể đặt vào vị trí của tính từ, còn nếu là hiện tại phân từ thì sẽ trở thành ý nghĩa “cư trú (ở một nơi cụ thể)\\\" không phù hợp với ngữ cảnh, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là trạng từ, không thể đặt vào vị trí của tính từ, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
