                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Sau chỗ trống có cụm danh từ her fans’ continued support, và trước đó là mệnh đề hoàn chỉnh gồm [Chủ ngữ + Động từ], vì vậy chỗ trống sẽ chứa một giới từ.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Đáp án đúng là giới từ (C) for, đi kèm với grateful ở phía trước và có nghĩa là \\\"biết ơn\\\"\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là một giới từ có nghĩa là \\\"tới~\\\", và nếu dùng sau grateful thì nó sẽ có nghĩa là \\\"biết ơn tới~ (người), không phù hợp với ngữ cảnh nên đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) và (D) là liên từ, không thể dùng như giới từ nên đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
