                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. \",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"Đây là câu hỏi chọn động từ thích hợp với chỗ trống.\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Trong chỗ trống cần một nội động từ có thể được sử dụng cùng với giới từ to và diễn đạt 'một hành động mà khách đến thăm cần làm đối với phòng an ninh', vì vậy câu trả lời đúng là (A), có nghĩa là 'đến và thông báo'.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) gather có nghĩa là 'tập hợp, tụ họp' và có thể được sử dụng như nội động từ hoặc ngoại động từ, nhưng nó không phải là một hoạt động bình thường mà khách đến thăm có thể làm.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) submit là ngoại động từ có nghĩa là 'nộp~'.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) adhere có thể được sử dụng với giới từ to, nhưng nó có nghĩa là 'tuân thủ' nên không phù hợp.\",\"weight\":\"#w400\"}]]}]]}]}",
