                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn hình thái của động từ phù hợp với chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Chủ ngữ của câu là Requests for changes in visa status, và trước chỗ trống có cụm động từ will be và sau chỗ trống có cụm giới từ.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Vì không có tân ngữ sau chỗ trống, nên từ cần điền vào chỗ trống là phân từ quá khứ processed (B) để tạo thành cụm động từ bị động ở dạng be + p.p.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là danh từ, có thể ở vị trí của bổ ngữ chủ từ sau động từ be, nhưng nó không phù hợp về mặt ngữ nghĩa.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) Trong câu đã có sẵn động từ will be nên không thể đặt động từ ở chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) be+-ing ở thì hiện tại tiến diễn, process là ngoại động từ nên cần có tân ngữ theo sau.\"}]]}]]}]}",
