                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. (C) là đáp án đúng vì nó tạo thành cặp liên từ tương quan mang nghĩa là 'cả A và B', phù hợp với cấu trúc ‘A and B’ đằng sau chỗ trống.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) as well là cụm phó từ mang nghĩa 'cũng, hơn nữa'.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) only là phó từ mang nghĩa 'chỉ, duy nhất''\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) along with là giới từ mang nghĩa 'cùng, với lại'.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Liên từ tương quan được sử dụng cùng với liên từ đẳng lập để kết nối hai hoặc nhiều từ, cụm từ hay mệnh đề tương đương về mặt ngữ pháp. Liên từ tương quan sẽ xuất hiện trong các câu hỏi về dạng cơ bản và về đại từ chỉ lượng nên cần nhớ mẫu này. Một số liên từ tương quan tiêu biểu là Both A and B, Either A or B, Neither A nor B, Not A but B, Not only A but (also) B.(= B as well as A, B together with A, B in addition to A, B along with A).\"}]]}]]}]}",
