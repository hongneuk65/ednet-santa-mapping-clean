                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Vì chỗ trống có đại từ everyone đứng đằng trước và động từ attends đằng sau, cần điền ở đây một đại từ quan hệ nối everyone và attends để tạo ra ý nghĩa \\\"tất cả những ai tham dự đêm khai mạc của nhà hát\\\".\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Vì vậy, đáp án đúng là đại từ quan hệ chủ ngữ (C), lấy tiền ngữ là người.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là đại từ quan hệ không có tiền ngữ, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) là trạng từ, không thể đứng đầu mệnh đề danh ngữ làm tân ngữ của attends nên đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là giới từ, mà đằng sau chỉ có động từ chứ không có mệnh đề bao gồm [chủ ngữ + động từ] nên đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
