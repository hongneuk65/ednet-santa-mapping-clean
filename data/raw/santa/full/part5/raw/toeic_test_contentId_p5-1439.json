                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn động từ phù hợp vào chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Đại từ quan hệ chủ ngữ that trước chỗ trống có tiền ngữ là health center, chủ ngữ health center có động từ nằm trong chỗ trống, và tân ngữ là its members. Vì vậy, đáp án đúng là (B) provides, tạo thành câu trúc provide A with B và có nghĩa là \\\"cung cấp cho hội viên những điều sau with\\\".\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) gives có nghĩa là \\\"cho\\\" và có thể lấy its members làm tân ngữ, nhưng nó phải được viết dưới dạng [give + tân ngữ gián tiếp + tân ngữ trực tiếp], vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) attends là “tham dự”, (D) grants là “công nhận”, cả hai đều sai vì không phù hợp với ngữ cảnh.\",\"weight\":\"#w400\"}]]}]]}]}",
