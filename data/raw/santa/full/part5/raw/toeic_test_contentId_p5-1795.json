                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn từ loại phù hợp với chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Sau chỗ trống có danh từ buses, từ hạn định (B) và tính từ (C) là những đáp án phù hợp.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Đáp án đúng là More (B), bổ nghĩa cho buses có nghĩa là \\\"nhiều xe buýt\\\".\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là trạng từ, và thường bổ nghĩa trước trạng từ hay tính từ, các từ như all, every(thing).\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) plus chủ yếu được sử dụng với số, hoặc bổ nghĩa trước danh từ có nghĩa là “tốt, cộng thêm”, nên không phù hợp với ngữ cảnh.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là liên từ mệnh đề trạng ngữ đóng vai trò kết hợp mệnh đề và mệnh đề, nhưng câu này chỉ có một mệnh đề nên không cần liên từ mệnh đề trạng ngữ.\"}]]}]]}]}",
