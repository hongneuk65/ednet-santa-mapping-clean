                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn từ loại phù hợp với ngữ cảnh.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Cần điền ở đây một tính từ bổ nghĩa cho danh từ area sau chỗ trống. Vì vậy, đáp án đúng là (C), có thể tạo thành ý nghĩa 'khu vực xung quanh'.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) surrounded tuy cũng là tính từ nhưng lại mang nghĩa là 'được bao quanh', vì vậy không thể bổ nghĩa cho danh từ đứng sau.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) surroundings là danh từ số nhiều, nhưng khi tạo thành danh từ ghép thì danh từ đứng trước không thể ở số nhiều, vì vậy đáp án này sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) surrounds là một động từ, vì vậy không thể đặt giữa mạo từ và danh từ.\",\"weight\":\"#w400\"}]]}]]}]}",
