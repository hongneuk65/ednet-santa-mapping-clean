                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn từ loại phù hợp vào chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Cần điền vào chỗ trống là tân ngữ của động từ receive và là danh từ được bổ nghĩa bởi mệnh đề quan hệ bắt đầu bằng that, vì vậy đáp án đúng là danh từ (D) notification.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A), (B) là động từ, không thể đặt vào vị trí của tân ngữ cho động từ, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) là danh động từ kiêm hiện tại phân từ, mà nếu là danh động từ thì phải có tân ngữ theo sau, còn nếu là hiện tại phân từ thì không thể làm tân ngữ của động từ, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
