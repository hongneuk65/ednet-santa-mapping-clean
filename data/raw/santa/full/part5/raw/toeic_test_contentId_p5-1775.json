                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn hình thái động từ phù hợp với chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Chủ ngữ của câu là Holsinger Construction, sau chỗ trống có tân ngữ nên động từ phải ở thể chủ động.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Vì có động từ be là is đứng trước, nên từ cần điền vào chỗ trống là phân từ hiện tại hiring (D) tạo thành thì hiện tại tiếp diễn ở dạng be+ing.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là động từ (nguyên mẫu), (C) là động từ (biến thể ngôi thứ ba số ít), nên không thể dùng với is.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) là động từ (thì quá khứ) hoặc phân từ quá khứ, trường hợp xem như phân từ quá khứ, trở thành cụm động từ bị động be hired, nhưng vì có tân ngữ sau chỗ trống nên động từ không thểở dạng bị động.\"}]]}]]}]}",
