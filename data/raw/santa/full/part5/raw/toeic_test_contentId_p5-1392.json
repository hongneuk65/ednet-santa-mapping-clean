              "oneOfExplanationType": {
                "oneOfCase": "EXPLANATION",
                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn từ loại phù hợp vào chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Chỗ trống nằm giữa mạo từ a và danh từ bid nên sẽ chứa một tính từ bổ nghĩa cho bid. Đáp án đúng là (C) competitive, kết hợp với bid đằng sau để tạo thành ý nghĩa là \\\"đấu thầu cạnh tranh\\\" trong ngữ cảnh.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là danh từ, (B) là trạng từ, không thể làm tính từ nên đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là thì quá khứ của động từ kiêm quá khứ phân từ. Nếu là thì quá khứ của động từ thì nó không thể dùng như tính từ, mà compete là nội động từ nên cũng không thể dùng như tính từ dưới dạng quá khứ phân từ. Vì vậy, đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
