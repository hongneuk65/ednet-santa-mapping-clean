                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Vì sau chỗ trống có một mệnh đề gồm [chủ ngữ + động từ] và một mệnh đề khác sau dấu phẩy nên chỗ trống sẽ là vị trí cho một liên từ nối các vế câu.\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Vì mệnh đề trước và mệnh đề sau đối lập nhau về mặt ngữ nghĩa nên phải có một liên từ thể hiện sự nhượng bộ.\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Giữa (B) và (D), đáp án đúng là (D) \"}],[\"text\",{\"value\":\"Even if\",\"weight\":\"#w400\"}],[\"text\",{\"value\":\" đưa ra giả định về một điều gì đó chưa xảy ra.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A), (C) là trạng từ, không thể nối các vế câu nên đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) là một liên từ cho mệnh đề trạng ngữ có nghĩa là \\\"Dù~\\\", thể hiện sự nhượng bộ đối với một sự vật, sự kiện đã xảy ra, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
