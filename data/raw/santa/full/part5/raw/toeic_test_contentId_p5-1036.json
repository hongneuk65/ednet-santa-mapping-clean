              "oneOfExplanationType": {
                "oneOfCase": "EXPLANATION",
                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn liên từ phù hợp với ngữ cảnh.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Vì là cấu trúc 'chỗ trống + chủ ngữ + động từ, chủ ngữ + động từ' nên trong chỗ trống cần có một liên từ để nối hai mệnh đề.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Đáp án chính xác là (B), có nghĩa là 'ngay khi~', phù hợp với ý nghĩa 'ngay sau khi sa thải một số nhân viên, họ đã bắt đầu chiêu mộ nhân viên mới'.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) Meanwhile là phó từ nên không thể đứng đầu mệnh đề bao gồm 'chủ ngữ + động từ'.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) In addition to là cụm giới từ, vì vậy cũng không thể đứng đầu mệnh đề bao gồm 'chủ ngữ + động từ'.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) So là liên từ nhưng không thể sử dụng ở đầu câu vì cấu trúc của nó là 'nguyên nhân + so + kết quả'.\",\"weight\":\"#w400\"}]]}]]}]}",
