                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Volunteer[danh từ] tình nguyện viên\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\" Diễn giải\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Trước và sau chỗ trống đều có một mệnh đề, nên chỗ trống là vị trí của liên từ liên kết mệnh đề và mệnh đề.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Nội dung sau chỗ trống volunteers request them (các tình nguyện viên yêu cầu chúng) tương ứng với điều kiện của nội dung trước chỗ trống Tablet computers will be available (Máy tính bảng có sẵn), vì vậy đáp án đúng là liên từ mệnh đề trạng ngữ(B)if, thể hiện điều kiện.\"}],[\"text\",{\"value\":\".\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) và (C) là trạng từ, không thể liên kết mệnh đề với mệnh đề.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là liên từđẳng lập, thường được dùng sau dấu phẩy, đểkết nối mệnh đề trước và mệnh đềsau một cách tương tự nhau.\"}]]}]]}]}",
