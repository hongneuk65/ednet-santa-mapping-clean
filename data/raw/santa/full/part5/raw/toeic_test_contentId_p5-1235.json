              "oneOfExplanationType": {
                "oneOfCase": "EXPLANATION",
                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Vì cả trước và sau chỗ trống đều có mệnh đề nên cần điền ở đây một liên từ nối các vế câu.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Vì nội dung sau chỗ trống (bầu ra một chủ tịch mới) tương ứng với điều kiện của nội dung đứng trước (tiếp tục đàm phán hợp đồng), đáp án đúng là (C) once, có nghĩa là “một khi”.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là đại từ quan hệ hoặc liên từ của mệnh đề danh ngữ, mà nếu là đại từ quan hệ thì đằng sau phải có một mệnh đề không hoàn chỉnh, còn nếu là liên từ của mệnh đề danh ngữ thì nó phải đóng vai trò chủ ngữ/tân ngữ/bổ ngữ của câu. Có thể thấy cả hai trường hợp đều không đúng, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) là một cụm trạng từ có nghĩa là \\\"để~\\\", cần theo sau bởi to + động từ nguyên mẫu, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là một trạng từ có nghĩa là \\\"khi đó, sau đó\\\", không thể nối hai mệnh đề, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
