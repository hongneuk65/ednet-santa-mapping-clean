              "oneOfExplanationType": {
                "oneOfCase": "EXPLANATION",
                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn động từ phù hợp vào chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Cần điền một động từ có thể nhận mệnh đề that sau chỗ trống làm tân ngữ, và vì 'hài lòng hoặc được hoàn tiền' trong mệnh đề that là đối tượng được công ty hứa hẹn nên đáp án đúng là (C), có nghĩa là 'đảm bảo'.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) recommends cũng có thể lấy mệnh đề that làm tân ngữ, nhưng nó không phù hợp với ngữ cảnh và mệnh đề that phải sử dụng should hoặc động từ nguyên thể.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) admits cũng có thể lấy mệnh đề that làm tân ngữ, nhưng nó không phù hợp với ngữ cảnh vì có nghĩa là 'thừa nhận~'.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) indicates cũng có thể lấy mệnh đề that làm tân ngữ, nhưng nó thường được sử dụng với một chủ thể sự vật là dữ liệu hoặc nghiên cứu, và dùng để 'chỉ ra, gợi ý tới'. Nếu dùng với chủ thể là người thì chủ ngữ của mệnh đề chính phải giống với chủ ngữ của mệnh đề that.\",\"weight\":\"#w400\"}]]}]]}]}",
