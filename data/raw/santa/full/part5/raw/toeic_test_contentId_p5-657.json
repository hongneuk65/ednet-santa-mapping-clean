                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn trạng từ phù hợp vào chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Trạng từ điền vào chỗ trống sẽ bổ nghĩa cho động từ were breathing, vậy đáp án đúng là (A), có nghĩa là 'cực nhọc', vì nó sẽ bổ nghĩa cho 'hơi thở của các vận động viên khi \",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"về đến đích của cuộc đua marathon'.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) still (Trạng từ) vẫn còn\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) even (Trạng từ) thậm chí\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) lowly (Trạng từ) thấp, nhún nhường\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"hard có thể dùng ở cả dạng tính từ và trạng từ. Khi là tính từ, nó có nghĩa là 'chăm chỉ, mạnh mẽ, rắn, sốt sắng, cứng cáp', còn khi là trạng từ, nó được dùng với nghĩa 'một cách miệt mài, mệt mỏi, khó nhọc'.\",\"weight\":\"#w400\"}]]}]]}]}",
