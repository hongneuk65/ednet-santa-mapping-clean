                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Cụm động từ bị động be kept khi sử dụng ở thể chủ động sẽ có dạng [keep + tân ngữ + bổ ngữ cho tân ngữ], và có 5 dạng.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. [keep + tân ngữ + bổ ngữ cho tân ngữ] nếu chuyển sang dạng bị động sẽ chở thành [tân ngữ (chủ ngữ của câu bị động) + be kept + bổ ngữ cho tân ngữ], vì vậy chỗ trống sẽ là bổ ngữ của tân ngữ]\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Cần điền vào vị trí bổ ngữ của tân ngữ một danh từ hoặc tính từ. Vì trong ngữ cảnh này cách nói \\\"\",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"những vật có giá trị được cất giữ an toàn\\\" là tự nhiên nhất nên đáp án đúng là (D), secure.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là động từ, không thể ở vị trí bổ ngữ của keep nên đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) là danh từ nghĩa là \\\"bảo mật\\\", (C) nghĩa là \\\"sự an toàn\\\" và có thể dùng làm bổ ngữ của tân ngữ, nhưng vì không phù hợp với ngữ cảnh nên đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
