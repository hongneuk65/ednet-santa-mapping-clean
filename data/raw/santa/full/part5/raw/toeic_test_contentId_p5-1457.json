                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn từ loại phù hợp vào chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Vì chỗ trống nằm giữa mạo từ an và danh từ list nên sẽ chứa một tính từ bổ nghĩa cho list.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Trong (B) và (C), đáp án đúng là (B) exhaustive, có nghĩa là \\\"đầy đủ, kỹ lưỡng\\\".\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là thì hiện tại của động từ, (D) là trạng từ, không thể dùng như tính từ nên đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) là thì quá khứ của động từ hoặc quá khứ phân từ. Nếu là thì quá khứ của động từ thì nó không thể được dùng như tính từ, còn nếu là tính từ dưới dạng quá khứ phân từ thì nó có nghĩa là \\\"mệt mỏi, kiệt sức\\\", không phù hợp với ngữ cảnh nên đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
