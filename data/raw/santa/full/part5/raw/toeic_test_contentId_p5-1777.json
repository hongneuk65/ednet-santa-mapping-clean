              "oneOfExplanationType": {
                "oneOfCase": "EXPLANATION",
                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn từ loại phù hợp với chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Chỗ trống là vị trí chủ ngữ của mệnh đề danh từ đóng vai trò tân ngữ của động từ has suggested. Động từ trong mệnh đề danh từ là be sent, còn động từ suggest trong mệnh đề chính là động từ thể hiện sự yêu cầu, đề nghị nên should trong should be sent là từ đã được lược bỏ.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Trong các đáp án (A), (B) và (D) có thể đặt ở vị trí chủ ngữ, thì (A) là danh từ đếm được số ít có nghĩa là “máy photo” không thể được dùng nếu không có từ hạn định nghĩa ở trước, còn (D) là danh động từ với copy là ngoại động từ, nên dù là một danh động từ thì cũng phải có tân ngữ ở sau, vì vậy đây đều là đáp án sai.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"4. Vì vậy, đáp án đúng là danh từ đếm được số nhiều copies (B), có nghĩa là “các bản sao của kết quả khảo sát phải được gửi đi”.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) là động từ (thì quá khứ) hoặc phân từ quá khứ, không thể ở vị trí chủ ngữ.\"}]]}]]}]}",
