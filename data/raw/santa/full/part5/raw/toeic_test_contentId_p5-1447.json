                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Vì trước và sau chỗ trống đều có mệnh đề nên chỗ trống sẽ chứa một liên từ nối các mệnh đề với nhau.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. \",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"Vì nội dung sau ô trống tương ứng với lý do của nội dung đằng trước, đáp án đúng là (B) as, nghĩa là “bởi vì”.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là từ nghi vấn, có thể đứng đầu mệnh đề danh ngữ (câu nghi vấn gián tiếp), nhưng trong trường hợp này phải có một động từ lấy danh từ làm tân ngữ, vì vậy đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) là giới từ, không thể nối các mệnh đề với nhau nên đáp án sai.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là liên từ kết hợp có nghĩa là \\\"vì vậy\\\". Đáp án sai vì không phù hợp với ngữ cảnh và cần có dấu phẩy ở đằng trước.\",\"weight\":\"#w400\"}]]}]]}]}",
