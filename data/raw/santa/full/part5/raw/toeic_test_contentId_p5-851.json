                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. \",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"Đây là câu hỏi chọn động từ thích hợp với chỗ trống.\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Trong chỗ trống cần một động từ phù hợp với cấu trúc 'vị thế + as + vai trò' nằm sau chỗ trống, và (A), được sử dụng khi diễn đạt ý nghĩa 'lấy lại vị thế~', là câu trả lời đúng.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) remind có nghĩa là ‘nhắc nhở’ và lấy một danh từ chỉ người làm tân ngữ.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) refer được sử dụng với cấu trúc 'người + to + sự vật' để thể hiện nghĩa 'khiến ai tham khảo thứ gì~'.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) request có nghĩa là ‘yêu cầu’ và chủ yếu lấy tân ngữ chỉ sự vật, khi lấy tân ngữ chỉ người thì nó được dùng trong cấu trúc ‘người + mệnh đề that’.\",\"weight\":\"#w400\"}]]}]]}]}",
