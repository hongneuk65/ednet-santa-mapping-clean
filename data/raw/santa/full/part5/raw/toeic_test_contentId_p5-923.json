                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn danh từ phù hợp vào chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Từ cần điền là là tân ngữ của động từ renew, có thể kết hợp với giới từ to và chỉ 'vật có thể gia hạn mà liên quan tới việc sử dụng tạp chí', vì vậy đáp án đúng là (C), tức 'đăng ký'.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) entitlement cũng có thể dùng với to để tạo thành ý nghĩa 'quyền, sự được phép làm~', nhưng đối tượng của nó không thể là tạp chí.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) employment có nghĩa là 'sự làm công, sự thuê người làm công', và thường được sử dụng với giới từ of để tạo thành ý nghĩa 'sự làm công của~'. \",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) prescription có nghĩa là 'toa thuốc', vì vậy không phù hợp với ý nghĩa của câu.\",\"weight\":\"#w400\"}]]}]]}]}",
