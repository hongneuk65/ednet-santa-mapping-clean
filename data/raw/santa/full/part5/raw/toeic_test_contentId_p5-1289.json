              "oneOfExplanationType": {
                "oneOfCase": "EXPLANATION",
                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn dạng động từ phù hợp.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. \",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"Vì có một mệnh đề hoàn chỉnh gồm [Chủ ngữ + Động từ] trước chỗ trống nên ở đây sẽ chứa một bổ ngữ.\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Vì vậy, dạng to động từ nguyên mẫu (B) chỉ \\\"mục đích thực hiện\\\" là đáp án đúng.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là hiện tại phân từ, (D) là phân từ hoàn thành, phải có danh từ bổ nghĩa trước hoặc sau nó, hơn nữa những câu trả lời này cũng không thể tạo thành cấu trúc phân từ. Vì vậy, các đáp án này sai.\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) là thì hiện tại của động từ, mà trước chỗ trống đã có một mệnh đề hoàn chỉnh và trong câu không có liên từ, do đó không thể điền vào chỗ trống một động từ khác. \",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"Vì vậy đáp án này sai.\"}]]}]]}]}",
