                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn từ loại phù hợp với chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Trước chỗ trống có danh từ 'installation' và sau chỗ trống có động từ của câu 'have been uploaded' nên chỗ trống là vị trí danh từ đóng vai trò chủ ngữ của câu tạo thành danh từ ghép với 'installation' ở trước.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Trong các đáp án (B), (C) và (D), đáp án đúng là danh từ đếm được số nhiều (B), có cùng số với động từ 'have been uploaded' có nghĩa là “hướng dẫn cài đặt”.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) động từ (thì quá khứ) hoặc phân từ quá khứ\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) danh từ đếm được số nhiều, nhưng có nghĩa \\\"các giảng viên\\\" nên không phù hợp với ngữ cảnh.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) danh từ đếm được số ít, không phù hợp số với động từ.\"}]]}]]}]}",
