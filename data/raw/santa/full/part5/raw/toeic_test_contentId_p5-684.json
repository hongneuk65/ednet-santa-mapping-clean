                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn động từ phù hợp vào chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Cần điền một động từ có thể lấy mệnh đề that làm tân ngữ và chỉ ra một điều giải thích 'chức năng của đèn xanh', vì vậy đáp án đúng là (C) tức 'chỉ ra, biểu thị'.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) exposes là ngoại động từ có nghĩa là 'phơi bày~' và không lấy mệnh đề that làm tân ngữ. \",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) labels là ngoại động từ có nghĩa là 'dán nhãn~' và cũng không lấy mệnh đề that làm tân ngữ. \",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) requires là một ngoại động từ có nghĩa là 'yêu cầu, cần thiết~' và có thể dùng mệnh đề that làm tân ngữ, nhưng trong mệnh đề that nên có should và dùng động từ nguyên thể.\",\"weight\":\"#w400\"}]]}]]}]}",
