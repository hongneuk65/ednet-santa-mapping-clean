                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Đây là câu hỏi lựa chọn từ loại phù hợp vào chỗ trống.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Sau chỗ trống có cụm giới từ đứng đầu bởi for, và tiếp theo là động từ will receive nên chỗ trống sẽ là một danh từ giữ chức vụ chủ ngữ của câu đồng thời được bổ nghĩa bởi cụm giới từ.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Trong số các đáp án (B) và (D), đáp án đúng là danh từ chỉ người (B), tạo thành ý nghĩa \\\"\",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"Ứng viên sẽ nhận được lời mời phỏng vấn\\\".\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) là động từ, (C) là thì quá khứ hoặc quá khứ phân từ của động từ, cả hai đáp án đều sai vì không thể đặt ở vị trí của danh từ.\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) là một danh từ có nghĩa là \\\"(sự) ứng tuyển\\\", không phù hợp với ngữ cảnh nên đáp án sai.\",\"weight\":\"#w400\"}]]}]]}]}",
