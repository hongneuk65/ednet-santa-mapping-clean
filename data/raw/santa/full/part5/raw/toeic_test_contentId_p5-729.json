                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. \",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"Đây là câu hỏi chọn động từ thích hợp với chỗ trống.\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. \",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"Đáp án đúng là (D) được dùng khi diễn đạt ý nghĩa ‘nằm ở~’, vì nó phải chỉ ra một vị trí cụ thể với cấu trúc ‘be động từ + chỗ trống + on’.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) appeared là nội động từ có nghĩa là 'xuất hiện, có vẻ như~' nên không thể sử dụng trong thể \",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"bị động.\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) remained đi kèm tính từ hoặc danh từ bổ ngữ để thể hiện ý nghĩa 'duy trì ở trạng thái~' nên không thể sử dụng trong thể \",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"bị động.\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) arranged \",\"weight\":\"#w400\"}],[\"text\",{\"value\":\"có thể được sử dụng trong cấu trúc ‘be động từ + quá khứ phân từ + on’ để thể hiện ý nghĩa ‘được sắp xếp ~’, nhưng nó không được dùng để thể hiện vị trí của cửa hàng.\"}]]}]]}]}",
