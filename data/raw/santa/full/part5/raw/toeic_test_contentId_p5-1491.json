                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Trước chỗ trống có một mệnh đề hoàn chỉnh bao gồm [chủ ngữ + động từ + tân ngữ], nên từ chỗ trống trở xuống là bổ ngữ.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Sau chỗ trống có một động từ nguyên mẫu, nên đáp án (A) in order to có nghĩa là “để làm ~” được sử dụng trước động từ nguyên mẫu, đây là đáp án đúng.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) là một cụm giới từ có nghĩa là “thay vì ~”, không thể sử dụng trước động từ nguyên mẫu, nên đây là đáp án sai.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) là một cụm giới từ có nghĩa là “liên quan đến ~”, không thể sử dụng trước động từ nguyên mẫu, nên đây là đáp án sai.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\" (D) là một trạng từ có nghĩa là \\\"mặc dù ~\\\", thường được sử dụng với dấu phẩy ở đầu câu nên đây là đáp án sai.\"}]]}]]}]}",
