            {
              "id": "",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Thông báo\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Hãy mạnh dạn thử thách hoàn thành cuộc đua marathon vào mùa hè này! Thành phố Atlanta, cùng với Ủy ban Y tế Atlanta, sẽ tổ chức một cuộc thi marathon địa phương dành cho các vận động viên vào chủ nhật, ngày 3 tháng 8. Cuộc đua dự kiến ​​bắt đầu tại tòa thị chính. Từ đó, tuyến đường đua chạy qua trung tâm thành phố và kết thúc tại Công viên Oxford. Nếu muốn đăng ký tham gia sự kiện này, xin vui lòng truy cập www.atlanta-marathon.com. Để giúp cho việc chuẩn bị, các vận động viên cá nhân có thể sử dụng công cụ trực tuyến, tạo lịch tập luyện cá nhân trên trang web của chúng tôi.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"along with cùng với\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"sponsor [động từ ] chủ trì [chủ tọa](sự kiện chính thức)\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"local [tính từ] địa phương\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"athlete [danh từ] vận động viên (thể thao)\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"route [danh từ] đường, lộ trình\"}]]}]]}]}",
                  "oneOfCase": "RRT_V2_SECTIONS_JSON"
                }
