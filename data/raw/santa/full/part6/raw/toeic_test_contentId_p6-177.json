              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Bảng hướng dẫn sử dụng máy pha cà phê Miura-44\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Với sự quản lý đúng cách, máy pha cà phê Miura-44 của bạn chắc chắn sẽ tiếp tục hoạt động sau nhiều năm sử dụng. Để pha một bình cà phê, hãy lấy màng pha cà phê ra khỏi máy và đổ đầy cà phê xay sẵn mà bạn muốn vào. Mẫu này được cung cấp một bộ lọc vĩnh viễn có thể làm sạch và tái sử dụng được. Do đó, không cần lọc giấy. Nhấn nút bắt đầu để bắt đầu chu trình pha. Đèn xanh sẽ bắt đầu nhấp nháy sau khi chu kỳ này hoàn tất. Hãy rửa ấm rỗng bằng nước xà phòng ấm.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"reliably [phó từ] một cách rõ ràng\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"brew [động từ] đun, làm cà phê\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"ground [tính từ] xay, làm từ bột\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"permanent [tính từ] vĩnh viễn\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"flash [động từ] phát tín hiệu (bằng ánh đèn)\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"soapy water nước xà phòng\"}]]}]]}]}",
