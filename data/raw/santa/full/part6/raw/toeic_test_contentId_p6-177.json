              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Miura-44 Coffee Maker Instructions\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"With proper care, your Miura-44 coffee maker will still operate \"}],[\"blank\",{\"number\":1}],[\"text\",{\"value\":\" after years of use. To brew a pot of coffee, \"}],[\"blank\",{\"number\":2}],[\"text\",{\"value\":\" the brewing basket from the machine and fill it with the ground coffee of your choice. This model comes with a permanent filter that can be washed and reused. \"}],[\"blank\",{\"number\":3}],[\"text\",{\"value\":\". Press Start to begin the brewing cycle. The green light will begin flashing \"}],[\"blank\",{\"number\":4}],[\"text\",{\"value\":\" the cycle is completed. Wash the empty pitcher in warm, soapy water.\"}]]}]]}"
                }
