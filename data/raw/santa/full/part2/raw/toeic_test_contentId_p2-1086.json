n\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Có thể sẽ tồn tại nhiều hơn một đáp án chứa địa điểm đối với câu hỏi Where, vì vậy đừng vội lựa chọn đáp án đầu tiên chứa địa điểm làm câu trả lời đúng. Thay vào đó, ta cần nghe đến hết rồi mới đưa ra quyết định cuối cùng.\",\"weight\":\"#w400\"}]]}]]}]}",
