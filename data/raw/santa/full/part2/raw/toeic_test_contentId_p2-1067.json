ren\":[[\"text\",{\"value\":\"(C) Đây là một đáp án bẫy biến từ turn dùng để chỉ đường thành turn down, có nghĩa là 'từ chối'.\",\"weight\":\"#w400\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"align\":\"#left\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Nên nhớ một chiến thuật là lược bỏ những đáp án có cách phát âm hoặc đánh vần tương đồng, rồi lấy đáp án còn lại làm câu trả lời.\",\"weight\":\"#w400\"}]]}]]}]}",
