          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good morning, everyone. You may have noticed that we have updated the software on all of our computers here at the company, and we have even installed a new operating system. If any of you are unsure how to use the new system, I encourage you to attend the computer workshop tomorrow morning at 9 A.M. Our tech assistant, George Lutz, will be leading the training session. If you think this would be helpful to you, please sign your name on the form that I posted on the staff notice board.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào buổi sáng, mọi người. Các bạn có thể nhận thấy rằng chúng tôi đã cập nhật phần mềm trên tất cả máy tính tại công ty và thậm chí đã cài đặt một hệ điều hành mới. Nếu bất kỳ ai trong số các bạn không chắc chắn về cách sử dụng hệ thống mới, tôi khuyến khích các bạn tham gia hội thảo máy tính vào lúc 9 giờ sáng ngày mai. Nhân viên kỹ thuật của công ty, George Lutz, sẽ dẫn dắt buổi đào tạo. Nếu bạn nghĩ rằng buổi hội thảo này sẽ có ích, vui lòng ký tên vào biểu mẫu mà tôi đã đăng trên bảng thông báo của nhân viên.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nữ người Anh\"}]]}]]}"
                }
              }
            },
