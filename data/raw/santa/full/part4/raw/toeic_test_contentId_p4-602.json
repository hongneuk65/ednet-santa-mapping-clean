          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Steve. It’s Rosa. We’re having a CT scanner delivered to our clinic this afternoon. So, I need some help removing all boxes and furniture from the main hallways. The scanner needs to be brought to the third floor. Due to the weight of the machine, we can only use the freight elevator. I’ll put up some signs to inform people that they will not be allowed to use the freight elevator for about half an hour while the machine is being transported. Herman Wyatt, a professional engineer, will also be here to set up the machine and make sure it is operating properly.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào Steve. Tôi là Rosa. Máy scan CT của bệnh viện chúng ta sẽ được giao đến vào chiều nay. Vì vậy, tôi cần một số trợ giúp để dọn hết tất cả các hộp và đồ đạc ở hành lang trụ sở chính. Máy scan cần mang lên tầng ba. Do trọng lượng của máy nên chúng ta chỉ có thể sử dụng thang máy tải hàng. Tôi sẽ đăng một biển báo để mọi người biết rằng thang máy tải hàng sẽ không được sử dụng trong nửa giờ vận chuyển máy scan. Herman Wyatt, một kỹ thuật viên chuyên nghiệp, cũng sẽ đến đây để cài đặt máy và kiểm tra máy hoạt động có ổn hay không.\"}]]}]]}"
                }
              }
            },
