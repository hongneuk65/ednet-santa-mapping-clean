          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good afternoon. My name is Karley Chatterson, and I’m the new owner of the BMP Music Store. I’ve been looking at your Web site, and I’d like to get some more information. I’m planning on adding an extra section to my store so that I can sell pianos. I’m especially interested in having a variety of keyboards delivered to my store on a regular basis. If you could please call me back at 723-4445, that would be great because I’d like to set up a time to meet to discuss prices and delivery options. Thanks.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào buổi chiều. Tên tôi là Karley Chatterson và tôi là chủ sở hữu mới của BMP Music Store. Tôi vừa xem trang Web của bạn và tôi muốn biết thêm một số thông tin. Tôi đang có kế hoạch bổ sung thêm một khu riêng vào cửa hàng của mình để có thể bán đàn piano. Tôi đặc biệt quan tâm đến việc được giao nhiều loại bàn phím đến cửa hàng một cách thường xuyên. Nếu có thể, vui lòng gọi lại cho tôi theo số 723-4445. Tôi muốn sắp xếp thời gian gặp mặt để thảo luận về các sự lựa chọn giá cả và giao hàng. Xin cảm ơn.\"}]]}]]}"
                }
              }
            },
