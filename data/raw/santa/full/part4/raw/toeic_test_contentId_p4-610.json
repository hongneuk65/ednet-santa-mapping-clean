          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Chris. It’s Jacqueline. Some product samples will be delivered this afternoon. I just found out that someone needs to sign for the package on my behalf, and, unfortunately, I’ll be away from the office. I heard that you’re working all afternoon. I hope you don’t mind taking care of this for me. I’d do it myself, but I’m meeting Ms. Ferguson, one of our newest clients, at her office. The samples can be placed in the storage room, and I’ll deal with them later. I’ll leave the key to the storage room on your desk. Thanks!\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, Chris. Tôi là Jacqueline. Một số mẫu sản phẩm sẽ được chuyển đến chiều nay. Tôi vừa biết rằng cần  ai đó ký nhận bưu kiện thay cho tôi, và thật không may là tôi sẽ rời văn phòng. Tôi nghe nói bạn làm việc cả buổi chiều. Tôi hi vọng bạn có thể xử lý việc này cho tôi. Tôi muốn mình có thể tự làm được điều đó, nhưng tôi sẽ phải gặp cô Ferguson, một trong những khách hàng gần đây nhất của tôi tại văn phòng của cô ấy. Bạn có thể đặt mẫu trong kho và tôi sẽ xử lý chúng sau . Tôi sẽ đặt chìa khóa kho hàng trên bàn của bạn. Cảm ơn bạn!\"}]]}]]}"
                }
              }
            },
