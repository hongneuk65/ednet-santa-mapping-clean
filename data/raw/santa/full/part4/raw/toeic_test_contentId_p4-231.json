          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, everybody. Welcome to Sunvac Tours flight number 205. I’d just like to inform you that there is a bit of a delay in boarding the aircraft at the moment. The equipment used to refuel the planes has stopped working, so we need to locate some different equipment before we depart. In the meantime, could you please present your boarding tickets to our staff so that they can check them now? This will make it quicker to board the aircraft when the time comes.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào mọi người. Chào mừng bạn đến với chuyến bay số 205 của Sunvac Tours. Chúng tôi xin thông báo rằng hiện tại chuyến bay đang có một chút chậm trễ. Các thiết bị được sử dụng để tiếp nhiên liệu cho máy bay đã ngừng hoạt động, vì vậy, chúng tôi cần tìm thiết bị khác trước khi khởi hành. Trong thời gian chờ đợi, vui lòng xuất trình vé lên máy bay của mình cho nhân viên của chúng tôi để họ kiểm tra chúng ngay bây giờ. Khi máy bay đã sẵn sàng, bạn sẽ có thể lên máy bay nhanh hơn.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nam người Úc\"}]]}]]}"
                }
