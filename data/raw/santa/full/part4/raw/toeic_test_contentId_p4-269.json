          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hey, Linda. It’s Darren. I just wanted to let you know that I bought our tickets for the Summerdale Jazz Concert on Saturday. We’re both on a budget, so I didn’t get the seats near the stage, since … uh … since they’re a lot more expensive. Instead, I got us seats further back, near the snack bar. I think we’ll still have a good view from there. I’ll pick you up around six o’clock on Saturday, but you should know that the forecast says it’s going to be cold. So, be sure to dress in plenty of thick layers. See you Saturday!\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, Linda. Tôi là Darren đây. Tôi chỉ muốn thông báo cho bạn biết rằng tôi đã mua vé tham dự Summerdale Jazz Concert vào thứ Bảy tuần này. Cả hai chúng ta đều không có được chỗ ngồi gần sân khấu vì chúng ta không có nhiều tiền, và… ờ… vì những chỗ ngồi đó đắt hơn nhiều. Thay vào đó, tôi mua chỗ ở đằng sau gần quán ăn nhanh. Tôi nghĩ ngồi ở đây vẫn xem được tốt. Tôi sẽ đón bạn vào khoảng 6 giờ thứ Bảy, nhưng bạn nên nhớ là dự báo thời tiết nói rằng trời sẽ lạnh. Vì vậy, hãy nhớ mặc nhiều lớp quần áo ấm. Hẹn gặp bạn vào thứ bảy!\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
