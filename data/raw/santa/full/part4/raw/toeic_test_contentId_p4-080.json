          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Attention, all passengers. I’ve just been told that there has been a traffic accident on Main Road, and it’s blocking our bus route. This means I’ll be unable to stop at the Main Road Library bus stop. The road has been temporarily closed, so this bus will have to take a detour along Primrose Street. If you had been planning to disembark on Main Road, I would suggest getting off on Primrose Street and taking a local bus a couple of stops to your destination. Sorry for this inconvenience.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Các hành khách vui lòng chú ý. Tôi vừa được thông báo rằng đã xảy ra một vụ tai nạn giao thông trên Main Road nên chặn đường xe buýt của chúng ta. Điều này đồng nghĩa với việc xe sẽ không thể dừng ở trạm xe buýt Main Road Library. Con đường đã tạm thời bị đóng, vì vậy xe buýt sẽ phải đi đường vòng dọc theo Primrose Street. Nếu bạn dự định xuống xe tại Main Road, tôi khuyên bạn nên xuống từ Primrose Street và bắt xe buýt địa phương, qua một vài trạm dừng thì sẽ là điểm đến của các bạn. Xin lỗi vì sự bất tiện này.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}]]}"
                }
              }
            },
            {
              "id": "",
