          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Irvin. This is Kelsey. I’d like to ask you for a favor. I know you’re representing our team at the International Medical Conference this weekend. I read that there will be a prototype on display of a surgical robot that an Indian company is introducing at the conference. Could you please take some pictures of it? I’d like to see what it looks like in detail. Also, don’t forget that next week you need to submit a report about the conference when you get back. So, you’d better pick up brochures and other materials for that.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, Irvin. Tôi là Kelsey. Tôi muốn nhờ bạn một việc. Tôi biết bạn đại diện cho nhóm chúng ta tại hội nghị y tế quốc tế vào cuối tuần này. Tôi đã đọc được là tại hội nghị sẽ trưng bày một sản phẩm thử nghiệmcủa robot dùng đểphẫu thuật được giới thiệu bởi một công ty Ấn Độ. Bạn có thể chụpảnh của nó không? Tôi muốn xem chi tiết nó trông như thế nào. Và đừng quên nộp báo cáo vềhội nghị vào tuần tớikhi bạn quay trở về. Vì vậy, tốt hơn bạn nên lấytài liệu quảng cáo và các tài liệu khác cho việc đó.\"}]]}]]}"
                }
              }
            },
