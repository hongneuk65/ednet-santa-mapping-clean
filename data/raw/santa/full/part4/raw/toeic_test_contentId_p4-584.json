          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good afternoon. This message is for Kathy Russel. This is Michael from the property management office. I got your message asking about your apartment maintenance fees. These are charged quarterly. So, you’ll receive your first bill for fees at the end of this month. You can then drop off a check at our office. Or, you can pay by bank transfer if you prefer. I’ll send you the account number and routing number that you’ll need if you want to transfer the funds directly to our bank. So, check your e-mail shortly. Thanks!\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào. Đây là tin nhắn gửi cho Kathy Russel. Tôi là Michael từ văn phòng quản lý chung cư. Tôi đã nhận được tin nhắn của cô hỏi về phí quản lý chung cư. Phí quản lý được yêu cầu đóng hàng quý. Vì vậy, cô Russel sẽ nhận được giấy yêu cầu đóng phí đầu tiên vào cuối tháng này. Sau đó, cô có thể đến văn phòng của chúng tôi trả bằng séc. Hoặc, nếu muốn cô có thể chi trả bằng cách chuyển khoản ngân hàng. Nếu cô muốn chuyển khoản trực tiếp vào ngân hàng, chúng tôi sẽ gửi số tài khoản và số định tuyến ngân hàng cần thiết. Vì vậy, vui lòng kiểm tra email sớm. Xin cảm ơn!\"}]]}]]}"
                }
              }
            },
