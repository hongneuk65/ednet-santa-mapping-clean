          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello, this is a call for Mr. Helguson. My name is Jon Walters calling from Perfect Home Kitchen Services. I’m calling to rearrange the installation time of your new appliances. Our technician, Paul, stopped by your house at 6 P.M. on Thursday, 9th of July, which was the arranged date and time, but nobody answered the door or telephone. We are closing for the day now, but if you could please e-mail us a new date and time that is good for you, I will get in touch with you first thing tomorrow morning to confirm. Many thanks. Bye.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, tôi đang gọi đến cho anh Helguson. Tôi là Jon Walters gọi từ Perfect Home Kitchen Services. Tôi gọi đến để sắp xếp lại thời gian lắp đặt các thiết bị mới của anh. Kỹ thuật viên của chúng tôi, anh Paul, đã ghé qua nhà anh lúc 6 giờ chiều vào thứ Năm, ngày 9 tháng Bảy. Đó là ngày và giờ đã định sẵn nhưng không ai mở cửa hay trả lời điện thoại. Hôm nay chúng tôi đã đóng cửa, nhưng nếu anh có thể,vui lòng gửi email cho chúng tôi ngày và giờ mới phù hợp hơn qua email, tôi sẽ liên hệ với anh vào sáng mai để xác nhận. Cảm ơn nhiều. Tạm biệt.\"}]]}]]}"
                }
              }
            },
