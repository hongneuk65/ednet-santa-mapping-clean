          "description": {
            "oneOfData": {
              "rrtV2SectionsJson": "",
              "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
              "rrtV2InlineElementsJson": "",
              "html": "",
              "text": "",
              "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Questions 1-3 refer to the following telephone message.\"}]]}]]}"
            }
          },
          "explanations": [
            {
              "id": "890ae2b1-a130-48fe-9d14-fc70c8c17b93",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello. This message is for the manager of the customer service team. This is Harriet calling about the ordering section of our Web site being down. We have detected attacks on the network that came from some viruses. My team and I are currently working to resolve the problem. We want to make sure the site is secure before it goes live again. It will probably take a few hours to get the system up and running. In the meantime, I think we’d better put up a notice online so that customers know what’s going on.\"}]]}]]}"
                }
              }
            },
            {
              "id": "664f2246-3e5e-406c-8e13-5cdc9fcbc39a",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào. Đây là tin nhắn gửi đến trưởng nhóm dịch vụ khách hàng. Tôi là Harriet và tôi gọi điện đến vì mục đặt hàng trên trang web của chúng ta đã ngừng hoạt động. Chúng tôi đã phát hiện thấy có một sự tấn công mạng do vi-rút nào đó gây ra. Tôi và nhóm của tôi hiện đang nỗ lực để giải quyết vấn đề. Chúng tôi muốn chắc chắn rằng trang web an toàn trước khi sẵn sàng khởi động lại. Có thể sẽ mất vài giờ để hoàn toàn khởi động hệ thống bình thường. Trong thời gian này, chúng ta nên thông báo trực tuyến để các khách hàng biết chuyện gì đang xảy ra.\"}]]}]]}"
                }
              }
            },
            {
