          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, there. This is a message for Barbara Kemlo. This is Brian Main from Capitan Corporation. I’m calling to confirm our catering booking for next Wednesday from 7 P.M. to 10 P.M. Also, please remember that the convention center will close promptly at 10 P.M. Therefore, we must ensure that the hall is cleaned by 10:30 P.M. Please ask your staff to collect dishes as soon as they are emptied, and begin clearing tables as people leave. Before your staff leave the venue, could you also remind them to return the uniforms we provided you for the event?\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào. Đây là tin nhắn dành cho Barbara Kemlo. Tôi là Brian Main từ Capitan Corporation. Tôi gọi điện để xác nhận cô đã đặt dịch vụ ăn uống của chúng tôi cho Thứ Tư tới từ 7 giờ đến 10 giờ tối. Ngoài ra, hãy nhớ rằng trung tâm hội nghị sẽ đóng cửa nhanh chóng lúc 10 giờ tối. Vì vậy, chúng tôi phải đảm bảo rằng hội trường được thu dọn trước 10:30 tối. Vui lòng yêu cầu nhân viên của cô thu dọn hết bát đĩa trống và bắt đầu dọn bàn ngay khi mọi người rời đi. Trước khi nhân viên của cô rời khỏi địa điểm, cô có thể nhắc họ trả lại đồng phục mà chúng tôi đã cung cấp cho sự kiện không?\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nam người Mỹ\"}]]}]]}"
                }
