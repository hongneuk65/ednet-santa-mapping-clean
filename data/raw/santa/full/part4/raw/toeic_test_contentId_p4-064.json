          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Thank you for calling the Beasley Theater Group. We are one of the largest amateur drama groups in the country. We meet twice a week to rehearse for our monthly theater performances. If you are interested in joining our group, please come down to Selkirk Hall to attend one of our meetings on Tuesdays and Thursdays at 7 P.M. You can also check our Web site for information about our upcoming performances and our exact location.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Cảm ơn bạn đã gọi điện đến Beasley Theater Group. Chúng tôi là một trong những nhóm kịch không chuyên lớn nhất cả nước. Chúng tôi gặp nhau hai lần một tuần để tập dượt cho các buổi biểu diễn tại nhà hát hàng tháng. Nếu bạn muốn tham gia vào nhóm của chúng tôi, vui lòng đến Selkirk Hall để tham dự một trong các cuộc họp vào các ngày Thứ Ba và Thứ Năm lúc 7 giờ tối. Bạn cũng có thể truy cập vào trang Web của chúng tôi để biết thông tin về các buổi biểu diễn sắp tới và vị trí chính xác.\"}]]}]]}"
                }
              }
            },
