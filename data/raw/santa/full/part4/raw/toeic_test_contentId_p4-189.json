              "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
              "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Questions 1-3 refer to the announcement .\"}]]}]]}"
            }
          },
          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: This week, the Reynolds Art Gallery will feature a display by prestigious Dutch artist Chasey Hyma. This stunning collection will be open to the public for the first time, so be one of the first to witness the beauty of these exquisite paintings. On Friday, Ms. Hyma herself will be on hand for a question and answer session, starting at 7 p.m. sharp. As there will be a limited amount of time, guests can suggest questions to be asked in advance. To add your question to the list, call the gallery’s reception at 1-800-4302-0402.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Tuần này, Reynolds Art Gallery sẽ có buổi triển lãm của nghệ sĩ người Hà Lan vô cùng danh giá là Chasey Hyma. Đây là lần đầu tiên bộ sưu tập tuyệt đẹp này ra mắt công chúng, vì vậy hãy là một trong những người đầu tiên chứng kiến vẻ đẹp của những bức tranh tinh xảo này. Vào thứ Sáu, chính cô Hyma sẽ có mặt trong một buổi hỏi đáp bắt đầu vào đúng 7 giờ tối. Vì thời gian có hạn nên các vị khách có thể đề xuất trước các câu hỏi. Để thêm câu hỏi của bạn vào danh sách, hãy gọi cho lễ tân của phòng trưng bày theo số 1-800-4302-0402.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nam người Anh\"}]]}]]}"
                }
