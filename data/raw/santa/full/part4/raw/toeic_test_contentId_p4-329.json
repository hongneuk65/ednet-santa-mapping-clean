          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good afternoon. I’m calling to speak with Mr. Kepler. This is Alex Kim Jenkins from Gottfried Accounting. I would like to talk to you about my recent evaluation of your offices in Stevenville. So far, I have some ideas about where you can cut some of your operation costs. However, to complete my assessment, I will need to see some other documents to better understand how you are allocating your budget. I would appreciate it if you could send me your expense reports for each branch. Please fax them to me, or e-mail them to alex.kim@gottfriedacc.co.uk. Have a nice day.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào buổi chiều. Tôi gọi đến để trao đổi với anh Kepler. Tôi là Alex Kim Jenkins từ Gottfried Accounting. Tôi muốn trao đổi thông tin liên quan đến đánh giá gần đây của tôi về các văn phòng của anh ở Stevenville. Tôi có một vài ý tưởng để cắt giảm một vài chi phí hoạt động của anh. Tuy nhiên, để hoàn thành đánh giá của mình, tôi sẽ cần xem một số tài liệu khác để hiểu rõ hơn cách anh đang phân bổ ngân sách. Mong anh có thể gửi cho tôi báo cáo chi phí của từng chi nhánh. Vui lòng gửi fax cho tôi hoặc gửi email đến alex.kim@gottfriedacc.co.uk. Chúc một ngày tốt lành.\"}]]}]]}"
                }
              }
            },
