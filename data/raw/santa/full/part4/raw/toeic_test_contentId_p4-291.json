          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Nice to see you all today! Allow me to introduce Martin Tuffnell, our new sales representative. Since our cell phone products have gained popularity, it has become necessary to hire more salespeople. Martin has had experience selling phones at smaller companies, but he has never worked for a firm as expansive as ours. I’d appreciate it if you could all take the time to assist him during his first week here. I’ll be training him in product knowledge this morning, before he observes our senior sales representative, Danna Addy, for the remainder of the day.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Rất vui được gặp tất cả các bạn ngày hôm nay! Cho phép tôi giới thiệu Martin Tuffnell, nhân viên bán hàng mới của chúng ta. Kể từ khi các sản phẩm điện thoại di động của chúng ta dần phổ biến, việc tuyển thêm nhân viên bán hàng đã trở nên cần thiết. Martin đã có kinh nghiệm bán điện thoại tại các công ty nhỏ hơn, nhưng anh ấy chưa bao giờ làm việc cho một công ty có quy mô lớn như của chúng ta. Tôi sẽ rất vui nếu tất cả các bạn có thể dành thời gian để hỗ trợ anh ấy trong tuần đầu tiên ở đây. Tôi sẽ huấn luyện anh ấy về kiến thức sản phẩm vào sáng nay, trước khi anh ấy quan sát công việc của nhân viên bán hàng cấp cao Danna Addy trong thời gian còn lại trong ngày.\"}]]}]]}"
                }
              }
            },
