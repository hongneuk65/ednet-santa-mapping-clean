          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello, Victor. This is Becky Underwood. I got your phone message asking me to teach a creative writing workshop at the library on August 8. I’d be delighted to run the class. I found it really rewarding when I did it last year. But I was wondering if there will be an overhead projector available in the library this time. I’d really like to use it to give a presentation to the attendees. Please get back to me at 555-7589. Talk to you soon.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, Victor. Tôi là Becky Underwood. Tôi nhận được tin nhắn của bạn yêu cầu tôi dạy một hội thảo viết sáng tạo tại thư viện vào ngày 8 tháng 8. Tôi sẽ rất vui khi được dạy cho lớp học. Tôi cảm thấy rất hạnh phúc khi đứng lớp vào năm ngoái. Nhưng tôi đang tự hỏi lần này liệu thư viện có máy chiếu trên cao hay không. Tôi thực sự muốn sử dụng nó để thuyết trình trước những người tham dự. Vui lòng liên hệ lại với tôi theo số 555-7589. Mong bạn sớm gọi lại.\"}]]}]]}"
                }
              }
            },
