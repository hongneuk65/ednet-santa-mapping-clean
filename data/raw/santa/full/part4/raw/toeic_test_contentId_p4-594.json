          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Mr. Landry. This is Robyn from Springtime Flower Shop. I got your message asking about our services and prices for an upcoming retirement party for your coworker. I’d recommend getting our Premium Package. This includes ten small centerpieces and two large arrangements for the entrance. That particular package is ten percent off this month, so it would be only three hundred ninety dollars. You mentioned that the venue is at your office in the Warren Building. Could you please call me back and let me know the parking situation there? That will affect the delivery plan. Thanks.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào ông Landry. Tôi là Robyn, người củatiệm hoa Springtime. Tôi nhận được tin nhắn của quý khách hỏi về dịch vụ và giá cả cho bữa tiệc nghỉ hưu sắp tới của đồng nghiệp. Tôi đề nghị ông nên mua gói Premium Package. Gói đặc biệt này bao gồm 10 bình hoa trang trí nhỏ ở trung tâm và 2 bình hoa lớn ở cửa ra vào. Gói đặc biệt này được giảm giá 10% trong tháng này, nên nó chỉ còn 390 đô la. Qúy khách cho biết địa điểm tổ chức là văn phòng của mình ở tòa nhà Warren. Qúy khách vui lòng gọi lại cho tôi để cho biết tình hình đỗ xe ở đó được không? Vì điều này sẽ ảnh hưởng đến kế hoạch giao hàng. Cảm ơn quý khách.\"}]]}]]}"
                }
              }
            },
