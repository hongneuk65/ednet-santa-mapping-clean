          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good afternoon. My name is William Cromwell and I’m the head developer at the Extrorun Sports Company. I’m here today to introduce our latest range of nutritional sports beverages to you all. We understand that modern sportsmen need a more efficient way to stay hydrated during their event. This new drink that we have developed helps to do just that. It contains a unique combination of vitamins that are crucial for keeping the body fit and healthy. Tests have proven that athletes who consume our product experience increased endurance levels when exercising. Now, I’d like to pass around some so you can sample them.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào buổi chiều. Tên tôi là William Cromwell và tôi là nhà phát triển chính tại Công ty Thể thao Extrorun.Tôi có mặt tại đây hôm nay để giới thiệu dòng đồ uống thể thao dinh dưỡng mới nhất của chúng tôi với tất cả các bạn. Chúng tôi hiểu rằng các vận động viên thể thao hiện đại cần một cách hiệu quả hơn để giữ đủ nước cho cơ thể trong suốt sự kiện của họ. Thức uống mới mà chúng tôi đã phát triển này giúp các bạn làm được điều đó. Nó là một sự kết hợp độc đáo giữa các loại vitamin quan trọng, giữ cho cơ thể cân đối và khỏe mạnh. Các thử nghiệm đã chứng minh rằng những vận động viên sử dụng sản phẩm của chúng tôi được tăng cường độ bền khi tập luyện. Bây giờ tôi sẽ đưa cho các bạn một số mẫu để dùng thử.\"}]]}]]}"
                }
              }
            },
