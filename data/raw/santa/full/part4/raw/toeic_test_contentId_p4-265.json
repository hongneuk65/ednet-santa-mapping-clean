          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello. This is Dora Pearson calling from McKinley Accounting. I ordered some party supplies from you for an awards banquet on the evening of September 15. I received the shipment yesterday, but I noticed that it didn’t contain all of the items I ordered. There weren’t any streamers in it. Because our event is just a few days away, I think it would be best to just cancel that part of the order. So, I’d like you to send me a refund for the item I didn’t get. Please call me back at 555-8790 to discuss this. Thanks.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào. Tên tôi là Dora Pearson đến từ McKinley Accounting. Tôi đã đặt đồ dùng tiệc mà mình cần từ công ty bạn cho bữa tiệc lễ trao giải vào tối ngày 15 tháng 09. Tôi đã nhận được hàng giao đến ngày hôm qua nhưng tôi nhận thấy rằng nó không đủ tất cả các sản phẩm mà tôi đã đặt. Trong đó không có băng dính màu. Vì sự kiện của chúng tôi sẽ diễn ra chỉ trong vài ngày nữa, nên tôi nghĩ tốt nhất là tôi sẽ hủy phần còn lại của đơn hàng. Do đó, tôi muốn được hoàn lại tiền cho những sản phẩm tôi không nhận được. Vui lòng gọi số 555-8790 để chúng ta có thể nói về vấn đề này. Xin cảm ơn.\"}]]}]]}"
                }
              }
            },
