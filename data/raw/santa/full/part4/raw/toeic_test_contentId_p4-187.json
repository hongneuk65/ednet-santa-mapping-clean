          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello, this is Ashley Greene. I was at a dance class last night at the fitness center, and I think I may have left my cell phone there in the changing room. The cell phone is in a white case and it has a decoration hanging from the corner. I would really appreciate it if someone could call me to let me know whether it has been found or not. My work telephone number is 555-9372. If you still have my phone there, I could pick it up at lunchtime. I’m collecting some clothes from the dry cleaner during my lunch break and it’s just around the corner from the fitness center.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, tôi là Ashley Greene. Tối qua tôi đã tham gia một lớp học khiêu vũ ở trung tâm thể dục và tôi nghĩ có thể tôi đã để quên điện thoại di động trong phòng thay đồ. Điện thoại di động của tôi có một cái ốp màu trắng và đồ trang trí treo bên góc điện thoại. Tôi thực sự sẽ rất biết ơn nếu ai đó có thể gọi cho tôi để tôi biết liệu nó đã được tìm thấy hay chưa. Số điện thoại cơ quan của tôi là 555-9372. Nếu điện thoại của tôi vẫn ở đó, tôi có thể lấy nó vào giờ ăn trưa. Tôi sẽ lấy quần áo từ tiệm giặt khô trong giờ nghỉ trưa và nó ở ngay gần trung tâm thể dục.\"}]]}]]}"
                }
              }
            },
