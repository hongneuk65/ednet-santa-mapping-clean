          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Kevin. This is Stephanie from Roast Coffee Shop. We were pleased with the Web site you created for us. I wanted to let you know that we’ve decided to sell some merchandise like mugs and coffee beans on the Web site, so there should be specific pages for those. We didn’t request those originally. So, I’m wondering if you can meet me at the shop to discuss this further. Because you’ve got the address, you’ll see that it’s far from any bus stops, so I suggest you drive here. Please call me back when you get the chance.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A:  Chào Kevin. Tôi là Stephanie ở Roast Coffee Shop. Chúng tôi rất hài lòng với trang web mà bạn đã tạo cho chúng tôi. Tôi gọi điện thoại để cho biết rằng chúng tôi đã quyết định bán các sản phẩm nhưly và cà phê nguyên hạt trên trang web, nên cần phải có các trang cụ thể dành cho những sản phẩm đó. Lúc đầu, chúng tôi đã không yêu cầu điều đó. Vì vậy, tôi muốn biết liệu bạn có thể gặp tôi tại cửa hàng để trao đổi cụ thể về vấn đề này hay không. Bạn đã có địa chỉ, nhưng bạn thấy đó, cửa hàng ở cách xa trạm xe buýt, nên tôi khuyên bạn lái xe đến đây. Vui lòng gọi lại cho tôi khi bạn có thời gian.\"}]]}]]}"
                }
              }
            },
