          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Kane? My name is Lorraine Mcgraw and I’m calling from Pulis Accountants. You installed some computer software onto our systems last week and, well, unfortunately it’s been a bit of a disaster. The number of viruses on our machines has risen quite rapidly since you installed the new software. Our computers are now unusable and we can’t get any work done. I want to chat about what you are going to do to fix this problem. Please call me back as soon as you get this message.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, Kane. Tôi là Lorraine Mcgraw và tôi đang gọi từ Công ty Kế toán Pulis. Tuần trước, bạn đã cài đặt một số phần mềm máy tính vào hệ thống của chúng tôi và rất tiếc là đã có một vấn đề. Số lượng vi-rút trên máy đã tăng lên khá nhanh kể từ khi bạn cài đặt phần mềm mới. Máy tính của chúng tôi hiện không sử dụng được và chúng tôi không thể hoàn thành bất kỳ công việc nào. Tôi muốn trao đổi với bạn về cách giải quyết vấn đề này. Vui lòng gọi lại cho tôi ngay sau khi bạn nhận được tin nhắn.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nữ người Anh\"}]]}]]}"
                }
