          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Welcome to the San Francisco-Tiburon Ferry Harbor. We will experience a delay in ferry service to the city today due to high winds. Because the National Weather Service has issued a high wind advisory for the entire San Francisco Bay area, we must postpone the departure of the 8 A.M. ferry. There is no estimated time for this delay, as the weather service has issued the advisory until further notice. We sincerely apologize for this delay. We are coordinating with city transportation officials to attempt to arrange for alternative over-land transportation. We will notify you immediately when arrangements are confirmed for our passengers.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào mừng đến với Bến Phà San Francisco-Tiburon. Do có gió mạnh nên dịch vụ phà đến thành phố sẽ bị trì hoãn. Vì Cục Khí tượng đã đưa ra cảnh báo về gió lớn cho toàn bộ khu vực Vịnh San Francisco, chúng tôi buộc phải hoãn chuyến phà khởi hành lúc 8 giờ sáng. Cục Khí tượng đã khuyến cáo nên chúng tôi cũng khó có thể nói sự chậm trễ này sẽ kéo dài bao lâu cho đến khi có thông báo mới. Chúng tôi thành thật xin lỗi vì sự chậm trễ này. Chúng tôi đang phối hợp với các cơ quan chức năng giao thông vận tải thành phố để cố gắng thu xếp phương tiện di chuyển đường bộ thay thế. Chúng tôi sẽ thông báo cho các hành khách ngay khi các phương tiện đã sẵn sàng.\"}]]}]]}"
                }
              }
            },
