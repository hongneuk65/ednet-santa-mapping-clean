          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good morning, listeners. I’m Lynne Simpson and I’m your host for Shooting Stars, your daily entertainment news update. This Sunday from 7 P.M. to 10 P.M., the National Television Awards will take place at Gerhard Concert Hall in Ingot City. There will be 15 categories, and stars from all over the country are expected to attend. The event will also showcase the trailers of many upcoming films. As in previous years, winners in each category will receive a statue made out of solid bronze, and will give a brief speech to the audience.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào buổi sáng, quý thính giả. Tôi là Lynne Simpson, người dẫn chương trình cho Shooting Stars, chương trình cập nhật tin tức giải trí hàng ngày dành cho bạn. Chủ nhật tuần này từ 7 giờ đến 10 giờ tối, National Television Awards sẽ diễn ra tại Gerhard Concert Hall ở Thành phố Ingot. Sẽ có 15 hạng mục với các ngôi sao từ khắp mọi miền đất nước tham dự. Sự kiện cũng sẽ giới thiệu và quảng bá cho nhiều bộ phim sắp ra mắt. Như những năm trước, người chiến thắng ở mỗi hạng mục sẽ nhận được một bức tượng được bằng đồng nguyên khối và sẽ có một bài phát biểu ngắn trước khán giả.\"}]]}]]}"
                }
              }
            },
