          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good afternoon, listeners. This is your host, Duane Johnson. It's 6 o'clock, and you know what that means. It's now time for QJT.1's trivia game show. Get ready to call the station because today we will be giving away a pair of tickets to the Paul Vin Trio's concert on Friday night. Here's how to play. I'll give you five trivia questions, and if you know all the correct answers, call the station. The first person to get through and to answer all five correctly will win the tickets. Now, let's start.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào các quý thính giả. Tôi là người dẫn chương trình Duane Johnson. Bây giờ là 6 giờ và bạn biết điều đó có nghĩa là gì rồi đấy. Đã đến giờ chơi đố vui của QJT.1. Hãy sẵn sàng gọi đến đài truyền hình vì hôm nay chúng tôi sẽ tặng ngay một cặp vé xem buổi hòa nhạc của Paul Vin Trio vào tối thứ 6. Đây là cách chơi. Tôi sẽ cung cấp cho bạn năm câu hỏi. Nếu bạn trả lời chính xác các câu hỏi, vui lòng gọi ngay cho đài truyền hình. Người đầu tiên trả lời đúng cả năm câu sẽ giành được vé. Bây giờ, chúng ta hãy bắt đầu nào.\"}]]}]]}"
                }
              }
            },
