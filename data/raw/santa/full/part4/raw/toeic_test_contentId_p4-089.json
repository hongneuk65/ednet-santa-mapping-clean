              "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
              "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Questions 1-3 refer to the following introduction.\"}]]}]]}"
