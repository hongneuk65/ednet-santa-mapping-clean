          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Amber. It’s Ramone. I’m calling all of the team leaders in the customer service department to let them know about an issue we had with some online orders. Due to a system error, quite a few orders were canceled automatically. Fortunately, the issue has been fixed. I’ve put up a notice on our Web site explaining the issue and apologizing for any inconvenience. Your staff should know that we’re offering compensation to all customers who were affected by this issue. They’ll receive a coupon for fifteen percent off a future purchase.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A:  Chào Amber. Tôi là Ramone. Tôi đang gọi cho tất cả các giám đốc của bộ phận dịch vụ khách hàng để thông báo về vấn đề mà chúng ta gặp phải đối với một số đơn đặt hàng qua mạng. Do lỗi hệ thống, nên một số đơn đặt hàng đã tự động bị hủy. May mắn thay, vấn đề đó đã được giải quyết. Tôi đã đăng một thông báo trên trang web của chúng ta để giải thích về sự cố và xin lỗi vì sự bất tiện này. Nhân viên của bạn nên biết rằng chúng ta sẽ bồi thường cho tất cả các khách hàng bị ảnh hưởng bởi sự cố này. Họ sẽ được nhận một phiếu giảm giá 15% cho lần mua hàng sau.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nam người Mỹ\"}]]}]]}"
                }
              }
            },
