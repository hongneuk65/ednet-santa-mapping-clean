          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: I’m pleased to tell you all about an exciting change at our restaurant. Just a few days ago, we finalized the contract with our new partner, Easy-Eats, a delivery service provider. From tomorrow, customers will be able to order food online and have it delivered to their home. When you’re preparing these orders, be sure to pack the food in our take-out containers carefully. We don’t want any spills while the order is in transit. That’s because we want the food to arrive in perfect condition for our customers.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Tôi rất vui được kể cho mọi người về thay đổi thú vị trong nhà hàng của chúng ta. Cách đây vài ngày, chúng ta đã chốt hợp đồng với đối tác mới, nhà cung cấp dịch vụ giao hàng Easy-Eats. Bắt đầu từ ngày mai, khách hàng sẽ có thể đặt đồ ăn trực tuyến được giao tới tận nhà. Khi chuẩn bị các đơn hàng này, hãy đảm bảo đóng gói thức ăn một cách cẩn thận trong các hộp đựng mang đi. Không được để thức ăn bị tràn ra dù chỉ một chút trong khi giao thức ăn. Bởi vì thức ăn phải được giao đến cho khách hàng trong tình trạng hoàn hảo.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nam người Mỹ\"}]]}]]}"
                }
              }
            },
