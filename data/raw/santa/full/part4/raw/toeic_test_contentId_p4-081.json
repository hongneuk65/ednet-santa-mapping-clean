          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good evening. Welcome to Lacy Bistro. My name is Russell, and I'll be your server this evening. First, I'd like to tell you that starting today, we are offering a new range of delicious appetizers that use only healthy local produce. We really want to support local farmers. We’re also interested in hearing what our customers think about these new dishes, so we'd like you to leave a comment on our Web site when you get home tonight. If you leave a comment online, you'll receive a coupon for 10% off that you can use when you visit the next time.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào. Chào mừng đến với Lacy Bistro. Tên tôi là Russell và tôi sẽ là người phục vụ quý khách tối nay. Đầu tiên, tôi muốn nói với quý khách rằng bắt đầu từ hôm nay, chúng tôi sẽ cung cấp một loạt các món khai vị ngon miệng và mới mẻ chỉ sử dụng các nguyên liệu trong vùng và rất tốt cho sức khỏe. Chúng tôi thực sự muốn hỗ trợ nông dân địa phương. Chúng tôi cũng muốn biết khách hàng nghĩ gì về những món ăn mới này, vì vậy mong quý khách để lại nhận xét trên trang web của chúng tôi khi về nhà vào tối nay. Nếu lại bình luận trên trang web, quý khách sẽ nhận được một phiếu giảm giá 10% có thể sử dụng ở lần tiếp theo.\"}]]}]]}"
                }
              }
            },
