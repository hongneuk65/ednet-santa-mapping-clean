          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: May I have your attention, please, for a quick announcement? I hope you are all enjoying the Cottonwood Summer Festival. Don’t forget that the cooking competition, one of the festival’s most popular events, begins at two o’clock. The winners will receive a variety of prizes. You can find a list of them posted near the main stage. Also, we’re still looking for a few more volunteers to judge the event. If you do so, you’ll get a free festival T-shirt. Please speak to Janice at the information booth for more information.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A:  Xin vui lòng chú ý cho một thông báo ngắn. Tôi hy vọng tất cả mọi người đang tận hưởng lễ hội mùa hè Cottonwood. Đừng quên cuộc thi ẩm thực, một trong những sự kiện được nhiều người yêu thích nhất của lễ hội, sẽ bắt đầu vào lúc 2 giờ. Những người chiến thắng sẽ nhận được nhiều giải thưởng khác nhau. Bạn có thể xem danh sách các giải thưởng được đăng gần sân khấu chính.Ngoài ra, chúng tôi vẫn đang tuyển một số ứng viên để đánh giá các bài thi. Nếulàm điều đó, bạn sẽ nhận được một chiếc áo thun lễ hội miễn phí. Xin vui lòng liên hệ với Janice tại quầy thông tin để biết thêm thông tin chi tiết.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
