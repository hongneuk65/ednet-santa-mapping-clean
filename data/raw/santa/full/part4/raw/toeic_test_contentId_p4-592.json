          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: You’re listening to E-World on KRRT Radio. Our guest today is Patrick Trevino, designer of the world-famous video game Star Racer. He’s here to share the exciting news that the game is ready to be exported abroad to China next month. To commemorate this special achievement, the company is giving all current players a gift bag of Star Racer promotional items. In addition, new players can try the game for free for two weeks. Mr. Trevino wants to connect with fans, so please send your questions by text message to the station using the number on our Web site.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Các bạn đang nghe E-World của Đài KRRT. Khách mời hôm nay là Patrick Trevino, nhà thiết kế của trò chơi điện tử nổi tiếng thế giới Star Racer. Ông ấy đến đây để cho biết một tin thú vị rằng trò chơi này đã sẵn sàng để xuất khẩu sang Trung Quốc vào tháng tới. Để kỷ niệm thành tích đặc biệt này, công ty sẽ dành tặng cho tất cả những người chơi hiện đang tham gia một túi quà tặng có chứa các vật phẩm khuyến mãi cho Star Racer. Ngoài ra, người chơi mới có thể sử dụng trò chơi miễn phí trong hai tuần. Ông Trevino muốn giao lưu với người hâm mộ của mình, vì vậy hãy gửi câu hỏi của bạn đến đài bằng tin nhắn qua số điện thoại trên trang web của chúng tôi.\"}]]}]]}"
                }
              }
            },
