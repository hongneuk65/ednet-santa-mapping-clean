          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Before we open the store today, I just want to remind you that next week is our clearance sale on all jackets, sweaters, and winter accessories. We’ll be marking the tags with colored stickers—blue for twenty percent off, green for thirty percent off, and red for fifty percent off. Be sure to make sure the discount is applied at the time of purchase. Just a reminder, usually we do not accept returns on clearance items. However, there is one exception. If the item is damaged, it can be returned for a full refund.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A:  Trước khi mở cửa cửa hàng ngày hôm nay, tôi muốn thông báo với mọi người rằng sẽ có đợt giảm giá cho tất cả áo khoác, áo len và phụ kiện mùa đôngvào tuần tới. Chúng ta sẽ đánh dấu vào tem giá bằng nhãn màu — màu xanh dương cho giảm giá 20%, màu xanh lá cây cho giảm giá 30% và màu đỏ cho giảm giá 50%. Mọi người vui lòng xác nhận việc giảm giá được áp dụng tại thời điểm mua hàng. Xin nhắc lại, chúng ta thường không chấp nhận trả hàng đối với các mặt hàng bán giảm giá để xứ lý tồn kho. Tuy nhiên, có một ngoại lệ. Nếu hàng bị hư hỏng, nó có thể được hoàn lại toàn bộ số tiền.\"}]]}]]}"
                }
              }
            },
