          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello, Mr. Peterson. This is Rebecca Kim from Office App. I’m calling because you mentioned previously that you are in the market for some new computer software for your office. I’ll be in town later this week, and, if you’d like, I could come by your office and show you our new line of software. You’ll be happy to know that there is currently a sale on all of our new products if you order within the next two months. Please call me back at 577-9268 when you get the chance. Thank you.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, ông Peterson. Tôi là Rebecca Kim từ Office App. Tôi gọi đến vì trước đó ông đã đề cập tới việc mua phần mềm máy tính mới cho văn phòng của mình. Tôi sẽ đến trung tâm thành phố vào cuối tuần này và nếu ông muốn, tôi có thể đến văn phòng của ông và cho ông xem dòng phần mềm mới của chúng tôi. Ông sẽ rất vui khi biết rằng tất cả các sản phẩm mới của chúng tôi hiện đang có chương trình giảm giá nếu đặt hàng trong vòng hai tháng tới. Vui lòng gọi lại cho tôi theo số 577-9268 khi ông có thời gian. Xin cảm ơn.\"}]]}]]}"
                }
              }
            },
