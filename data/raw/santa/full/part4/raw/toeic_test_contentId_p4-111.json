          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Theresa. This is Jim Vernon calling. I’d like you to know that the preparations for this Saturday’s seminar are going well. It looks as though we’re going to have more than 120 people in attendance. That will be twice as many people as we had for the previous seminar. I just wanted to let you know that there’s going to be one change in the program. Mary Worthy can’t make it because of a family issue. So I called up Travis Parker, and he has agreed to serve as her replacement. Okay, I’ll talk to you later. Bye.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, Theresa. Tôi là Jim Vernon đây. Tôi muốn thông báo đến cô rằng công việc chuẩn bị cho buổi hội thảo vào thứ Bảy này đang diễn ra suôn sẻ. Có vẻ như chúng ta sẽ có hơn 120 người tham dự. Số lượng người sẽ nhiều gấp đôi so với buổi hội thảo lần trước. Tôi chỉ muốn cho cô biết rằng sẽ có một sự thay đổi trong chương trình. Mary Worthy không thể tham gia vì lý do gia đình. Vì vậy, tôi đã gọi cho Travis Parker, anh ấy đã đồng ý làm người phát biểu thay. Được rồi, tôi sẽ nói chuyện với cô sau. Tạm biệt.\"}]]}]]}"
                }
              }
            },
