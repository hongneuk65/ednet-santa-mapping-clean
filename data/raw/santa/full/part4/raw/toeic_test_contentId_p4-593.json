              "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Questions 1-3 refer to the following announcement.\"}]]}]]}"
            }
          },
          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: I have a brief announcement, everyone. This weekend, we will be removing the old chairs and desks and putting in new ones instead. To help the transition go smoothly, we ask that you pack your personal items into the boxes we will provide. Please do this on Friday afternoon before you leave work. You should make sure that the outside of the box is clearly labeled in order to avoid confusion. You will be assigned new workstations on Monday. Please direct any questions you may have to Mr. O’Connor in the general affairs department. Thanks.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Mọi người, tôi xin gửi một thông báo ngắn gọn. Cuối tuần này, chúng ta sẽ loại bỏ ghế và bàn làm việc cũ và thay mới chúng. Để việc thay đổi diễn ra suôn sẻ, tôi yêu cầu mọi người đóng gói các vật dụng cá nhân của mình vào các thùng được phát. Vui lòng làm việc này trước khi tan làm vào chiều thứ sáu. Để tránh nhầm lẫn, hãy chắc chắn dán nhãn vào bên ngoài thùng. Chỗ ngồi mới sẽ được chỉ định vào thứ hai. Nếu có bất kỳ thắc mắc nào, vui lòng liên hệ với ông O’Connor của phòng hành chính. Cảm ơn mọi người.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nữ người Mỹ\"}]]}]]}"
                }
              }
            },
