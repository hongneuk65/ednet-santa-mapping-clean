          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello, Mr. Longman. This is Ann Casper calling from Casper Property. I’m calling to ask if you’d like to see a lakeside cottage that just became available. This sounds like the kind of place you were looking for. It’s bigger than any other cottages, and it has one more bedroom than the one you agreed to rent last week. It would be perfect for you and your family this summer. I'm available to give you a tour of the cottage any time during the week or after 1 P.M. on Saturday. Please get back to me at 555-9287 and let me know what time would suit you best for a quick tour. Thank you again.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, anh Longman. Tôi là Ann Casper từ Casper Property. Tôi gọi đến để hỏi xem anh có muốn xem một ngôi nhà nhỏ ven hồ vừa mới mở bán không. Có vẻ như anh đang tìm kiếm một địa điểm như vậy. Nó lớn hơn các ngôi nhà khác và có nhiều phòng ngủ hơn căn mà anh đã đồng ý thuê vào tuần trước. Nó là nơi hoàn hảo cho anh và gia đình của anh trong mùa hè này. Tôi sẵn sàng dẫn anh đi tham quan nhà bất kỳ lúc nào vào các ngày trong tuần hoặc vào thứ Bảy sau 1 giờ chiều. Vui lòng liên hệ lại với tôi theo số 555-9287 và cho tôi biết thời gian phù hợp nhất để đưa anh đi tham quan nhanh chóng. Một lần nữa xin cảm ơn anh.\"}]]}]]}"
                }
              }
            },
