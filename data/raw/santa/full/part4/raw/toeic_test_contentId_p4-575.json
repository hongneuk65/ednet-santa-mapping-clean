          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello, Ms. Schubert? This is Kevin from Silver Dish Catering. I just wanted to confirm your order for your upcoming employee retreat. I see from our records that you ordered twenty-eight meals. Actually, if you order two more meals, you’ll be eligible for our bulk discount. That would mean your entire order with the extra meals would be cheaper than the original order. However, there are fewer options for discounted meals. So, I suggest that you look at the photos of the meal choices on our Web site before making a decision. Thanks.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, cô Schubert phải không ạ? Tôi là Kevin của Silver Dish Catering. Tôi muốn xác nhận đơn đặt hàng cho chuyến đi chơi sắp tới của nhân viên quý công ty. Theo ghi nhận của chúng tôi, bên cô đã đặt bữa ăn cho 28 người. Thực ra nếu đặt thêm 2 phần nữa, bên cô sẽ đủ điều kiện nhận giảm giá do mua hàng số lượng lớn. Điều này có nghĩa là tổng số tiền của toàn bộ đơn hàng bao gồm cả phần ăn bổ sung sẽ rẻ hơn đơn đặt hàng ban đầu. Tuy nhiên, lựa chọn dành cho đồ ăn giảm giá lại ít hơn. Vì vậy, trước khi đưa ra quyết định, chúng tôi khuyến khích khách hàng tham khảo hình ảnh các món ăn có thể lựa chọn trên trang web của mình. Xin cảm ơn.\"}]]}]]}"
                }
              }
            },
