          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good afternoon, everyone. July’s promotion begins tomorrow and I wanted to make sure that you are all ready for this event. As you know, for the next month we will be offering a special Chicken Supremo Burger. Customers can order this as part of a meal deal with french fries and a soft drink, or just as a single burger. The only thing we have left to do is put up posters at the front of the store and at the drive-thru window. Can I have a few volunteers to help do this?\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào tất cả mọi người. Chương trình khuyến mãi của tháng 7 sẽ bắt đầu vào ngày mai và tôi muốn đảm bảo rằng tất cả các bạn đã sẵn sàng cho sự kiện này. Như bạn đã biết, trong tháng tới, chúng ta sẽ có món bánh mì kẹp thịt gà Supremo đặc biệt. Khách hàng có thể gọi món này kèm với khoai tây chiên và nước ngọt, hoặc chỉ gọi một chiếc bánh mì kẹp thịt. Điều duy nhất chúng ta cần làm là dán áp phích ở phía trước cửa hàng và ở cửa sổ lái xe. Có ai xung phong làm công việc này không?\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nam người Mỹ\"}]]}]]}"
                }
              }
            },
