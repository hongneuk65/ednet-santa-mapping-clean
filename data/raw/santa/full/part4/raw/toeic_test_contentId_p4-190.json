          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: I would like to welcome everyone to today’s product demonstration. I’m Bill Bronson, a sales representative for Clean It All. I’m very excited to be with you today to talk about our new product, Yellow Clean. This product is an amazing new invention that uses the power of lemons. It not only cleans everything in your house, but also leaves a natural lemon scent for at least one week afterward. We have a special offer for those who act now. If you buy one bottle of Yellow Clean, you get an additional bottle free of charge! If you are in any way unhappy with our product, we will issue a full refund to you. No questions asked. Please place an order today.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào mừng mọi người đến với buổi giới thiệu sản phẩm ngày hôm nay. Tôi là Bill Bronson, đại diện bán hàng của Clean It All. Tôi rất vui mừng được ở đây hôm nay và nói về về sản phẩm mới của chúng tôi, Yellow Clean. Sản phẩm này là một phát minh mới tuyệt vời sử dụng sức mạnh của trái chanh. Nó không chỉ làm sạch mọi thứ trong nhà của bạn mà còn lưu lại hương chanh tự nhiên trong ít nhất một tuần sau đó. Chúng tôi có một khuyến mãi đặc biệt cho những người đặt mua ngay bây giờ. Nếu bạn mua một chai Yellow Clean, bạn sẽ được tặng thêm một chai miễn phí! Nếu bạn không hài lòng với sản phẩm của chúng tôi theo bất kỳ cách nào, chúng tôi sẽ hoàn tiền lại đầy đủ cho bạn. Không hỏi gì thêm. Hãy đặt hàng ngay hôm nay.\"}]]}]]}"
                }
              }
            },
