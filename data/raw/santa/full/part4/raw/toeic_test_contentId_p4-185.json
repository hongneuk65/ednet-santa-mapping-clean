          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Merry Christmas, shoppers! With only five days left until Christmas, we know that many of you are here to pick up a turkey for Christmas dinner. That’s why, for this week only, we’ll give you a free cheesecake when you purchase one of our turkeys. Also, if you are buying a large amount of groceries today, don’t forget that, for a small charge, you can take advantage of our home delivery service. But you better hurry up and bring your items to the checkout, as we are closing in 15 minutes. Have a happy holiday!\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chúc các quý khách có một Giáng sinh an lành! Chỉ còn năm ngày nữa là đến Giáng sinh, chúng tôi biết rằng nhiều người trong số các bạn đang ở đây để chọn một con gà tây cho bữa tối Giáng sinh. Đó là lý do tại sao, chỉ trong tuần này, chúng tôi sẽ tặng bạn bánh pho mát miễn phí khi bạn mua gà tây của chúng tôi. Ngoài ra, nếu bạn mua một số lượng lớn hàng tạp hóa hôm nay thì đừng quên rằng chỉ với một khoản phí nhỏ, bạn có thể sử dụng dịch vụ giao hàng tận nhà của chúng tôi. Nhưng tốt hơn hết bạn nên nhanh chóng mang đồ của mình đến quầy thanh toán, vì chúng tôi sẽ đóng cửa sau 15 phút nữa. Chúc các bạn có một kỳ nghỉ vui vẻ!\"}]]}]]}"
                }
              }
