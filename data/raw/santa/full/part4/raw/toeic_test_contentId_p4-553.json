          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello, this is Lynn Castillo. I ordered some tiles for my new bathroom yesterday, but I’ve changed my mind. Instead of the plastic ones I ordered, I’d like to buy the ceramic ones. They should still be in the sky-blue color. I think ceramic would fit a lot better with the design of the rest of my house. I would appreciate it if you could change my order. Also, I need to stop by in person to look at some blinds. However, I couldn’t find your business hours on your Web site. Could you please call me back and let me know about that? Thanks!\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào. Tôi là Lynn Castillo. Hôm qua, tôi có đặt một số gạch lát cho phòng tắm, nhưng tôi đã đổi ý. Tôi muốn mua gạch men thay vì gạch nhựa mà tôi đã đặt hàng. Màu thì vẫn nên là màu xanh da trời. Tôi nghĩ rằng gạch men sẽ hài hòa hơn nhiều với thiết kế của phần còn lại trongngôi nhà. Tôi thực sự cám ơn nếu bạn có thể thay đổi đơn đặt hàng của tôi.Ngoài ra, tôi cũng sẽ trực tiếp ghé qua để xem một số rèm. Tuy nhiên, tôi không thể tìm thấy giờ mở cửa của cửa hàng trên trang web. Bạn có thể vui lòng gọi lại và cho tôi biết được không? Cám ơn bạn!\"}]]}]]}"
                }
              }
            },
