          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Diana. It’s Marco. I’m wondering if you could help me out. As you know, I’ve been making my own metalwork crafts for decorations lately. Well, I just got a call from a business that manufactures home furnishings. They want to order some goods with an exclusive contract. It would be great for my business, but ... um ... I’ve never done this before. Could you recommend a law firm that could help me with the contract negotiations? I want to make sure that I don’t make a mistake. Thanks a lot.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào, Diana. Tôi là Marco. Tôi băn khoăn liệu cô có thể giúp tôi. Nhưcô đã biết, gần đây tôi đang tự làm đồ trang trí thủ công bằng kim loại. Ưm, tôi vừa nhận được một cuộc điện thoại từ một công ty sản xuất đồ nội thất gia đình. Họ muốn đặt hàng một số sản phẩm bằng một hợp đồng độc quyền. Việc này rất tốt cho công việc kinh doanh của tôi, nhưng … ưm, vì tôi chưa bao giờ làm việc này trước đây. Cô có thể giới thiệu một công ty luật giúp tôi đàm phán hợp đồng được không? Tôi không muốn mắc sai lầm. Cám ơn cô rất nhiều.\"}]]}]]}"
                }
              }
            },
