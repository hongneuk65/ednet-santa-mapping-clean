          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good morning, and welcome to the Riley Hotel. My name is Becky Kim. I'm the manager of the hotel. We're glad you've joined our front desk service staff. In a moment, you will begin your training. We need to have everyone prepared for the hotel’s grand opening in two weeks. We are already fully booked for our opening night. Management has decided to offer a special deal for our guests that check in on the first night. They will each receive a special meal voucher that can be redeemed at our second-floor restaurant. So I need to explain the details of this voucher to you during the session today.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào buổi sáng và chào mừng đến với khách sạn Riley. Tên tôi là Becky Kim. Tôi là quản lý của khách sạn. Rất vui được chào đón các bạn gia nhập đội ngũ nhân viên lễ tân của chúng tôi. Một lúc nữa, các bạn sẽ bắt đầu khóa đào tạo của mình. Chúng tôi cần tất cả mọi người chuẩn bị cho buổi khai trương của khách sạn sau hai tuần nữa. Các phòng đã được đặt kín trong đêm khai trương. Ban quản lý đã quyết định sẽ cung cấp một ưu đãi đặc biệt cho những vị khách nhận phòng vào đêm đầu tiên. Mỗi người sẽ nhận được một phiếu ăn uống đặc biệt có thể đổi được tại nhà hàng trên tầng hai. Vì vậy, tôi cần giải thích chi tiết về phiếu ăn uống này cho các bạn trong buổi đào tạo ngày hôm nay.\"}]]}]]}"
                }
              }
            },
