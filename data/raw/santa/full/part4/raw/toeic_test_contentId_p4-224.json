          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello, Mr. Stanton. This is Rachel calling from Drydale Health Clinic. You called yesterday inquiring about vaccinations you will need before going on your trip to Africa. One that you will definitely need is malaria. There are quite a few other ones that are recommended as well. It’s a simple injection that would be performed either by me or one of the other nurses here. If you would like to call me back, I can set up an appointment for you sometime this week.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, ông Stanton. Tôi là Rachel gọi từ Phòng khám sức khỏe Drydale. Ông đã gọi điện vào ngày hôm qua để hỏi về các loại vắc-xin ông cần tiêm trước khi lên đường đến Châu Phi. Một loại mà ông chắc chắn sẽ cần là vắc-xin sốt rét. Có khá nhiều loại khác cũng được khuyến nghị. Đây sẽ là một mũi tiêm đơn giản sẽ được thực hiện bởi tôi hoặc một trong những y tá khác ở đây. Nếu ông gọi lại cho tôi, tôi có thể sắp xếp một cuộc hẹn cho ông vào một buổi trong tuần này.\"}]]}]]}"
                }
              }
            },
