          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello, this message is for Eric Santana. This is Leslie calling from Renwick Programming. I appreciate your coming to our office for the interview last week. I wanted to let you know that we’ve decided to hire another candidate for the position instead. However, we were impressed with your education and work experience. We’ll be expanding the size of our R&D department soon, probably sometime next month. So, if you’d like, I can keep your application on file so that you can be considered for one of those positions as well. If you’re interested, please call me back at 555-3114 to let me know. Thank you.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A:  Xin chào. Đây là tin nhắn dành cho Eric Santana. Tôi là Leslie từ Renwick Programming. Cám ơn bạn đã đến văn phòng của chúng tôi để phỏng vấn vào tuần trước. Chúng tôi muốn thông báo với bạn rằng chúng tôi đã quyết định tuyển một ứng viên khác cho vị trí đó. Tuy nhiên, chúng tôi rất ấn tượng với nền tảng giáo dục và kinh nghiệm làm việc của bạn. Chúng tôi sắp mở rộng quy mô bộ phận nghiên cứu và phát triển, có lẽ là vào tháng tới. Vì vậy, nếu bạn muốn, tôi có thể lưu giữ đơn xin việc của bạn trong hồ sơ để bạn cũng có thể được xem xét cho một trong những vị trí đó. Nếu quan tâm, vui lòng gọi cho tôi biết theo số điện thoại 555-3114. Cám ơn bạn.\"}]]}]]}"
                }
              }
            },
