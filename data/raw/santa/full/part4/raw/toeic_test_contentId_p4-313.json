          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Attention all passengers. If you are waiting to board the 12:15 P.M. bus from Chicago to Detroit, please be aware that the boarding gate has been changed from boarding gate 4 to boarding gate 7. Before boarding the bus, make sure that you have your bus ticket ready to show the driver. Please give your large pieces of luggage to the driver to store in the luggage compartment of the bus. Small bags can be kept in the racks above your seats. For the duration of your journey, please keep your seatbelt buckled for your own safety.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Tất cả hành khách chú ý. Nếu bạn đang chờ đợi để lên chuyến xe buýt từ Chicago đến Detroit lúc 12:15 chiều, xin lưu ý rằng cổng lên xe đã được thay đổi từ cổng 4 sang cổng 7. Trước khi lên xe buýt, hãy đảm bảo rằng bạn đã chuẩn bị sẵn vé xe buýt để đưa cho tài xế. Vui lòng đưa hành lý lớn của mình cho tài xế để cất vào khoang hành lý của xe buýt. Các túi nhỏ có thể để vào giá đỡ phía trên chỗ ngồi của bạn. Trong suốt hành trình, vui lòng thắt dây an toàn để đảm bảo an toàn cho chính bạn.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nam người Úc\"}]]}]]}"
                }
              }
            },
