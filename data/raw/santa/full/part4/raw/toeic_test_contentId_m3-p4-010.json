          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good morning, Sandy. This is Jack. In light of the recent complaint from DK Electronics, I’ve re-drawn some of the plans for their new office in Glendale. I’d like to review them with you so we can make sure we are still within our budget. I have a few openings in my schedule today. There’s some time after the quarterly review meeting this afternoon, and I believe you’ll be in attendance, too. We could get together briefly after that meeting. I do need to leave at 4 for an inspection, though. Please let me know before lunch.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào buổi sáng, Sandy. Tôi là Jack. Sau khi xem xét các khiếu nại gần đây của công ty DK Electronics, tôi đã vẽ lại một số bản thiết kế cho văn phòng mới của công ty đó tại Glendale. Tôi muốn cùng cô xem xét bản thiết kế này để có thể làm rõ xem liệu chúng ta vẫn còn trong phạm vi ngân sách hay không. Tôi có một vài thời gian trống trong lịch trình hôm nay. Chiều nay tôi có chút thời gian sau cuộc họp đánh giá hàng quý, và tôi nghĩ cô cũng sẽ tham dự cuộc họp này. Sau khi kết thúc cuộc họp này chúng ta có thể gặp nhau một chút. Nhưng tôi phải rời văn phòng lúc 4 giờ cho buổi kiểm tra. Hãy báo cho tôi biết trước giờ ăn trưa nhé.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
