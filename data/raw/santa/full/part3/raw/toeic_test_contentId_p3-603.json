          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, this is Ted calling from maintenance. I got your message reporting an issue with your heating system.\\nB: Thanks for calling me back. When I got to my office this morning, I noticed that the radiator was not warm at all.\\nA: Other people are having the same problem. Because of the severe cold last night, some water pipes froze and burst. So you can stay warm, I can bring you a heater that you can just plug in. I’ll also bring an extension cord so you can place it anywhere you want.\\nB: I’d appreciate that.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào cô. Tôi là Ted ở đội bảo trì. Tôi nhận được tin nhắn thông báo về sự cố của hệ thống sưởi\\nB: Cám ơn anh đã gọi lại. Sáng nay, khi tôi đến văn phòng thì thấy bộ phận tỏa nhiệt không ấm chút nào\\nA: Những người khác cũng đang gặp vấn đề tương tự. Bởi vì một số đường ống nước đã bị đông cứng và vỡ ra do trời lạnh dữ dội đêm qua. Tôi sẽ mang cho cô một cái máy sưởi để cô có thể giữ ấm, cô chỉ cần cắm phích điện vào là được. Tôi cũng sẽ mang theo dây nối để cô có thể đặt máy sưởi ở bất kỳ chỗ nào cô muốn.\\nB: Nếu được vậy thì tôi rất cám ơn anh.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
