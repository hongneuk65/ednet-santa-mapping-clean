          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Welcome to Coburn Financial, Mr. Larsen.\\nB: Thanks, Ms. Brandt. I’m happy to be here.\\nA: We’re so glad that you’ve joined our team. With your educational background and experience working with high-income clients, you’ll be a great asset.\\nB: That’s very kind of you to say.\\nA: Let me introduce you to Madeline. She’ll help you get settled in.\\nC: Nice to meet you. I’ll get your laptop and printer set up so you can start going over the accounts you’ll be handling. We’ll also go over the details of your first project soon. How about meeting tomorrow for that?\\nA: That works for me.\\nB: Sounds great.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào mừng anh Larsen đến với Coburn Financial.\\nB: Cám ơn cô, Brandt. Tôi rất vui vì được tới đây.\\nA: Chúng tôi rất vui vì anh đã tham gia vào nhóm của chúng tôi. Với trình độ học vấn và kinh nghiệm làm việc với những khách hàng có thu nhập cao, anh sẽ là một tài sản lớn.\\nB: Cám ơn cô đã nói như vậy.\\nA: Tôi sẽ giới thiệu Madeline với anh. Cô ấy sẽ giúp anh thích nghi.\\nC: Rất vui được gặp anh. Tôi sẽ cài đặt máy tính xách tay và máy in để anh có thể bắt đầu xem xét các tài khoản sẽ xử lý. Chúng tôi dự định sẽ kiểm tra nội dung chi tiết dự án đầu tiên của anh. Ngày mai chúng ta sẽ gặp nhau để làm việc đó nhé?\\nA: Tôi đồng ý.\\nB: Tốt lắm.\"}]]}]]}"
                }
              }
            },
