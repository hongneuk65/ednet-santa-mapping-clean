          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello, we’re here from the city’s Health Department.\\nB: We’ll be carrying out the annual inspection of your plant’s food production processes.\\nC: I’m happy to take you to any section you need to see.\\nA: Great. Since you received excellent scores last time, the inspection should go smoothly.\\nB: Yes, but the process will be much longer than the last few times because of an added step. We’ve got to monitor the air quality inside and outside the factory.\\nC: Hmm ... well, I hope we don’t have to lose any working time.\\nB: Don’t worry. You’ll be able to operate as usual throughout the inspection.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào anh. Chúng tôi đến từ Sở y tế thành phố.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Chúng tôi sẽ tiến hành kiểm tra thường niên về quy trình sản xuất thực phẩm của nhà máy này.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"C: Tôi sẵn lòng hướng dẫn các cô đến tất cả các khu vực cần kiểm tra.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Tuyệt quá. Lần trước anh đã đạt điểm xuất sắc, nên việc kiểm tra sẽ được tiến hành suôn sẻ.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Đúng vậy, nhưng lần này quá trình kiểm tra sẽ lâu hơn nhiều so với các lần trước vì có thêm một bước. Chúng tôi cần giám sát chất lượng không khí bên trong và bên ngoài nhà máy.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"C: Ưm … nhưng, chúng tôi hy vọng không mất thời gian làm việc.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Đừng lo. Mọi thứ vẫn có thể hoạt động bình thường trong suốt quá trình kiểm tra.\"}]]}]]}"
                }
