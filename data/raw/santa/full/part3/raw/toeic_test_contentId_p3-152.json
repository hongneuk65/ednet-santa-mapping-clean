                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Michelle. I just finished setting up the conference room for the meeting. I connected your laptop to the projector, so everything is ready for your presentation.\\nB: Thanks, Josh. Actually, do we have wireless Internet access in the conference room? I want to show a video from the Internet.\\nA: There is Internet access, but I think you need to get the password. I'll go ask Ms. Finley about it.\"}]]}]]}"
                }
              }
