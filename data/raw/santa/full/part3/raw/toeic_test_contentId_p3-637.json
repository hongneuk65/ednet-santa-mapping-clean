          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good afternoon. I stopped by because I need to have a telephone installed in my new tax accounting office.\\nB: Are you keeping the same phone number from a previous location?\\nA: No, I just moved here from overseas last month.\\nB: All right. Just complete this form, and we’ll process the request within three business days. Is there anything else I can help you with?\\nA: Actually, yes. Is there a post office in this neighborhood?\\nB: Yes. Just take a right out of this door and walk about two blocks. You’ll see it across from the pharmacy.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào cô. Tôi ghé qua đây vì cần lắp đặt điện thoại cho phòng kế toán thuế vụ mới của tôi.\\nB: Quý khách sẽ giữ nguyên số giống như khu vực cũ chứ?\\nA: Không, tôi vừa mới từ nước ngoài chuyển đến đây hồi tháng trước.\\nB: Tôi hiểu rồi. Quý khách chỉ cần điền vào mẫu này và chúng tôi sẽ xử lý yêu cầu trong vòng 3 ngày làm việc. Quý khách có cần tôi giúp gì khác nữa không?\\nA: Thật ra thì có. Có bưu điện nào gần đây không?\\nB: Vâng. Chỉ cần ra khỏi cửa, rẽ phải , sau đó đi bộ qua hai dãy nhà. Quý khách sẽ thấy bưu điện ở đối diện với hiệu thuốc.\"}]]}]]}"
                }
              }
