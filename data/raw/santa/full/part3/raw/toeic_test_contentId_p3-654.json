                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Has the delivery date for the new oven been confirmed yet?\\nB: Yes, it will be dropped off at our bakery next Tuesday afternoon.\\nA: Hmm ... that might be an issue. We don’t have much room in the parking lot, and I assume their van will take up a few spots near the entrance. Do you think we could get the time changed to seven in the morning, before the bakery opens?\\nB: That might be possible. I’ll call the supplier now to explain the situation and see what options are available.\"}]]}]]}"
                }
              }
            },
