                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello. I reserved a car for January 20th, but I wanted to make a change to the reservation. My name is Keith Elliot.\\nB: Okay, Mr. Elliot, what would you like to do?\\nA: Originally, I was supposed to drop off the car at Pittsburgh Airport at the end of my trip. But now I’d like to leave it at your Woodbury Hotel branch.\\nB: That’s no problem. And do you need any accessories like GPS navigation or a child safety seat?\\nA: Actually, I plan on going skiing, so I do need a rack attached to the car.\\nB: We’ll be sure to have that set up for you. And don’t forget to have a copy of your insurance policy with you so we can verify it.\"}]]}]]}"
                }
              }
