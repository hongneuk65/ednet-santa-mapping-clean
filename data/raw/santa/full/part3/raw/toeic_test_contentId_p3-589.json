              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good morning, Angela. You’re leading the staff training session this afternoon, right?\\nB: Yes. I’m going to teach employees how to protect their personal information. With so much handled online these days, it’s an important topic. Will your team be there?\\nA: We’re dealing with an urgent issue. I think a few other teams are in the same situation.\\nB: That’s too bad. I don’t want people to miss out on this information.\\nA: Maybe you could lead the same session on a few different days. That way, people could go when it best suits them.\"}]]}]]}"
                }
              }
