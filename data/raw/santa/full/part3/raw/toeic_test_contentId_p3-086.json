          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good morning. This is Benny Holbrook. I'm calling because I had lunch in your restaurant earlier today, and I think I left an important document there. It was probably still on the table when I left.\\nB: Hello, Mr. Holbrook. Let me check. Yes, I see that one of our servers found it earlier. I can keep it safe here at the payment counter until you come down to get it.\\nA: Thanks, but the problem is that I need it for a meeting in 20 minutes. Is there any chance you could fax it to me?\\nB: That shouldn't be a problem. I can do that for you, and I'll also mail you the original papers in case you still need them.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào buổi sáng. Tôi là Benny Holbrook. Tôi gọi đến là vì hôm nay tôi đã ăn trưa ở nhà hàng và tôi nghĩ rằng mình đã để lại một tài liệu quan trọng ở đó. Có lẽ nó vẫn còn ở trên bàn khi tôi rời đi.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Xin chào, anh Holbrook. Để tôi kiểm tra. Vâng, có vẻ như một trong những nhân viên của chúng tôi vừa tìm thấy nó lúc nãy. Chúng tôi sẽ giữ nó an toàn tại quầy thanh toán cho đến khi anh đến lấy.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Cảm ơn, nhưng vấn đề là tôi cần nó cho cuộc họp sau 20 phút nữa. Cô có thể fax cho tôi được không?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Không thành vấn đề. Tôi sẽ gửi qua fax cho anh và tôi cũng sẽ gửi các giấy tờ gốc qua đường bưu điện trong trường hợp anh vẫn cần chúng.\"}]]}]]}"
                }
              }
            },
