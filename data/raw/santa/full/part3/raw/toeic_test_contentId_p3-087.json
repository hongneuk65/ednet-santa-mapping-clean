          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Ms. Hogg. This is Gary from Willard Landscaping. I'm just calling to confirm that we'll be coming to mow your lawn and trim the bushes at your workplace tomorrow. We should get there at about 10 A.M.\\nB: Great. Also, I’ll let everyone know that you'll be coming, so you should have no problem accessing our office grounds.\\nA: Thanks. One thing I'll need to do tomorrow is get your signature after we finish the job.\\nB: That might actually be a problem. I'll be in a meeting all morning. So when you are finished, get the form signed by Shelley Ross at the reception desk. I'll let her know to expect you.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào cô Hogg. Tôi là Gary từ Willard Landscaping. Tôi chỉ gọi để xác nhận rằng chúng tôi sẽ đến cắt cỏ và cắt tỉa bụi rậm tại nơi làm việc của cô vào ngày mai. Chúng tôi sẽ đến đó vào khoảng 10 giờ sáng.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Tuyệt vời. Ngoài ra, tôi sẽ cho mọi người biết rằng các anh sẽ đến, vì vậy anh sẽ không gặp khó khăn gì khi đi vào khu vực văn phòng của chúng tôi.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Cảm ơn. Một điều tôi cần làm vào ngày mai là lấy chữ ký của cô sau khi chúng tôi hoàn thành công việc.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Thực ra điều đó lại là một vấn đề. Tôi sẽ họp cả buổi sáng. Vậy nên khi anh hoàn thành, hãy bảo Shelley Ross tại quầy lễ tân ký cho anh. Tôi sẽ báo cho cô ấy biết trước về anh.\"}]]}]]}"
                }
              }
            },
