          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: You’ve reached Orlando Restaurant Supplies. How may I help you?\\nB: Hi, this is Patrick Jenkins from PJ’s Restaurant. I have a standing order for three thousand plastic straws each month. However, I’d like to change it to paper straws. That’s because these days I’m making an effort to protect the environment.\\nA: All right, sir. That’s a very popular choice among our clients. However, it means the cost of your shipment will be ten percent higher.\\nB: That’s fine with me.\\nA: OK, great. I’ll update your preferences in our system, and the shipment will arrive tomorrow.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Quý khách đã gọi đến công ty cung cấp vật tư cho nhà hàng Orlando. Tôi có thể giúp gì cho quý khách? \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Chào cô. Tôi là Patrick Jenkins ở nhà hàng PJ. Tôi có đặt hàng ba nghìn ống hút nhựa định kỳ mỗi tháng. Tuy nhiên, tôi muốn đổi sang ông hút giấy. Gần đây, tôi đang nỗ lực để bảo vệ môi trường. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Vâng, thưa ông. Đó là một lựa chọn rất phổ biến trong số các khách hàng của chúng tôi. Tuy nhiên, điều đó có nghĩa là chi phí vận chuyển của ông sẽ cao hơn mười phần trăm. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Điều đó không thành vấn đề đối với tôi. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Vâng, tuyệt quá. Tôi sẽ cập nhật yêu cầu của quý khách vào hệ thống của chúng tôi và hàng sẽ được giao đến vào ngày mai.\"}]]}]]}"
                }
