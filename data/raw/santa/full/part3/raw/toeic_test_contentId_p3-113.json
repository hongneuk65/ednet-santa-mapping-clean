              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Excuse me, do you offer dry cleaning services here at the hotel?\\nB: Yes, we do. If you turn in your items by 5 P.M., they will be ready by 7 A.M. the next day.\\nA: That’s great. I’m going to a small business convention tomorrow, and I need a shirt, jacket and skirt cleaned.\\nB: Okay, ma’am. Here is a copy of our price list.\\nA: Oh, my. That’s more than I expected. You know, I think I’ll just get a dress cleaned instead. Do I drop it off here?\\nB: Yes, and the fee will be added to your bill.\\nA: All right. I’ll go to my room now and get it. I’ll be back shortly.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
