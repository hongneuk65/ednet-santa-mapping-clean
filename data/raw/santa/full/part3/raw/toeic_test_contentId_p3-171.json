                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Sao lại có nhiều người trong khu họp vậy?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Có một cuộc thuyết minh về thiết bị y tế mới mà bệnh viện của chúng ta có thể sẽ mua.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Có vấn đề gì với thiết bị chúng ta hiện có sao? Tôi nghĩ chúng ta vừa mới nâng cấp rất nhiều thứ trong thời gian gần đây mà.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Rất nhiều thiết bị mới được giới thiệu ở đó là thiết bị kỹ thuật số đấy. Nó sẽ thay thế tất cả thiết bị chiếu phim và hình ảnh cũ của chúng ta. Về lâu dài sẽ tiết kiệm chi phí cho bệnh viện và cũng dễ sử dụng nữa.\"}]]}]]}"
                }
