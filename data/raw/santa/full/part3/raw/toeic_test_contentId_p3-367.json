                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good morning. Is it possible to make a lunch reservation for 6 people for 1 P.M. tomorrow?\\nB: I’m afraid we are fully booked at 1 o’clock. Actually, we just had a cancellation for a 12 o’clock reservation. Would that be all right?\\nA: I suppose that would be fine, thank you. We will just have to leave the office earlier than we had planned. Please make that reservation under my name, Mr. Clark.\\nB: No problem. I’ve made the reservation for a party of six for 12 o’clock tomorrow.\"}]]}]]}"
                }
