          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Excuse me, ma’am. This area is restricted. You are not allowed to be in here.\\nB: Oh, I’m so sorry. This is my first time visiting this laboratory, so I’m a bit confused. I’m supposed to interview Dr. Allen, the chief researcher, and I think I took the wrong elevator.\\nA: Dr. Allen works in the other wing of the building, in lab 4B. Here, take this map with you so you can find your way. You need to go back down to the lobby and then to the very end of the corridor before taking those elevators.\\nB: Thanks a lot.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin lỗi cô. Đây là khu vực cấm ra vào. Cô không thể vào đây.\\nB: À, tôi xin lỗi. Đây là lần đầu tiên tôi vào trung tâm nghiên cứu nên tôi hơi nhầm lẫn. Tôi có cuộc hẹn phỏng vấn với tiến sĩ Allen, nghiên cứu viên trưởng, và tôi nghĩ là tôi đã đi nhầm thang máy.\\nA: Tiến sĩ Allen làm việc ở phòng nghiên cứu 4B của khu khác thuộc tòa nhà này. Đây, cô hãy mang theo bản đồ này để tìm đường đi. Cô cần xuống lại sảnh, đi tới cuối hành lang, rồi đi thang máy ở đó.\\nB: Cám ơn anh rất nhiều.\"}]]}]]}"
                }
              }
            },
