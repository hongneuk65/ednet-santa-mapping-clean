          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello. I'm here to buy some tools. I just bought a new house, and I'd like to remodel the kitchen. I've never done any remodeling by myself, so could you give me some advice on where to start?\\nB: All right. I'd say the best way to get started would be to join one of our store's free home renovation classes. There's a new class starting up this Monday evening. It meets every Monday for one month.\\nA: That sounds good. I'll definitely need a little help on some skills.\\nB: Yeah, it's a small but very helpful class. Here's a checklist of the tools you'll need to get started. If you have any questions, feel free to ask me.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào. Tôi đến đây để mua một số dụng cụ. Tôi vừa mua một ngôi nhà mới và tôi muốn sửa sang lại nhà bếp. Tôi chưa tự mình sửa sang lại bao giờ, vì vậy bạn có thể cho tôi một số lời khuyên về việc nên bắt đầu từ đâu không?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Được rồi. Tôi muốn nói rằng cách tốt nhất để bắt đầu là tham gia một trong các lớp học sửa nhà miễn phí của cửa hàng chúng tôi. Có một lớp học mới bắt đầu vào tối thứ Hai tuần này. Nó được tổ chức vào thứ Hai hàng tuần trong vòng một tháng.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Nghe hay đấy. Tôi chắc chắn nó sẽ trợ giúp một chút về một số kỹ năng.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Vâng, đó là một lớp học nhỏ nhưng rất hữu ích. Đây là danh sách kiểm tra các dụng cụ bạn sẽ cần để bắt đầu. Hãy hỏi tôi nếu bạn có bất kỳ câu hỏi nào.\"}]]}]]}"
                }
              }
            },
