                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Ms. Richards, I have the additional fire extinguishers that the fire department requires for our manufacturing plant. Do you want me to start installing them now?\\nB: Actually, the fire department still hasn’t sent us an updated floor plan, so I am not sure where they need to be placed. Could you place the extinguishers in our storage area until we receive the document?\\nA: Sure, I will have them put into the storage area immediately.\"}]]}]]}"
                }
              }
            },
