              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Thưa cô Richards, tôi có các bình chữa cháy bổ sung mà sở cứu hỏa yêu cầu nhà máy của chúng tôi sản xuất. Cô có muốn tôi bắt đầu lắp đặt chúng bây giờ không?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Thật ra sở cứu hỏa vẫn chưa gửi cho chúng tôi sơ đồ tầng cập nhật, vì vậy tôi không chắc chúng sẽ được đặt ở đâu. Anh có thể để các bình chữa cháy vào kho của chúng tôi cho đến khi chúng tôi nhận được sơ đồ được không?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chắc chắn rồi, tôi sẽ đưa chúng vào kho ngay lập tức.\"}]]}]]}"
                }
