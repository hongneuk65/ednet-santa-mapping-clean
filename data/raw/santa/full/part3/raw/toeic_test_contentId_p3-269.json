                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Julie, do you think we can set up a time to meet this week?\\nB: I’d love to, Larry, but I’ve got a full schedule. I don’t believe it’ll be possible to get together until next week.\\nA: We really ought to discuss the plans for the Walton Building, though. The client dislikes them, so we may have to redesign everything.\\nB: I wasn’t aware of that. We’d better meet as soon as you’re ready then.\\nA: How does Wednesday sound? Can you make time for me in the afternoon?\\nB: Sure. I’ll call my client and reschedule his appointment. Let’s meet in your office at 1:00.\"}]]}]]}"
                }
              }
