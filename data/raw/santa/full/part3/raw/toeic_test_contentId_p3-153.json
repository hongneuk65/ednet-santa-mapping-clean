                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good afternoon. I just wanted to give you a quick call to let you know I was very happy with the service I received at your furniture store today. The person that assisted me was very helpful and nice.\\nB: Thanks for your kind words. I'd like to pass on your compliment. Do you remember who helped you?\\nA: I don't remember her name, but she was tall and had blonde hair.\\nB: Oh, that's Nicola Benter. She's gone home for the day, but I'll let her know you called when I see her tomorrow morning.\"}]]}]]}"
                }
              }
