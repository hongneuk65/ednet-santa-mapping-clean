              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Eric. It’s Michelle. I’m calling about Friday’s leadership conference. Can you swap time slots with one of the other session leaders?\\nB: Of course. I had planned on being at the event all day.\\nA: Thanks! I’d like you to take Sandra Perry’s slot. She needs to leave early to catch a flight.\\nB: That’s fine with me. Oh, and since I’ll be using video clips in my presentation, I want to check that someone can help me set up the projector and sound system.\\nA: I’ll make sure you have some help.\"}]]}]]}"
                }
              }
