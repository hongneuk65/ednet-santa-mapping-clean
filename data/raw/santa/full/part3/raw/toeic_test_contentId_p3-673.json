                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: I think our hotel guests will like our plan to start serving tea and snacks in the lobby.\\nB: I agree. But there’s no guarantee that the general manager will approve it. Do you think our plan is ready to submit?\\nA: We’ve got the estimated costs of the service, but I’m not sure that will be enough. I’m wondering if there is a way to make it more convincing.\\nB: I could research comments from customers who have enjoyed a similar service at other hotels. That would help to emphasize how popular this idea is.\\nA: That would be great. Thanks.\"}]]}]]}"
                }
              }
