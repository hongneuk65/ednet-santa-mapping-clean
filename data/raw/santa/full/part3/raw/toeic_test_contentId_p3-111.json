              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào buổi sáng. Tôi muốn mua một bó hoa 12 bông cho sự kiện mà tôi đang lên kế hoạch.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Được rồi, thưa anh. Anh mua cho dịp gì vậy?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Văn phòng của chúng tôi có một vài nhân viên mới bắt đầu làm việc, vì vậy chúng tôi sẽ tổ chức tiệc chúc mừng để chào đón họ.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Anh có muốn màu sắc cụ thể nào không?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Không hẳn, vì tôi chỉ định dùng nó như một vật trang trí cho khoảng trống ở giữa bàn thôi. Tôi thích bó hoa này. Giá bao nhiêu vậy?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Bó đó giá sáu mươi đô la.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Được rồi. Cô có thể giao nó vào chiều thứ sáu không?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Chắc chắn rồi. Nhưng xin lưu ý rằng anh sẽ phải trả thêm một khoản phí tám đô la cho dịch vụ đó.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}]]}"
