                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good morning. I’d like to buy a one-dozen flower bouquet for an event I’m planning.\\nB: All right, sir. What’s the occasion?\\nA: We have some new employees starting at my office, so we’re having a reception to greet them.\\nB: Do you have any specific colors in mind?\\nA: Not really, since it will just be a centerpiece. I like this bouquet here. How much is it?\\nB: It’s sixty dollars.\\nA: Okay. Can I have it delivered on Friday afternoon?\\nB: Certainly. But please note that there’s an eight-dollar charge for that service.\"}]]}]]}"
                }
              }
