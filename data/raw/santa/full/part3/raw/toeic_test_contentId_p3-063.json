          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello, Ms. Grainger. This is Ken Cross calling from National Nature Magazine. I received the first draft of your article this morning, and I  want to let you know that we’re pleased with your writing. The article is really interesting and doesn’t need any revision.\\nB: Oh, that’s great to hear! Thanks for informing me, Ken. So will you be using it in the magazine?\\nA: Yes. It will appear in our May issue next month. I’ll contact the Accounting Department now and have someone there send your payment immediately.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, cô Grainger. Tôi là Ken Cross gọi đến từ Tạp chí National Nature. Tôi đã nhận được bản thảo đầu tiên cho bài viết của cô vào sáng nay và tôi muốn cho cô biết rằng chúng tôi rất hài lòng với bài viết này. Bài viết thực sự thú vị và không cần phải sửa đổi nữa.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Ồ, thật tuyệt khi nghe anh nói vậy! Cảm ơn đã thông báo cho tôi, Ken. Các anh sẽ đăng bài này lên tạp chí chứ?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Vâng. Nó sẽ xuất hiện trong số tháng 5 của chúng tôi vào tháng tới. Tôi sẽ liên hệ với Bộ phận Kế toán ngay bây giờ và bảo họ thanh toán cho cô ngay lập tức.\"}]]}]]}"
                }
              }
            },
