          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good morning, and welcome to Ace Medical Clinic. How may I help you?\\nB: Hi, I’ve been sent from 8th Street Plumbing. Someone called about a clogged sink.\\nA: Thanks for getting here so quickly. It’s in our first-floor restroom. Let me show you.\\nB: OK. And you should know that no one will be able to use the sink while I’m working on it. It could take up to an hour or two, depending on the issue.\\nA: I understand. Vanessa, could you please post some signs so that patients know not to use this bathroom for now?\\nC: Sure. I’ll do that right away.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào quý khách. Chào mừng quý khách đến với Bệnh viện Ace. Tôi có thể giúp gì cho quý khách?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Chào cô. Tôi đến từ 8th Street Plumbing . Có người gọi đến vì bồn rửa bị tắc.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Cám ơn anh đã đến rất nhanh. Nó ở nhà vệ sinh tầng 1 của chúng tôi. Tôi sẽ chỉ cho anh.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Vâng. Và cô nên nhớ là không ai có thể sử dụng bồn rửa trong khi tôi đang sửa. Có thể mất từ một đến hai giờ tùy vào vấn đề.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Tôi hiểu rồi. Vanessa, cô có thể dán thông báo để các bệnh nhân tạm thời không sử dụng nhà vệ sinh này không?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"C: Vâng. Tôi sẽ làm ngay.\"}]]}]]}"
                }
              }
