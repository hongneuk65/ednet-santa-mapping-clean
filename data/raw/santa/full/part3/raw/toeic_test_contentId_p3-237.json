          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello, my name is Bruce Ryan. I work in the IT department. I stopped by the reception desk to fix the computer this morning, but it seemed to be working fine. I’m confused.\\nB: Ah, somebody must have told you to go to the wrong location. The computer in Conference Room B is the one that’s broken, not the one on the reception desk.\\nA: Ah, I see. Okay, I have some programming to do this afternoon, but I’ll stop by first thing in the morning to fix it if that’s okay.\\nB: Okay, that’s fine. Would it be possible for you to finish fixing it by 10 A.M.? I am holding a meeting in that room at that time and I need to use the computer to show a video.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, tôi tên là Bruce Ryan. Tôi làm việc trong bộ phận Công nghệ thông tin. Tôi có ghé qua quầy lễ tân để sửa máy tính sáng nay, nhưng có vẻ như nó vẫn hoạt động tốt nên tôi khá bối rối.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: À, chắc là ai đó đã bảo bạn đi nhầm chỗ. Máy tính trong Phòng hội nghị B mới bị hỏng, không phải máy tính trên bàn lễ tân.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: À, tôi hiểu rồi. Được rồi, tôi phải lập trình chiều nay, nhưng nếu được thì tôi sẽ ghé qua rồi sửa nó trước vào sáng mai.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Được rồi, không sao đâu. Bạn có thể hoàn thành việc sửa chữa trước 10 giờ sáng không? Tôi sắp tổ chức một cuộc họp trong phòng vào thời điểm đó và tôi cần sử dụng máy tính để chiếu video.\"}]]}]]}"
                }
              }
