          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Ms. Davis, travelers are getting upset because so many of our trains have been canceled. Can you give me an update?\\nB: Well, because of the major storm last night, some trees fell on the railway lines. It will still take a long time to move them out of the way.\\nA: I don’t want the system to get backed up even more. How about we organize a replacement bus service between the points that are blocked? Then we wouldn’t have to have any more cancellations.\\nB: I’m on board with that idea.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Cô Davis, hành khách đang rất giận vì có quá nhiều chuyến tàu của chúng ta bị hủy. Cô có thể cho tôi biết tình hình gần đây được không?\\nB: Ưm, do trận bão lớn đêm qua, nên cây cối đã bị đổ xuống đường ray. Vẫn còn mất khá nhiều thời gian để dọn dẹp chúng ra khỏi con đường.\\nA: Tôi không muốn hệ thống bị ngưng hoạt động lâu hơn nữa. Cô nghĩ sao về việc chúng ta chuẩn bị dịch vụ xe buýt thay thế chạy giữa các điểm bị chặn? Như vậy, chúng ta không cần phải hủy chuyến thêm nữa.\\nB: Tôi đồng ý với ý kiến đó.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nam người Úc | Giọng nữ người Anh\"}]]}]]}"
                }
              }
            },
