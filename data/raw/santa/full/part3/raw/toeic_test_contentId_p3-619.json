            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Welcome to Montreal Bank. How can I help you?\\nB: I’m opening a flower shop next month, so I’m interested in getting a business loan.\\nA: All right, sir. My colleague, Greta, handles loan applications.\\nC: Right. I can help you. There are a number of documents that you have to prepare in advance. Here is the list of the ones you’ll need.\\nB: Thanks. How long does it take for the loan to be issued? I’m opening my business next month.\\nC: It takes about a week. I’d recommend preparing your business registration first.\\nB: OK, I’ll make that my top priority.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào mừng quý khách đến với Ngân hàng Montreal. Tôi có thể giúp gì cho quý khách.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Vì dự định mở cửa hàng hoa vào tháng tới nên tôi quan tâm tới việc vay vốn kinh doanh.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Tôi hiểu rồi, thưa quý khách. Đồng nghiệp của tôi là cô Greta đang phụ trách việc đăng ký vay.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"C: Vâng. Tôi sẽ giúp anh. Anh cần chuẩn bị trước một số giấy tờ. Đây là danh sách những thứ anh cần.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Cám ơn cô. Việc tiến hành vay vốn sẽ mất bao lâu ạ? Vì tôi sẽ mở cửa hàng kinh doanh vào tháng tới.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"C: Mất khoảng một tuần. Tôi khuyên anh nên chuẩn bị đăng ký kinh doanh trước.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Vâng. Tôi sẽ phải làm việc đó trước tiên.\"}]]}]]}"
