          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good morning. How’s the software update coming along? We need everyone upgraded by Monday morning.\\nB: It’s progressing well. I have almost finished with the accounting department’s computers. Kevin has been working on the customer service floor.\\nC: I am almost done. The whole staff will be able to set up their log-in information soon.\\nA: That’s great to hear. To avoid losing too much productivity during the day, though, you should finish the updates after working hours. You’ll get overtime pay.\\nB: Yes, I think that’s a good idea.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào buổi sáng. Công việc cập nhật phần mềm đến đâu rồi? Máy tính của tất cả mọi người cần được cập nhật xong trước sáng thứ Hai.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Công việc vẫn đang được tiến hành suôn sẻ. Tôi sắp cập nhật xong máy tính của Bộ phận Kế toán rồi. Kevin đang làm việc ở dưới tầng của Bộ phận Chăm sóc khách hàng.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"C: Tôi cũng làm gần xong rồi. Các nhân viên có thể cài đặt thông tin đăng nhập sớm thôi.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Như vậy thì tốt quá. Nhưng để không mất năng suất công việc vào buổi sáng, các anh nên hoàn thành việc cập nhật sau giờ tan làm. Các anh sẽ được trả lương làm thêm.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Vâng, tôi nghĩ đó là một ý hay.\"}]]}]]}"
                }
              }
