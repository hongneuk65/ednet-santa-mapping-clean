          "explanations": [
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, I’m interested in renting a short-term storage unit at your business.\\nB: OK. How long do you expect to keep the items with us?\\nA: About a month. I live here in San Diego, but I’ll spend all of next month working in Portland for a special project. I want to make sure that my valuables, such as paintings and some musical instruments, are secure.\\nB: Your best option is our Gold Service, which is valid for any duration. It includes a pick-up service, so you wouldn’t have to make other transportation arrangements. And we guarantee that our staff will use extreme care when moving your belongings.\"}]]}]]}"
                }
              }
            },
            {
              "id": "",
              "body": {
                "oneOfData": {
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào cô. Tôi muốn thuê kho chứa hàng ngắn hạn ở công ty của cô.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Vâng. Anh dự định bảo quản hàng hóa ở chỗ chúng tôi trong bao lâu?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Khoảng một tháng. Tôi sống ở đây, San Diego, nhưng tôi sẽ làm việc cả tháng sau ở Portland cho một dự án đặc biệt. Tôi muốn đảm bảo rằng những đồ vật có giá trị, chẳng hạn như tranh vẽ hoặc nhạc cụ của mình được an toàn.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Lựa chọn tốt nhất của anh là dịch vụ vàng (Gold Service) của chúng tôi, khoảng thời gian nào cũng có. Nó bao gồm dịch vụ nhận hàng, nên anh sẽ không cần phải chuẩn bị phương tiện vận chuyển riêng. Và chúng tôi đảm bảo rằng nhân viên của chúng tôi sẽ hết sức chú ý khi di chuyển đồ đạc của anh.\"}]]}]]}"
                }
