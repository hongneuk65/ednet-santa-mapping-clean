                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Câu hỏi tìm từ loại thích hợp điền vào chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Trong vế câu \"}],[\"text\",{\"value\":\"that\",\"italic\":true}],[\"text\",{\"value\":\" chứa chỗ trống, sau chỗ trống là cụm giới từ 'concerning' và động từ 'should be directed' nên chỗ trống là vị trí chủ ngữ của vế câu that. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Theo đó, chỗ trống là vị trí của danh từ có thể nhận bổ nghĩa từ cụm giới từ 'concerning',  vì ở đằng trước chỗ trống không có mạo từ không xác định nên đáp án phải là dạng số nhiều đếm được (C) questions.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) questioned là động từ thể quá khứ hoặc quá khứ phân từ nên không thể là chủ ngữ của vế câu 'that'.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) to question là cụm động từ nguyên thể có 'to' nên không thể nhận bổ nghĩa từ cụm tính từ và đồng thời làm chủ ngữ.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) question là danh từ đếm được số ít nên phải được đi cùng mạo từ 'a' mà đằng trước chỗ trống không có mạo từ.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Trong trường hợp đáp án là nhiều từ loại khác nhau, cần xác định từ loại cần thiết thông qua việc phân tích cấu trúc câu. Nếu có từ 2 đáp án trở lên có chung từ loại thì cần chọn từ có ý nghĩa phù hợp với ngữ cảnh câu. Đặc biệt, nếu chỗ trống là vị trí danh từ thì cần phải chú ý đến sự xuất hiện của mạo từ (a/an), sự thống nhất về số ít số nhiều với động từ, tính từ bổ nghĩa.\"}]]}]]}]}",
