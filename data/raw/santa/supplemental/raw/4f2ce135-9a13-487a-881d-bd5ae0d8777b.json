          "explanations": [
            {
              "id": "479b09b9-27e5-4f94-89ca-2297b0ccd26c",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Kính gửi: Tất cả nhân viên GeneDyne Labs\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ: Rebecca Ward, Giám đốc Nhân sự\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Ngày: 5 tháng 10\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Tiêu đề: Chính sách bảo mật\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Kể từ ngày 10 tháng 10, tất cả nhân viên GeneDyne Labs được yêu cầu tuân thủ hai chính sách bảo mật mới. Đầu tiên, tất cả nhân viên vào bất kỳ phòng thí nghiệm nào đều phải sử dụng máy quét dấu vân tay để có quyền truy cập. Chúng tôi sẽ loại bỏ thẻ khoá hiện tại. Hệ thống cửa mới sẽ tăng cường an ninh. Thứ hai, tất cả các giấy phép đậu xe phải được thay thế bằng giấy phép mới vào tuần tới. Giấy phép đậu xe hiện tại chỉ có hiệu lực đến ngày 12 tháng 10. Cũng xin nhớ rằng các câu hỏi liên quan đến các biện pháp bảo mật nên được chuyển đến nhóm Quản lý An ninh của chúng tôi theo số máy lẻ 113.\"}]]}]]}"
                }
              }
            },
            {
              "id": "a94a04cd-7a72-46bc-be84-23a9180ac9c7",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
