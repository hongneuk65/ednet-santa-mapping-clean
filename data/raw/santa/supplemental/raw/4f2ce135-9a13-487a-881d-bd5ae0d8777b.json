          "passages": [
            {
              "id": "a243d4a3-08a7-4d57-8b67-02eb658cb156",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"To: All GeneDyne Labs employees\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"From: Rebecca Ward, Personnel Manager\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Date: October 5\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Subject: Security policies\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Starting October 10, all GeneDyne Labs employees are required to \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" t\"}],[\"text\",{\"value\":\"wo new security policies. First, every worker entering any of the research laboratories must use the fingerprint scanner to gain access. \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\". The new door entry system will provide enhanced security. Second, all parking permits must be exchanged for new\"}],[\"text\",{\"value\":\" ones next week. The existing parking permits will remain \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" only until October 12. Please remember that \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" concerning security measures should be directed toward our security team at extension 113.\"}]]}]]}"
                }
              },
