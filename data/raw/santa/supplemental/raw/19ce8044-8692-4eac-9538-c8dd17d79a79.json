              "text": "",
              "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Questions 62-64 refer to the following conversation and show times.\"}]]}]]}"
