          "explanations": [
            {
              "id": "4d8ac8c5-d550-4680-ab93-c47c7fecb964",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Diana, how would you feel about getting tickets for a baseball game at Wildcat Stadium this week? You mentioned you were interested, and the stadium isn’t far from our office.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: I’d love to, but our project deadline is this Sunday night. Will we be abl\"}],[\"text\",{\"value\":\"e to get it done by then?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: We’re working over the weekend, so we’ll have plenty of time! Plus, the game that starts at 7 p.m. really suits our schedule.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Well, okay then. And, let’s ask the other project members if they’d like to join us.\"}]]}]]}"
                }
              }
            },
            {
              "id": "8d7bcdf6-43ac-48d6-93b4-2bed10e7c38c",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Diana, bạn cảm thấy thế nào khi nhận được vé xem trận bóng chày tại Wildcat Stadium vào tuần này? Bạn đã nói rằng bạn có hứng thú và sân vận động không xa văn phòng của chúng ta.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Tôi rất muốn, nhưng hạn cuối cho dự án của chúng ta là tối Chủ nhật này. Liệu chúng ta có thể hoàn thành nó vào lúc đó không?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chúng ta đang làm việc vào cuối tuần mà nên sẽ có nhiều thời gian lắm! Hơn nữa, trận đấu bắt đầu lúc 7 giờ tối, thực sự phù hợp với lịch trình của chúng ta.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Vậy thì được rồi. À, hãy hỏi các thành viên khác của dự án xem họ có muốn tham gia cùng chúng ta không.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"table\",{\"body\":{\"rows\":[{\"cells\":[{\"align\":\"#left\",\"colspan\":1,\"rowspan\":1,\"children\":[[\"paragraph\",{\"align\":\"#center\",\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"align\":\"#center\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Wildcat Stadium\"}]]}],[\"paragraph\",{\"align\":\"#center\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Lịch trình trận đấu bóng chày\"}]]}],[\"paragraph\",{\"align\":\"#center\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Thứ 5: 6 giờ chiều\"}]]}],[\"paragraph\",{\"align\":\"#center\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Thứ 6: 5 giờ chiều\"}]]}],[\"paragraph\",{\"align\":\"#center\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Thứ 7: 7 giờ tối\"}]]}],[\"paragraph\",{\"align\":\"#center\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Chủ Nhật: 2 giờ chiều\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}]]}]}]}}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}]]}"
                }
