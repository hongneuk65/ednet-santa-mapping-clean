                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Cảm ơn tất cả các bạn đã tham dự cuộc họp này để thảo luận về các sáng kiến đang diễn ra của chúng ta. Đầu tiên, tôi muốn chúc mừng Bill Anderson đã làm cho chi nhánh này trở nên thân thiện hơn với môi trường. Và tôi vui mừng nói rằng các nhân viên tại chi nhánh của chúng ta đã rất nhiệt tình và hợp tác khi đưa ra các sáng kiến mới. Một cuộc khảo sát gần đây trên toàn công ty của trụ sở chính Carper Inc. cho thấy hiện chỉ có 40% nhân viên của chi nhánh chúng ta đi làm bằng ô tô. Điều này đã thực sự giúp chúng ta giảm thiểu ô nhiễm khí thải xe cộ. Tôi sẽ gửi các bản sao của báo cáo đầy đủ từ trụ sở chính để bạn có thể xem dữ liệu.\"}],[\"image\",{\"src\":\"riiid://resources/40eb8a41-f83f-46bb-b5f7-504e354fc25b\",\"alt\":\"\"}]]}]]}"
                }
              }
