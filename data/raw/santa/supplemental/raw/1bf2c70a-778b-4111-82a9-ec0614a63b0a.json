                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Thanks for calling Fairprice Groceries. What can I help you with?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Hi, I'm calling to check whether you stock some specific items. I’m organizing a meeting with overseas clients and there are some fruits I’d like to provide.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: No problem. Please hold for a moment while I transfer you to the Fresh Produce department.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Thank you.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"C: Fresh Produce. Can I help you?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Hi, I’m checking if you carry certain fruits. To be specific, I’m hoping to buy some papaya and guava. Also, would it be possible to have them delivered to my workplace?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"C: We do carry both of those, but I’m afraid you’ll have to purchase them in person.\"}]]}]]}"
                }
              }
            },
            {
              "id": "ad2ae0cf-7d29-42ed-8382-0b00e285de5e",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Cảm ơn bạn đã gọi cho Fairprice Groceries. Tôi có thể giúp gì cho bạn?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Xin chào, tôi đang gọi để kiểm tra xem bạn có còn một số mặt hàng cụ thể hay không. Tôi đang tổ chức một cuộc họp với các khách hàng nước ngoài và có một số loại trái cây tôi muốn cung cấp.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Không sao. Vui lòng chờ một chút trong khi tôi chuyển bạn đến bộ phận Fresh Produce.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Cảm ơn bạn.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"C: Đây là Fresh Produce. Tôi có thể giúp bạn?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Xin chào, tôi đang kiểm tra xem bạn có một số loại trái cây không. Cụ thể, tôi hy vọng sẽ mua được một ít đu đủ và ổi. Ngoài ra, liệu có thể giao chúng đến nơi làm việc của tôi không?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"C: Chúng tôi có cả, nhưng tôi e rằng bạn sẽ phải trực tiếp đến mua chúng.\"}]]}]]}"
                }
              }
