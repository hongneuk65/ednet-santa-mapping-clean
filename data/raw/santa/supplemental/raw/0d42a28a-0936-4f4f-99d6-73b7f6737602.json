                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Đặt phòng tại Grand Palm Resort trước ngày 31 tháng 1 để nhận được mức giá ưu đãi cho một trong những ngôi nhà nhỏ bên bờ biển tuyệt đẹp của chúng tôi! Đã đến lúc thay đổi. Bạn có thể có một kỳ nghỉ thú vị hơn những năm trước bằng cách ghé thăm chúng tôi. Chỉ với $ 100 mỗi đêm, bạn có thể ở trong một ngôi nhà nhỏ xinh đẹp với tất cả các tiện nghi hiện đại mà bạn có thể mong ước! Hãy chi thêm một chút cho một trong những ngôi nhà nhỏ nổi tiếng nhất của chúng tôi nằm ngay bên bờ biển. Một số thậm chí còn đi kèm với một loạt các thiết bị và dụng cụ thể thao dưới nước. Để tìm hiểu thêm về ưu đãi có thời hạn này, hãy liên hệ với chúng tôi ngay hôm nay tại info@grandpalmresort.com.\"}]]}]]}"
                }
              }
