                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"second-hand [Tính từ] đã qua sử dụng\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"appliance [Danh từ] thiết bị gia dụng\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"pay for: thanh toán\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"in cash: bằng tiền mặt\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Câu hỏi tìm từ loại thích hợp điền vào chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Ở trước động từ của câu 'must be paid' là cấu trúc 'chủ ngữ+ chỗ trống + chi phí' nên chỗ trống phải là từ kết hợp với 'under $250' để tạo ra cụm bổ nghĩa cho chủ ngữ. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Theo đó, cụm từ nghĩa cần phân từ ở chỗ trống, biểu thị giá cả là 'price + giá', có nghĩa là có giá bao nhiêu nên đáp án quá khứ phân từ (D) priced là đáp án đúng.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) pricey là tính từ, không hợp với vị trí phân từ đằng trước 'under $250' để tạo thành cụm bổ nghĩa. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) pricing là hiện tại phân từ, không hợp với vị trí phân từ đằng trước 'under $250' để tạo thành cụm bổ nghĩa. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) prices là danh từ, không kết hợp với 'under $250' tạo thành cụm bổ nghĩa. \"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"'Price' khi sử dụng như một động từ, sẽ có nghĩa là 'có giá bao nhiêu'. Trong TOEIC, 'price' thường được dùng dưới dạng bị động ‘be priced + giá cả’ để biểu thị chính sách giá, có nghĩa là sản phẩm được định giá bao nhiêu. \"}]]}]]}]}",
                    "oneOfCase": "RRT_V2_SECTIONS_JSON",
                    "rrtV2InlineElementsJson": "",
                    "html": "",
                    "text": "",
                    "rrtV2BlockElementsJson": ""
                  }
