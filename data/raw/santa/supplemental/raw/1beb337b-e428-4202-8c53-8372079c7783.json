                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Wendy. Have you heard anything about \"}],[\"text\",{\"value\":\"the permit we applied for\"}],[\"text\",{\"value\":\" from the city council?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: \"}],[\"text\",{\"value\":\"You mean the one we need in order to sell our products\"}],[\"text\",{\"value\":\" during the street parade?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Yes, \"}],[\"text\",{\"value\":\"I’m worried that we forgot to fill in some parts of the application\"}],[\"text\",{\"value\":\".\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Don’t worry. I checked it myself.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Well, I wonder what is taking them so long to process it and get back to us. \"}],[\"text\",{\"value\":\"Maybe they have a problem with the large truck\"}],[\"text\",{\"value\":\" we planned to sell our merchandise from.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Yes, \"}],[\"text\",{\"value\":\"it’s probably a lot bigger than they expected\"}],[\"text\",{\"value\":\".\"}]]}]]}"
                }
              }
            },
            {
              "id": "4a9c028b-66f9-4c7a-bcdd-8ed751fb4c3d",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, Wendy. Bạn đã nghe tin gì về giấy phép mà chúng tôi đã xin từ hội đồng thành phố chưa?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Ý bạn là cái mà chúng ta cần để bán sản phẩm của mình trong cuộc diễu hành đường phố?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Có, tôi lo lắng rằng chúng ta đã quên không điền một số phần của đơn đăng ký.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Đừng lo lắng. Tôi đã tự mình kiểm tra.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chà, tôi tự hỏi điều gì khiến họ mất nhiều thời gian để xử lý và gửi lại cho chúng ta như vậy. Có thể họ gặp vấn đề với chiếc xe tải lớn mà chúng ta định dùng để bán hàng.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Vâng, nó có thể lớn hơn rất nhiều so với những gì họ mong đợi.\"}]]}]]}"
                }
              }
