                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: There are two potential venues for the fundraiser we’re organizing. We could rent the ballroom at the Abbott Hotel, or hire a private dining room at Rosalie Restaurant.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Let’s go with the ballroom. The hotel is conveniently located, and we’ll have more privacy than we would at a restaurant.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: But the ballroom is way bigger than we need. We only expect around 100 attendees, so there would be a lot of wasted space.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Well, maybe the hotel has some other rooms we could consider. How about giving them a call to ask about their other options?\"}]]}]]}"
