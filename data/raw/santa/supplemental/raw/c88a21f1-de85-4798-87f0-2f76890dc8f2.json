              "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Questions 86-88 refer to the following excerpt from a meeting.\"}]]}]]}"
            }
          },
          "explanations": [
            {
              "id": "c610bec0-a24c-46e4-bd58-97f14b0665e1",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, everyone. \"}],[\"text\",{\"value\":\"Let’s start by showing you my proposed building blueprint\"}],[\"text\",{\"value\":\". As you can see, the exterior walls of the east-facing side are constructed entirely of glass, which will give the building a modern appearance. I included several unique design choices \"}],[\"text\",{\"value\":\"in order to make the new City Hall a recognizable landmark\"}],[\"text\",{\"value\":\". And the design has some structural similarities with the current City Hall, just to keep some consistency. \"}],[\"text\",{\"value\":\"I'm very pleased with it personally\"}],[\"text\",{\"value\":\", but I want to make sure everyone’s voice is heard.\"}]]}]]}"
                }
              }
            },
            {
              "id": "a9502630-07bc-4ead-967b-0894b7e75144",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, tất cả mọi người. Hãy bắt đầu bằng \\bviệc tôi cho bạn xem bản đề xuất thiết kế tòa nhà của tôi. Như bạn có thể thấy, các bức tường bên ngoài của mặt quay về phía đông được xây dựng hoàn toàn bằng kính, điều này sẽ mang lại cho tòa nhà một diện mạo hiện đại. Tôi đã đưa vào một số lựa chọn thiết kế độc đáo để làm cho Tòa thị chính mới trở thành một địa danh \\bdễ nhận biết. Và thiết kế có một số điểm tương đồng về cấu trúc với Tòa thị chính hiện tại, chỉ để giữ một vài sự nhất quán. Cá nhân tôi rất hài lòng về nó nhưng tôi muốn đảm bảo mình đã lắng nghe ý kiến của mọi người.\"}]]}]]}"
                }
              }
            },
            {
              "id": "3c52247a-d3fa-4f8b-859b-4a6791bc6cb9",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nữ người Anh\"}]]}]]}"
                }
              }
            },
