          "explanations": [
            {
              "id": "45367ce6-06e4-4321-a1c4-cc82545da234",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Gửi đến: toàn bộ nhân viên của FitMobile \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Người gửi: Kristal Chang\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Ngày: 13/05\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Tiêu đề: Tin tức đáng chú ý\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Tôi vừa thấy một bài báo trên trang web công nghệ Bluesky.co.uk., Và tôi rất vui khi thấy rằng trang này đã xếp hạng ứng dụng theo dõi fitness của chúng ta là tốt nhất trên thị trường! Chúng ta cũng có mặt trong danh sách các nhà phát triển ứng dụng dành cho thiết bị di động đáng chú ý trong năm nay. Xin chúc mừng tất cả mọi người! Tôi khuyến khích tất cả mọi người dành thời gian đọc bài báo này. Chúng ta sẽ cập nhật mô tả ứng dụng bao gồm xếp hạng và đề xuất của Bluesky trên các cửa hàng ứng dụng. Đồng thời, chúng ta hãy tiếp tục nỗ lực hơn nữa để trở thành một trong những nhà phát triển ứng dụng fitness tốt nhất.\"}]]}]]}"
                }
              }
            },
            {
              "id": "6095ed92-f144-46f3-86b8-6ea3057cb513",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"development [Danh từ] tin tức\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"notice [Động từ] biết được, thông báo\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"rank A B: xếp A hạng B\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"on the market: trên thị trường\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"feature [Động từ] dành vị trí nổi bật cho ai\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"developer [Động từ] nhà phát triển\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"description [Danh từ] sự miêu tả\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"include [Động từ] bao gồm\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"recommendation [Danh từ] đề xuất\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"continue to do: tiếp tục làm gì\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"push A hard: thúc đẩy A nỗ lực hơn nữa\",\"weight\":\"#w400\"}]]}]]}"
                }
              }
            }
