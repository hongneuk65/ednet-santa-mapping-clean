          "passages": [
            {
              "id": "07aa21a0-9607-484c-8e84-34ffdd482b70",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"To: All FitMobile Staff\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"From: Kristal Chang\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Date: May 13\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Subject: Exciting development\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"I \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" noticed an article on the technology Web site Bluesky.co.uk., and I was delighted to see that the site has ranked our fitness tracker application the best on the market! We were also featured in \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\"  list of mobile app developers to watch this year. Congratulations, everyone! \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\". We will be updating our app’s description in the app stores to include Bluesky’s ranking and recommendation. \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\", let’s continue to push ourselves harder to be one of the best fitness app developers.\"}]]}]]}"
                }
              },
