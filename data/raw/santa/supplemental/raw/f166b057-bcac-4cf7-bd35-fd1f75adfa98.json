children\":[[\"text\",{\"value\":\"(C) sai 'apply for the job' dễ dàng liên tưởng đến 'hired' trong câu hỏi nhưng nội dung lại không liên quan. \"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Trong câu hỏi nguyên nhân có từ để hỏi Why, cần chú ý danh từ hoặc động từ xuất hiện phía sau Why để nắm được nội dung chính xác. Thêm vào đó, câu trả lời thường chứ Because nhưng trong nhiều trường hợp có thể được lược bỏ.\"}]]}]]}]}",
