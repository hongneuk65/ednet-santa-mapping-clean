              "rrtV2InlineElementsJson": "",
              "html": "",
              "text": "",
              "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Questions 65-67 refer to the following conversation and map.\"}]]}]]}"
            }
          },
          "explanations": [
            {
              "id": "52cecfce-100e-4dcd-9656-7d737b1cd14b",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Good morning. Welcome to Merlin Publishing.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Good morning. My name is Mark Slater. \"}],[\"text\",{\"value\":\"I’m here for my first day of work\"}],[\"text\",{\"value\":\". I’m supposed to report to Mr. Anderson in the sales department.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Mark. You can take this layout of this floor of the offices. As you can see, the sales department is just over there. Oh, I should warn you... \"}],[\"text\",{\"value\":\"don't use the toilet right next to the human resources department\"}],[\"text\",{\"value\":\". A pipe has burst and there’s a flood in there.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Thanks for letting me know! \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: No problem. \"}],[\"text\",{\"value\":\"I’ll give Mr. Anderson a call and let him know you’re here so that he can come out and greet you himself. Please take a seat\"}],[\"text\",{\"value\":\".\"}]]}]]}"
                }
              }
            },
            {
              "id": "c04fba04-9084-428b-98cc-906f25017e63",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào buổi sáng. Chào mừng đến với Nhà xuất bản Merlin.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Chào buổi sáng. Tên tôi là Mark Slater. Hôm nay là ngày làm việc đầu tiên của tôi. Tôi cần phải báo cáo với ông Anderson ở phòng kinh doanh.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào Mark. Bạn có thể lấy bản đồ có vị trí các văn phòng ở tầng này. Như bạn có thể thấy, bộ phận bán hàng ở ngay đằng kia. Ồ, tôi nên cảnh báo với bạn ... đừng sử dụng nhà vệ sinh ngay cạnh phòng nhân sự. Một đường ống đã vỡ và nó đang bị ngập nước.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Cảm ơn vì đã cho tôi biết!\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Không \\bcó gì. Tôi sẽ gọi cho ông Anderson và cho ông ấy biết bạn đang ở đây để ông ấy có thể bước ra và chào đón bạn. Xin mời ngồi.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"image\",{\"src\":\"riiid://resources/466fc1f2-2ae7-4516-91c8-ea011f3cdb5f\",\"alt\":\"\"}]]}]]}"
                }
              }
            },
            {
              "id": "2e456807-3e1a-448c-b4bf-f3bb7a6ed7e7",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nữ người Mỹ | Giọng nam người Úc\"}]]}]]}"
                }
              }
            },
            {
              "id": "58709054-5f79-4a0c-a25d-fd16e97444f5",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"be supposed to do: có nhiệm vụ, bổn phận làm gì\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"report to A: báo cáo cho A\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"sales [Danh từ] kinh doanh, doanh số\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"layout [Danh từ] sơ đồ hướng dẫn\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"warn [Động từ] cảnh báo\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"next to [Giới từ] bên cạnh\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"human resources: phòng nhân sự\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"burst [Động từ] vỡ \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"flood [Danh từ] sự ngập nước, lũ lụt\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"let A know: để A biết\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"so that [Liên từ] để có thể (mục đích) \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"greet [Động từ] chào đón\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"oneself [Đại từ] (dùng như trạng từ) trực tiếp, tự mình\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"reception [Danh từ] (quầy) tiếp tân\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"finance [Danh từ] tài chính\"}]]}]]}"
                }
              }
            }
