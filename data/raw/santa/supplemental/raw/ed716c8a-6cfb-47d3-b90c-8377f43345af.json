                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"trial [Tính từ] thử, không chính thức\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"option [Danh từ] sự lựa chọn\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Câu hỏi tìm từ loại thích hợp điền vào chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Ta biết được từ cần điền vào chỗ trống là một tính từ đứng sau giới từ 'with' và bổ nghĩa cho cụm danh từ 'menu options' đứng sau.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Ngoài ra, bởi về những lựa chọn trong menu (menu options) là đối tượng chịu tác động từ con người nên tính từ mang nghĩa bị động 'được giới hạn' (C) limited là đáp án đúng.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) sai, limitation là danh từ, trong một số trường hợp, danh từ có thể kết hợp với danh từ khác tạo ra cụm danh từ nhưng ở đây, danh từ này không thể kết hợp với 'menu options' tạo ra cụm danh từ.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) sai vì limiting có nghĩa chủ động mà 'menu options' là đối tượng bị động nên tính từ này không phù hợp để bổ nghĩa. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) sai, limits có thể là danh từ hoặc động từ. Nếu là danh từ thì không thể kết hợp với 'menu options' tạo ra cụm danh từ, còn nếu là động từ thì không phù hợp với vị trí chỗ trống. \"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Khi chọn các tính từ có nguồn gốc từ các phân từ như 'interesting/interested, exciting/excited, satisfying/satisfied', bạn phải kiểm tra tương quan nghĩa của danh từ và tính từ. Nếu danh từ có thể là chủ thể hoặc nguyên nhân của hành động hay cảm xúc, thì tính từ phải ở dạng hiện tại phân từ V_ing, còn nếu danh từ là chủ thể bị động thì tính từ bổ nghĩa phải là quá khứ phân từ ở dạng V_ed.\"}]]}]]}]}",
                    "oneOfCase": "RRT_V2_SECTIONS_JSON",
