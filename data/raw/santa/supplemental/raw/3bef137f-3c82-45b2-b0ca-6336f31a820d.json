                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"assistance with: giúp đỡ về\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"locate [Động từ] tìm vị trí\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"specific [Tính từ] cụ thể\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"lending  [Danh từ] sự cho mượn, cho thuê\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Câu hỏi tìm từ loại thích hợp điền vào chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Vì ở giữa câu văn có dấu phẩy, ở trước và sau dấu phẩy là  vế câu đầy đủ gồm chủ ngữ và động từ (ở vế câu chính thì chủ ngữ đã được lược bỏ), nên chỗ trống sẽ phải là một liên từ có thể liên kết 2 vế câu với nhau. Vậy nên (B) Whenever là đáp án đúng.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"\\bPhân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) Furthermore là trạng từ không phù hợp với vị trí của liên từ. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) Besides có thể là giới từ hoặc trạng nên không phù hợp với vị trí của liên từ. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) Toward là giới từ không phù hợp với vị trí của liên từ. \"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Trong trường hợp đáp án là nhiều từ loại khác nhau như giới từ, liên từ, trạng từ,... cần xác định từ loại cần thiết thông qua việc phân tích cấu trúc câu. Nếu có từ 2 đáp án trở lên có chung từ loại thì cần chọn từ có ý nghĩa phù hợp với ngữ cảnh câu. \"}]]}]]}]}",
