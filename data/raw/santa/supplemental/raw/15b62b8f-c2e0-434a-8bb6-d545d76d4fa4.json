                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Ms. Varney, please check that all passengers are on board. The other preflight checks are complete and we're ready to start making our way to the runway.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: All passengers are on board and ready for departure.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Thank you. Now, please begin the safety demonstration while we prepare for takeoff.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Certainly, but Alison and Paula are going to handle that today.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: How come?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: I need to start heating up the meals we’ll be serving once the journey begins.\"}]]}]]}"
                }
              }
            },
            {
              "id": "6a5578dc-4701-46d3-a907-87d96f496fa6",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Cô Varney, làm ơn hãy xác nhận xem tất cả hành khách đã lên máy bay chưa. Những quy trình kiểm tra trước khi bay khác đã hoàn thành và chúng tôi đã sẵn sàng để đi chuyển đến đường băng. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Tất cả các hành khách đã lên máy bay và sẵn sàng cất cánh.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin cảm ơn. Bây giờ chúng ta sẽ bắt đầu minh hoạ các quy tắc an toàn khi chuẩn bị cất cánh.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Chắc chắn rồi, nhưng Alison và Paula sẽ tiến hành hôm nay.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Vậy sao?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Tôi cần phải bắt đầu hâm nóng thức ăn mà chúng ta sẽ phục vụ ngay khi chuyến đi bắt đầu. \"}]]}]]}"
                }
              }
            },
