                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"introduce [Động từ] giới thiệu\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"exercise [Danh từ] tập thể dục\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Câu hỏi tìm động từ thích hợp điền vào chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Đằng sau chỗ trống là vế câu 'that' nên cần điền động từ có thể biến vế câu 'that' thành tân ngữ là 'confirm', viết ở dạng hiện tại phân từ là đáp án (B) confirming.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A), (C), (D) sai vì đây là những hiện tại phân từ không thể biến vế câu 'that' thành tân ngữ.  \"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo \",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Bên cạnh những câu hỏi về từ vựng, cũng có những câu hỏi yêu cầu người nghe phải phân tích cấu trúc câu. Với những câu hỏi yêu cầu tìm động từ có thể đi với vế câu 'that', bạn cần biết những từ có chức năng này tương tự 'confirm' như 'think, believe, suppose, realize, assume' có nghĩa là 'nghĩ, giải định', hoặc 'insist, demand, suggest, recommend, propose, request' có nghĩa là yêu cầu/ đề xuất, hay những động từ như 'show, indicate, know, understand, discover, admit, forget, remember' đều có thể biến vế câu 'that' theo sau thành tân ngữ. \"}]]}]]}]}",
