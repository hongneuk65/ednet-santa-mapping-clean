            }
          },
          "explanations": [
            {
              "id": "e1d2ba8a-db88-413e-80d9-c87288ab0e30",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: \"}],[\"text\",{\"value\":\"Hi, Ms. Harrington. Thank you again for agreeing to endorse our new range of running shoes. It means a lot to us to have a gold medal winner like you to help promote our products\"}],[\"text\",{\"value\":\". I’m just calling to tell you that I booked a hotel for you to stay in while you’re in Northside filming the TV commercial for the shoes. There aren’t many hotels in Northside, so I checked the ratings and picked one of the best. \"}],[\"text\",{\"value\":\"It’s the second-highest in the ratings\"}],[\"text\",{\"value\":\", but the closest to the shooting site for the commercial. Also, \"}],[\"text\",{\"value\":\"let me know if you’d like me to provide a car and driver to take you to and from the hotel\"}],[\"text\",{\"value\":\".\"}]]}]]}"
                }
              }
            },
            {
              "id": "028248f2-d2f9-4f42-8af7-db4583f231a3",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào cô Harrington. Cảm ơn cô đã đồng ý quảng bá cho dòng sản phẩm giày chạy mới của chúng tôi. Điều này có ý nghĩa rất lớn với chúng tôi khi có một vận động viên giành huy chương vàng như cô quảng bá cho sản phẩm này. Tôi muốn gọi để thông báo với cô rằng chúng tôi đã đặt phòng một khách sạn cho cô khi cô đang ở Northside để quay phim quảng cáo. Không có nhiều khách sạn ở Northside, nên tôi đã kiểm tra đánh giá và chọn một trong những nơi tốt nhất. Đây là khách sạn có xếp hạng cao thứ hai nhưng lại gần nhất với địa điểm quay phim. Ngoài ra, hãy cho tôi biết nếu cô muốn tôi cung cấp xe và tài xế để đưa và đón cô từ khách sạn. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"image\",{\"src\":\"riiid://resources/55379c79-61a2-48b6-a723-018d8a6a716e\",\"alt\":\"\"}]]}]]}"
                }
              }
            },
            {
              "id": "034fd189-b321-4222-8100-db7296df8991",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
