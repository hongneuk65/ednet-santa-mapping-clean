                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: I asked you all to attend this meeting because I’m getting very concerned about the number of employees who are frequently absent from work. As department managers, you must try to get this situation under control. Next month, our store will be staying open later during the busy Christmas shopping period, so we’re going to need all employees to be here for their shifts. So, make it clear to your workers that we need to work together as a team during this busy time. We can’t do it alone.\"}]]}]]}"
                }
