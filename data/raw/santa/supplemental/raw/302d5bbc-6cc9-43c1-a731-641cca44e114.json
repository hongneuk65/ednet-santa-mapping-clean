              "text": "",
              "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Questions 74-76 refer to the following excerpt from a meeting.\"}]]}]]}"
            }
          },
          "explanations": [
            {
              "id": "765e4ff9-75e2-4b59-b49f-c1dae0d9af11",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: The topic of this customer service meeting\"}],[\"text\",{\"value\":\" is how to handle complaints. I've noticed that the number of customer complaints has risen over the past few months, and some of these issues are not being dealt with effectively. If we fail to explain things clearly and fail to keep our customers happy, \"}],[\"text\",{\"value\":\"we will lose them to our competitors. So, I've invited an expert in communication skills, Gina Shen to talk to you all today. Make sure you have a notebook and pen so you can write down the important points.\"}]]}]]}"
                }
              }
            },
            {
