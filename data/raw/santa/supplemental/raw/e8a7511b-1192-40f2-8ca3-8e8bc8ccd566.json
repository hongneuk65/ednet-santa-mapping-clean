                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Gather around, everyone. Tonight, our restaurant is hosting a special meal to honor Juno Corporation’s CEO, who is stepping down from the company after 35 years. We need to make sure their dinner is a great success. So, let's begin by setting up one lar\"}],[\"text\",{\"value\":\"ge circular table in the private dining room. This will accommodate the 20 guests perfectly. We also need to take down these curtains and put up clean ones. Can someone go and get a screwdriver for that? There’s one in the supply room.\"}]]}]]}"
                }
