                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"https://www.apextechtables.com/reviews\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Rating (out of five) \"}],[\"text\",{\"value\":\"★★★★★\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"My company recently purchased several Apextech folding tables and used them, and we were very impressed with this pro\"}],[\"text\",{\"value\":\"duct! ― [1] ―. We provided food for an important celebration at a marketing firm, and there were numerous dishes that needed to be put out on display for the guests. ― [2] ―. The food for the company banquet took up a lot of space, and some dishes were qui\"}],[\"text\",{\"value\":\"te heavy. ― [3] ―. The Apextech folding tables provided ample display room and carried the heavy load with no issues at all. Not only that, but they are very simple to fold and transport, thanks to the convenient carrying handles. ― [4] ―. We are planning \"}],[\"text\",{\"value\":\"to purchase more of these tables in the near future. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"― Anita Davi, 19 September\"}]]}]]}"
