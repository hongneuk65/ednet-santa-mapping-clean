                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"more than: nhiều hơn\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"develop [Động từ] phát triển\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"along [Giới từ] dọc theo\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"waterfront [Danh từ] bờ biển, bờ nước, bờ sông\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Câu hỏi tìm động từ thích hợp điền vào chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Đằng trước chỗ trống là động từ tobe, động từ ở dạng V_ing và quá khứ phân từ có thể kết hợp với động từ tobe. Đằng sau chỗ trống không có tân ngữ mà có liên từ When, 'construct' lại là ngoại động từ nên ta có thể suy luận đây là dạng câu bị động. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Theo đó, động từ ở dạng bị động sẽ được viết ở dạng quá khứ phân từ (D) constructed.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) construct\\b là động từ nguyên thể không thể kết hợp với động từ tobe.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) constructing là hiện tại phân từ có thể kết hợp với động từ tobe nhưng lại là dạng chủ động nên không thích hợp. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) constructs không thể kết hợp với động từ tobe.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Khi xác định động từ ở dạng chủ động hay bị động, nếu không thể phân biệt động từ là ngoại động từ hay nội động từ, có thể giải thông qua việc xem xét quan hệ của chủ ngữ và động từ. Ví dụ ở câu trên, chủ ngữ là 'More than 250 new houses', phải nhờ có con người mới có thể xây lên, vậy nên theo sau phải là động từ ở thể bị động.  \"}]]}]]}]}",
