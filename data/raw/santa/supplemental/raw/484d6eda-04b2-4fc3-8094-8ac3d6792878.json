          "explanations": [
            {
              "id": "79af6385-6588-4db1-a1b5-d5caeb43f4f9",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hello, I'm Brian Harris, your host for the Radio Five Music Lounge. It’s Friday, so you know what that means! \"}],[\"text\",{\"value\":\"Yes, tonight is all about jazz\"}],[\"text\",{\"value\":\". We have four performances tonight from some rising stars in the modern jazz scene. They are all talented performers, but \"}],[\"text\",{\"value\":\"you should especially make sure you don’t miss Frank Wright\"}],[\"text\",{\"value\":\". His live performances have been receiving a lot of good reviews. This evening, \"}],[\"text\",{\"value\":\"my special guest is Gilbert Murray. He has produced some of the best-selling records\"}],[\"text\",{\"value\":\" over the past decade, and he'll join me after this message from our sponsors.\"}]]}]]}"
                }
