              "text": "",
              "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Questions 98-100 refer to the following broadcast and schedule.\"}]]}]]}"
