                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Xin chào, tôi là Brian Harris, người chủ trì cho Radio Five Music Lounge. Hôm nay là thứ 6, bạn biết nó có nghĩa là gì! Đúng thế, ngày hôm nay là của nhạc jazz. Chúng ta có 4 tiết mục thì những ngôi sao đang lên của nền jazz hiện đại. Họ đều là những người nghệ sĩ tài năng, nhưng các bạn hãy chắc chắn mình không lỡ mất Frank Wright. Tiết mục live của anh ấy là đã nhận được rất nhiều đánh giá tích cực. Đêm nay, vị khách đặc biệt của tôi là Gilbert Murray. Anh ấy đã sản xuất những bản thu bán chạy nhất và sẽ tham gia cùng tôi sau phần thông điệp đến từ nhà tài trợ.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"table\",{\"body\":{\"rows\":[{\"cells\":[{\"align\":\"#left\",\"colspan\":1,\"rowspan\":1,\"children\":[[\"paragraph\",{\"align\":\"#center\",\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"\\bLịch trình Đêm thứ 6\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"7:30 tối - John Mellor\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"8:45 tối - Annie Booth\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"10:00 tối - Frank Wright \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"11:15 tối - Roy Bannister\"}]]}]]}]}]}}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}]]}"
