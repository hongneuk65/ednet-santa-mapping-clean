                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: If the auto mechanic doesn’t get here soon, \"}],[\"text\",{\"value\":\"there’s no chance we will be able to deliver these tables and chairs to the wedding on time\"}],[\"text\",{\"value\":\".\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: I know. I’ll give Ralph a call and \"}],[\"text\",{\"value\":\"tell him about our engine trouble\"}],[\"text\",{\"value\":\".\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"C: Hello.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Hi, Ralph. This is Rita. I’m still in the truck with Brenda. We’re stuck on the highway and waiting for a mechanic.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"C: Oh, that’s not good. You’re supposed to drop off those items by 10 a.m. \"}],[\"text\",{\"value\":\"You’d better give the client a call first\"}],[\"text\",{\"value\":\" to let her know you’re running late.\"}]]}]]}"
                }
              }
            },
            {
              "id": "58b3cd9c-3ecd-434c-b972-ffcf42b7b6c9",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Nếu người thợ sửa xe không tới đây sớm, chúng ta sẽ không thể vận chuyển số bàn và ghế này đến đám cưới đúng giờ. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Tôi biết. Tôi sẽ gọi Ralph và bảo anh ta về vấn đề động cơ xe của chúng ta.  \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"C: Alo.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B:  Xin chào anh Ralph. Tôi là Rita. Tôi vẫn đang ở xe tải với Brenda. Chúng tôi bị kẹt trên cao tốc và đang đợi thợ sửa xe đến. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"C: \\bỒ, không tốt chút nào. Bạn lẽ ra phải dỡ hàng xuống lúc 10 giờ. Bạn nên gọi điện cho khách hàng trước và nói với cô ấy rằng bạn sẽ đến muộn.\"}]]}]]}"
                }
              }
            },
