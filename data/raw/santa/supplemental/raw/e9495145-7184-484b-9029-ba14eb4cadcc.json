          "explanations": [
            {
              "id": "f92c939e-6118-42c9-bf2c-abc4238d8339",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Kính gửi các thành viên Stillwell Public Library\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Thư viện sẽ tổ chức cuộc thi viết sáng tạo thường niên dành cho trẻ em vào tháng tới. Các thành viên từ 16 tuổi trở xuống được quyền gửi một câu chuyện ngắn cho hội đồng giám khảo của chúng tôi. Người tham gia sẽ được phân thành ba độ tuổi: Dưới 10 tuổi, 11 đến 13 tuổi và 14 đến 16. Các câu chuyện cần được mang đến đến quầy cho mượn của thư viện trước ngày 15 tháng 6. Giải thưởng sẽ được trao cho ba tác giả truyện hay nhất ở mỗi hạng mục. Nó bao gồm phiếu quà tặng của một vài hiệu sách địa phương. Hãy đảm bảo bạn phải viết tay và kiểm tra lỗi chính tả. Vì một trong những mục đích của cuộc thi là khuyến khích kỹ năng viết tay nên những câu chuyện được đánh máy trên máy tính sẽ không được chấp nhận. \"}]]}]]}"
                }
              }
            },
            {
              "id": "dd96aa8b-5e8e-4e55-9745-8505e67632a0",
              "body": {
                "oneOfData": {
