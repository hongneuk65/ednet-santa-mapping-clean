                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Dear Stillwell Public Library Members\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"The library will hold its annual creative writing competition for children next month. Members who are aged 16 or under are welcome to submit a sh\"}],[\"text\",{\"value\":\"ort story to our judging panel. \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" will be separated into three age brackets: Under 10s, 11 to 13, and 14 to 16. Story submissions should \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" to the library’s lending desk by June 15th. Prizes will be awarded to the top three story writers in each c\"}],[\"text\",{\"value\":\"ategory. \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\". Be sure to use \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" handwriting and check for spelling errors. As one aim of the competition is to encourage writing skills, stories typed on a computer will not be accepted.\"}]]}]]}"
                }
