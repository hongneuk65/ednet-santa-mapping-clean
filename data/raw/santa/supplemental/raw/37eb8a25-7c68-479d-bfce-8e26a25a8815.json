                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"annual \\b[Tính từ] hằng năm\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"recruitment fair: hội chợ tuyển dụng\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Chọn dạng đúng của động từ điền vào chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Bởi vì sau chủ ngữ và chỗ trống là tân ngữ, giới từ, từ chỉ thời gian nên ta biết được trong chỗ trống sẽ phải là động từ.  \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"3. Bởi vì ở cuối câu văn là từ chỉ thời gian \\\"next month\\\" nên ta biết rằng động từ ở dạng tương lai trong đáp án (B) will hold.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) held sai vì ở dạng quá khứ , không phù hợp với chỗ trống cần động từ ở thể tương lai đơn. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) has held sai vì ở thì hiện tại hoàn thành, không phù hợp với chỗ trống cần động từ ở thể tương lai đơn. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) holding sai vì ở không phải ở dạng động từ. \"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Sau khi xác định từ loại cần điền vào chỗ trống là động từ qua việc kiểm tra thành phần trước và sau chỗ trống, cần xác định đây là câu bị động hay chủ động tuỳ theo sự xuất hiện của tân ngữ, chủ ngữ ở dạng số ít hay số nhiều, các từ biểu thị mốc thời gian để tìm dạng động từ thích hợp.\"}]]}]]}]}",
