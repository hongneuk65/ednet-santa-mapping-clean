                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Câu hỏi tìm động từ thích hợp điền vào chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Câu chứa chỗ trống bắt đầu bằng 'From the beginning of the next school term' nên ta biết được câu viết ở thì tương lai nên (C) will be là đáp án đúng.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) were là ở thể quá khứ nên không phù hợp với câu có biểu hiện thời gian ở thời điểm trong tương lai.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) is being là ở thể hiện tại tiếp diễn và động từ của danh từ số ít mà chủ ngữ của câu văn là ở dạng số nhiều 'product' nên đây là đáp án sai. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(D) have been là thì hiện tại hoàn thành nên không phù hợp với câu có biểu hiện thời gian ở thời điểm trong tương lai.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Nếu câu hỏi có đáp án là động từ ở nhiều hình thái khác nhau, đầu tiên chúng ta xác định được chỗ trống là vị trí của động từ, xem xét chủ ngữ là số ít hay số nhiều, dựa vào sự xuất hiện của tân ngữ để xác định xem đây là câu bị động hay chủ động. Đặc biệt, liên quan đến mốc thời gian, cần thông qua các từ chỉ thời gian ở câu trước và sau để xác định xem câu văn ở thì nào.\"}]]}]]}]}",
