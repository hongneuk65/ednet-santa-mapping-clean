                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Câu hỏi tìm câu thích hợp điền vào chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Trước chỗ trống là câu văn nói về việc nhận thẻ mới để vào phòng nghỉ nên nếu có thể suy ra đáp án (D) là đáp án đúng vì không có thẻ mới sẽ không vào phòng, 'the room' được sử dụng để thay thế cho phòng nghỉ.  \"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) sai vì phần trước chỗ trống đề cập đến vấn đề mở cửa phòng nghỉ và những đối sách để giải quyết nên nội dung phòng nghỉ vẫn mở cửa cho tất cả nhân viên không phù hợp mạch văn. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) sai vì phần trước chỗ trống đề cập đến vấn đề mở cửa phòng nghỉ và những đối sách để giải quyết nên nội dung về việc ra vào bị cấm tại một số khu vực trong tòa nhà không phù hợp mạch văn. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) sai vì phần trước chỗ trống đề cập đến vấn đề mở cửa phòng nghỉ và những đối sách để giải quyết nên nội dung cửa có xu hướng không được khóa đúng cách không phù hợp mạch văn. \"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Trong trường hợp chọn câu phù hợp điền vào chỗ trống, bạn nên tập trung vào việc tìm câu phù hợp với mạch văn của câu trước và sau, và bạn cũng có thể chú ý các manh mối từ mạo từ, danh từ cụ thể, đại từ và liên từ. \"}]]}]]}]}",
