                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"For Immediate Release\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"The Richfield Supermarket chain is happy to announce the opening of its first Oregon location in downtown Portland. All jobseekers are invited \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" a recruitment fair from 9 a.m. to 4 p.m. on April 21. The event will take place at the recently \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" supermarket on the corner of Lindell Avenue and Fourth Street. The supermarket needs to fill approximately 150 vacancies for positions such as checkout operator, warehouse worker, and administrative assistant. \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\", it is seeking experienced individuals to fill 15 management positions. The supermarket chain is known for its excellent employee benefits. \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\". We look forward to meeting jobseekers and welcoming new members to our team.\"}]]}]]}"
