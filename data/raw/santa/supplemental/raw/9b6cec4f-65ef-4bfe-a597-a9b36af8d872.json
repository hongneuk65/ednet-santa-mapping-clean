                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Để đăng ngay\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Chuỗi Siêu thị Richfield vui mừng thông báo về việc khai trương địa điểm đầu tiên ở Oregon tại trung tâm thành phố Portland. Tất cả những người đang tìm việc đều được mời tham gia hội chợ tuyển dụng từ 9 giờ sáng đến 4 giờ chiều vào ngày 21 tháng 4. Sự kiện sẽ diễn ra tại siêu thị mới xây ở góc Lindell Avenue và Fourth Street. Siêu thị cần lấp đầy khoảng 150 vị trí tuyển dụng cho các vị trí như nhân viên thanh toán, nhân viên kho và trợ lý hành chính. Ngoài ra, siêu thị đang tìm kiếm những cá nhân có kinh nghiệm cho 15 vị trí quản lý. Chuỗi siêu thị được biết đến với chế độ phúc lợi tuyệt vời cho nhân viên. Điều này bao gồm nghỉ phép có trả lương và lương làm thêm giờ cao. Chúng tôi mong muốn được gặp gỡ những ứng viên và chào đón các thành viên mới vào đội của chúng tôi.\"}]]}]]}"
                }
              }
