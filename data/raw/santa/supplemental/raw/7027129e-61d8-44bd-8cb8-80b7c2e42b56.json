                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nam người Mỹ | Giọng nam người Úc\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"lead [Động từ] dẫn dắt\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"training [Danh từ] đào tạo\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"will need to do: sẽ cần làm gì\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"leave [Động từ] rời đi\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Vì bạn đang hỏi ai tiến hành hội thảo với từ để hỏi 'Who', (A) là câu trả lời chính xác, nêu rõ cách tìm thông tin liên quan bằng cách nói rằng tôi sẽ kiểm tra lịch trình để tìm ra người đó là ai.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) sai, cố ý dùng từ 'conference center' khiến người nghe dễ dàng liên tưởng đến 'seminars' và 'training' trong câu hỏi\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) sai, có ý dùng cụm từ có phát âm tương tự là leading-leaving.\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Trong câu hỏi có từ để hỏi 'Who', bạn nên tập trung vào các câu trả lời về cho bạn biết thông tin cơ bản liên quan đến danh tính, lĩnh vực hoạt động hoặc công việc cụ thể, chẳng hạn như tên của một người, chức danh công việc hoặc phòng ban. Ngoài ra, những câu trả lời tránh như \\\"Tôi không chắc\\\", \\\"Tôi không chắc\\\" và \\\"Tôi sẽ hỏi\\\", cũng như những câu trả lời đề cập đến cách kiểm tra thông tin liên quan thường có thể là câu trả lời đúng, vì vậy hãy ghi nhớ điều đó và lắng nghe. \"}]]}]]}]}",
