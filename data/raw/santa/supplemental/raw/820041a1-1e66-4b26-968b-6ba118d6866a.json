                "explanation": {
                  "oneOfData": {
                    "rrtV2SectionsJson": "{\"children\":[{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"include [Động từ] bao gồm\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"dairy-free [Tính từ] (sản phẩm) không chứa thành phần sữa\"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Diễn giải\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"1. Câu hỏi tìm từ loại thích hợp điền vào chỗ trống.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"2. Mạo từ không xác định 'a' và tính từ 'dairy-fee' đứng trước chỗ trống nên từ cần điền phải là danh từ ở dạng số ít. Đáp án (D) là đáp án chính xác. \"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phân tích đáp án sai\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(A) options là danh từ số nhiều nên không thể đi với mạo từ 'a'. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(B) optional là tính từ nên không thể điền vào chỗ trống của danh từ. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"(C) opted là động từ ở dạng quá khứ phân từ nên không thể điền vào chỗ trống của danh từ. \"}]]}]]},{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Mẹo\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Trong trường hợp đáp án là nhiều từ loại khác nhau, cần xác định từ loại cần thiết thông qua việc phân tích cấu trúc câu. Nếu có từ 2 đáp án trở lên có chung từ loại thì cần chọn từ có ý nghĩa phù hợp với ngữ cảnh câu. Đặc biệt, nếu trong chỗ trống là danh từ, thì cần xem danh từ có phù hợp với mạo từ đi kèm (a/an), dạng động từ hay tính từ bổ nghĩa hay không, ở dạng số ít hay số nhiều. \"}]]}]]}]}",
