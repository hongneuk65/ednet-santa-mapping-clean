          "passages": [
            {
              "id": "bba6db79-9aad-495d-a244-7706209d3a05",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"ABERDEEN – Clansman Watch Company \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" the establishment of a new business location in Monaco a few days ago. Its new premises will enable Clansman Watch Company to improve its \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" in mainland Europe. The location will include a product showroom, a sales department, a repair workshop, and several offices. \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"The company decided to expand its business in Monaco after a number of French and Italian watch manufacturers ceased operations in the region. \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\". It will allow Clansman Watch Company to gain increased exposure by making sales to wealthy customers.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Clansman Watch Company will host a celebration on September 15 to \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" the opening of its new business location. More information on the event and product ranges can be found at www.clansmanwatches.co.uk.\"}]]}]]}"
                }
              },
