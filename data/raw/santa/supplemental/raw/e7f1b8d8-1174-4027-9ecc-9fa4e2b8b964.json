          },
          "explanations": [
            {
              "id": "d51e5a7d-338e-47a0-aeb7-6438d779bade",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"ABERDEEN – Clansman Watch Company đã thông báo thành lập một cơ sở kinh doanh mới ở Monaco cách đây mấy ngày. Cơ sở mới này sẽ cho phép Clansman Watch Company cải thiện sự hiện diện tại lục địa châu Âu. Địa điểm sẽ bao gồm phòng trưng bày sản phẩm, phòng kinh doanh, xưởng sửa chữa và một vài văn phòng.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Công ty quyết định mở rộng kinh doanh tại Monaco sau khi một số nhà sản xuất đồng hồ của Pháp và Ý ngừng hoạt động trong khu vực này. Địa điểm mới này nhắm vào nhiều người nổi tiếng khi họ đến đây. Nó sẽ cho phép Clansman Watch Company tăng mức độ hiển thị bằng cách bán hàng cho những khách hàng giàu có.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\" Clansman Watch Company sẽ tổ chức lễ kỷ niệm vào ngày 15 tháng 9 để đánh dấu việc khai trương địa điểm kinh doanh mới của mình. Bạn có thể tìm thêm thông tin về sự kiện và các dòng sản phẩm tại www.clansmanwatches.co.uk.\"}]]}]]}"
                }
              }
            },
            {
              "id": "1ee826ab-67de-4b29-b67e-7ed229a4a129",
              "body": {
                "oneOfData": {
