                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"It is with great delight that Zenia Media Corporation \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" the appointment of new CEO, Charles Kennedy. Mr. Kennedy joined our corporation 27 years ago and has received several promotions. He played a crucial role in the \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" of our international operations. As the head of global sales, he helped us enter markets throughout Europe and Asia. He has also become known for his excellent business negotiation skills. \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" of the deals he made, including a partnership with Stratton Publishing in the UK, have contributed to the success of Zenia Media. As CEO, he will be based at our headquarters in Syracuse. \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\". \"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Gerald Gaines, HR Manager, Zenia Media Corporation\"}]]}]]}"
                }
