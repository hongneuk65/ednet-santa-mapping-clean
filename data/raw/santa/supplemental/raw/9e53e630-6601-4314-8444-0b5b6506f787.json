          "explanations": [
            {
              "id": "370fb36c-4911-42d6-af54-3ca698e49488",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Zenia Media Corporation, vui mừng thông báo việc bổ nhiệm Charles Kennedy làm Giám đốc điều hành mới. Ông Kennedy đã gia nhập công ty của chúng ta cách đây 27 năm và đã được thăng chức nhiều lần. Ông Kennedy đã đóng một vai trò quan trọng trong việc mở rộng hoạt động kinh doanh ở nước ngoài của chúng ta. Với tư cách là Trưởng phòng kinh doanh ở nước ngoài, anh ấy đã giúp chúng ta thâm nhập vào một số thị trường trên khắp Châu Âu và Châu Á. Ông cũng được biết đến với kỹ năng đàm phán kinh doanh tuyệt vời của mình. Một số thỏa thuận kinh doanh mà Kennedy đã đạt được, bao gồm cả hợp tác với Nhà xuất bản Stratton ở Anh, đã giúp Zenia Media thành công. Với tư cách là Giám đốc điều hành, Kennedy sẽ làm việc tại trụ sở chính của chúng ta ở Syracuse. Chúng ta chúc ông Kennedy gặp nhiều may mắn trên cương vị mới.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Gerald Gaines, \\bQuản lý bộ phận nhân sự, Zenia Media Corporation\"}]]}]]}"
                }
              }
            },
