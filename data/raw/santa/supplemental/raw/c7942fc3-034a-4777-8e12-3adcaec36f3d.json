              "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Questions131-134 refer to the following customer review.\"}]]}]]}"
            }
          },
          "explanations": [
            {
              "id": "62b85fb7-a20c-47ad-91fd-59c54daea4ab",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Tôi và gia đình hài lòng với món ăn mà chúng tôi đặt từ Cabana Brazilian Steakhouse. Chúng tôi thường xuyên ăn ở ngoài, và chúng tôi đặc biệt thích các nhà hàng thịt Brazil. Tuy nhiên, đây là lần đầu tiên chúng tôi đến Cabana và nó vượt quá mong đợi của chúng tôi. Chất lượng đồ ăn tốt hơn nhiều so với những nhà hàng khác mà chúng tôi đã từng đến. Chúng tôi đã gọi những miếng thịt tương tự như chúng tôi đã đặt từ một số nơi tương tự trước đây, và thịt từ Cabana Brazilian Steakhouse ngon hơn và mềm hơn nhiều. Sự khác biệt thực sự khá đáng ngạc nhiên. Khi nói đến đồ ăn Brazil, chúng tôi sẽ chỉ dùng bữa ở đây trong tương lai. - Patrick Lang\"}]]}]]}"
                }
              }
            },
            {
              "id": "28e3c2c2-a393-420b-8f9a-5e45c19640df",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"be satisfied with: hài lòng với\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"order [Động từ] gọi món\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"regularly [Trạng từ] thường xuyên\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"be fond of: thích\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"particularly [Trạng từ] đặc biệt\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"exceed [Động từ] vượt quá\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"expectation [Danh từ] kỳ vọng\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"a lot: (trong so sánh hơn) rất nhiều(= much)\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"cut [Danh từ] phần cắt, miếng\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"similar [Tính từ] tương tự\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"tender [Tính từ] mềm\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"when it comes to: khi nói về cái gì, liên quan đến cái gì\",\"weight\":\"#w400\"}]]}]]}"
                }
              }
