          "passages": [
            {
              "id": "5ad906d5-1d85-4ddc-a989-0963afd587e6",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"My family and I were satisfied with the food we ordered at Cabana Brazilian Steakhouse. We eat out regularly, and we are particularly fond of Brazilian meat restaurants. \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\", this was our first time trying Cabana, and it exceeded our expectations. The -\"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" is a lot better than what we have eaten at other restaurants. We ordered the same cuts of meat that we’ve ordered at similar places before, and the meat at Cabana Brazilian Steakhouse was much tastier and more tender. \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\". When it comes to Brazili\"}],[\"text\",{\"value\":\"an food, we will be eating \"}],[\"blank\",{\"number\":0}],[\"text\",{\"value\":\" there in the future. – Patrick Lang\"}]]}]]}"
                }
              },
