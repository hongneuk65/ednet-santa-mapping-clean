                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: This is an announcement for anyone who has purchased a ticket for \"}],[\"text\",{\"value\":\"the 11 a.m. showing of Running Free in Cinema 2\"}],[\"text\",{\"value\":\". \"}],[\"text\",{\"value\":\"There is a problem with the projector, so there will be a 30-minute delay due to necessary repair work\"}],[\"text\",{\"value\":\". We appreciate your understanding. To apologize for the inconvenience, \"}],[\"text\",{\"value\":\"you may pick up a voucher\"}],[\"text\",{\"value\":\" from the box office. This can be used for two free beverages or snacks.\"}]]}]]}"
                }
              }
            },
