              "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Questions 38-40 refer to the following conversation.\"}]]}]]}"
            }
          },
          "explanations": [
            {
              "id": "bd60947a-2217-493f-8a74-c9ee95c6fbce",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Hi, Irene. Is everything organized for the grand opening of \"}],[\"text\",{\"value\":\"our new dinosaur exhibit\"}],[\"text\",{\"value\":\" this weekend?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Almost, but I’m unsure where to hold \"}],[\"text\",{\"value\":\"the curator’s welcome speech\"}],[\"text\",{\"value\":\". He’d prefer to give it \"}],[\"text\",{\"value\":\"before people enter the exhibition hall\"}],[\"text\",{\"value\":\". So, can we use the meeting hall instead?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: I’m afraid not. \"}],[\"text\",{\"value\":\"The renovation work is taking longer than expected in that hall\"}],[\"text\",{\"value\":\". It was supposed to be finished by today, but it’ll take one more week.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: I see. Well, \"}],[\"text\",{\"value\":\"I’m\"}],[\"text\",{\"value\":\" supposed to discuss this issue with the curator at 3 p.m. today\"}],[\"text\",{\"value\":\". I’ll see if he has a better idea.\"}]]}]]}"
                }
              }
            },
            {
              "id": "823fcd61-47ab-4aa5-9d60-159f1807d172",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Chào Irene. Mọi thứ đã được chuẩn bị để khai mạc buổi triển lãm khủng long mới của chúng ta vào cuối tuần này chưa?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Gần như vậy, nhưng tôi không chắc nên đặt bài diễn văn chào mừng của người phụ trách ở đâu. Anh ấy muốn phát biểu trước khi mọi người bước vào phòng triển lãm. Vì vậy, liệu chúng ta có thể sử dụng hội trường thay thế?\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"A: Tôi e là không. Công việc sửa sang lại hội trường đó diễn ra lâu hơn dự kiến. Đáng lẽ nó sẽ hoàn thành vào hôm nay, nhưng sẽ mất một tuần nữa.\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"B: Tôi hiểu rồi. Chà, tôi phải thảo luận vấn đề này với người phụ trách lúc 3 giờ chiều nay. Tôi sẽ xem liệu anh ấy có ý tưởng hay hơn không.\"}]]}]]}"
                }
              }
            },
            {
              "id": "86672790-cd26-4a1e-9f11-c4488395af92",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Phát âm\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Giọng nam người Mỹ | Giọng nữ người Anh\"}]]}]]}"
                }
              }
            },
            {
              "id": "711ada4d-1c80-4a5b-b68f-4635274693a0",
              "body": {
                "oneOfData": {
                  "rrtV2SectionsJson": "",
                  "oneOfCase": "RRT_V2_BLOCK_ELEMENTS_JSON",
                  "rrtV2InlineElementsJson": "",
                  "html": "",
                  "text": "",
                  "rrtV2BlockElementsJson": "{\"children\":[[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"Từ vựng\",\"weight\":\"#w700\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"organized [Tính từ] chuẩn bị, tổ chức\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"exhibit [Danh từ] triển lẵm\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"where to do: nơi để làm\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"hold [Động từ] tổ chức (sự kiện)\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"welcome speech: diễn văn chào chào mừng\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"would prefer to do: muốn làm gì\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"exhibition hall: phòng triển lãm\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"instead [Trạng từ] thay vì\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"I’m afraid not: tôi e là không (về một việc đã được đề cập trước đó)\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"renovation [Danh từ] sửa sang\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"take long: mất nhiều thời gian\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"than expected: hơn dự kiến\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"be supposed to do: lẽ ra\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"by [Giới từ] cho đến (thời hạn)\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"discuss [Động từ] thảo luận\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"issue [Danh từ] vấn đề\",\"weight\":\"#w400\"}]]}],[\"paragraph\",{\"numbering\":\"#none\",\"indent-level\":0,\"children\":[[\"text\",{\"value\":\"see if: để xem....hay không\",\"weight\":\"#w400\"}]]}]]}"
                }
              }
